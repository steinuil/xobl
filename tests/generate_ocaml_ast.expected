         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    Decode.pad buf 2;
    let num = Decode.i16 buf in
    let denom = Decode.i16 buf in
    let threshold = Decode.i16 buf in
    ()

