module Bigreq = struct
  type enable_reply = u32 [@@deriving sexp]
end

module Xproto = struct
  let decode_char2b buf : char2b =
    let byte1 = Decode.u8 buf in
    let byte2 = Decode.u8 buf in
    ()

  type window = xid [@@deriving sexp]

  let decode_window = Decode.xid

  type pixmap = xid [@@deriving sexp]

  let decode_pixmap = Decode.xid

  type cursor = xid [@@deriving sexp]

  let decode_cursor = Decode.xid

  type font = xid [@@deriving sexp]

  let decode_font = Decode.xid

  type gcontext = xid [@@deriving sexp]

  let decode_gcontext = Decode.xid

  type colormap = xid [@@deriving sexp]

  let decode_colormap = Decode.xid

  type atom = xid [@@deriving sexp]

  let decode_atom = Decode.xid

  type drawable = xid [@@deriving sexp]

  let decode_drawable = Decode.xid

  type fontable = xid [@@deriving sexp]

  let decode_fontable = Decode.xid

  type bool32 = u32 [@@deriving sexp]

  let decode_bool32 = Decode.u32

  type visualid = u32 [@@deriving sexp]

  let decode_visualid = Decode.u32

  type timestamp = u32 [@@deriving sexp]

  let decode_timestamp = Decode.u32

  type keysym = u32 [@@deriving sexp]

  let decode_keysym = Decode.u32

  type keycode = u8 [@@deriving sexp]

  let decode_keycode = Decode.u8

  type keycode32 = u32 [@@deriving sexp]

  let decode_keycode32 = Decode.u32

  type button = u8 [@@deriving sexp]

  let decode_button = Decode.u8

  type point = { x : i16; y : i16 } [@@deriving sexp]

  let decode_point buf : point =
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    ()

  type rectangle = { x : i16; y : i16; width : u16; height : u16 }
  [@@deriving sexp]

  let decode_rectangle buf : rectangle =
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    ()

  type arc = {
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    angle1 : i16;
    angle2 : i16;
  }
  [@@deriving sexp]

  let decode_arc buf : arc =
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let angle1 = Decode.i16 buf in
    let angle2 = Decode.i16 buf in
    ()

  type format = { depth : u8; bits_per_pixel : u8; scanline_pad : u8 }
  [@@deriving sexp]

  let decode_format buf : format =
    let depth = Decode.u8 buf in
    let bits_per_pixel = Decode.u8 buf in
    let scanline_pad = Decode.u8 buf in
    Decode.pad buf 5;
    ()

  type visual_class_enum =
    [ `Static_gray
    | `Gray_scale
    | `Static_color
    | `Pseudo_color
    | `True_color
    | `Direct_color ]
  [@@deriving sexp]

  type visualtype = {
    visual_id : visualid;
    class_ : visual_class_enum;
    bits_per_rgb_value : u8;
    colormap_entries : u16;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
  }
  [@@deriving sexp]

  let decode_visualtype buf : visualtype =
    let visual_id = decode_visualid buf in
    let class_ =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:visual_class_enum_of_int)
        buf
    in
    let bits_per_rgb_value = Decode.u8 buf in
    let colormap_entries = Decode.u16 buf in
    let red_mask = Decode.u32 buf in
    let green_mask = Decode.u32 buf in
    let blue_mask = Decode.u32 buf in
    Decode.pad buf 4;
    ()

  type depth = { depth : u8; visuals : visualtype list } [@@deriving sexp]

  let decode_depth buf : depth =
    let depth = Decode.u8 buf in
    Decode.pad buf 1;
    let visuals_len = Decode.u16 buf in
    Decode.pad buf 4;
    let visuals = (Decode.list ~item:decode_visualtype) ~len:visuals_len buf in
    ()

  type event_mask =
    [ `Key_press
    | `Key_release
    | `Button_press
    | `Button_release
    | `Enter_window
    | `Leave_window
    | `Pointer_motion
    | `Pointer_motion_hint
    | `Button1_motion
    | `Button2_motion
    | `Button3_motion
    | `Button4_motion
    | `Button5_motion
    | `Button_motion
    | `Keymap_state
    | `Exposure
    | `Visibility_change
    | `Structure_notify
    | `Resize_redirect
    | `Substructure_notify
    | `Substructure_redirect
    | `Focus_change
    | `Property_change
    | `Color_map_change
    | `Owner_grab_button ]
    list
  [@@deriving sexp]

  type backing_store_enum = [ `Not_useful | `When_mapped | `Always ]
  [@@deriving sexp]

  type screen = {
    root : window;
    default_colormap : colormap;
    white_pixel : u32;
    black_pixel : u32;
    current_input_masks : event_mask;
    width_in_pixels : u16;
    height_in_pixels : u16;
    width_in_millimeters : u16;
    height_in_millimeters : u16;
    min_installed_maps : u16;
    max_installed_maps : u16;
    root_visual : visualid;
    backing_stores : backing_store_enum;
    save_unders : bool;
    root_depth : u8;
    allowed_depths : depth list;
  }
  [@@deriving sexp]

  let decode_screen buf : screen =
    let root = decode_window buf in
    let default_colormap = decode_colormap buf in
    let white_pixel = Decode.u32 buf in
    let black_pixel = Decode.u32 buf in
    let current_input_masks =
      (Decode.mask Decode.u32 Int64.of_int event_mask_mask_of_int64) buf
    in
    let width_in_pixels = Decode.u16 buf in
    let height_in_pixels = Decode.u16 buf in
    let width_in_millimeters = Decode.u16 buf in
    let height_in_millimeters = Decode.u16 buf in
    let min_installed_maps = Decode.u16 buf in
    let max_installed_maps = Decode.u16 buf in
    let root_visual = decode_visualid buf in
    let backing_stores =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:backing_store_enum_of_int)
        buf
    in
    let save_unders = Decode.bool buf in
    let root_depth = Decode.u8 buf in
    let allowed_depths_len = Decode.u8 buf in
    let allowed_depths =
      (Decode.list ~item:decode_depth) ~len:allowed_depths_len buf
    in
    ()

  type setup_request = {
    byte_order : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    authorization_protocol_name : string;
    authorization_protocol_data : string;
  }
  [@@deriving sexp]

  let decode_setup_request buf : setup_request =
    let byte_order = Decode.u8 buf in
    Decode.pad buf 1;
    let protocol_major_version = Decode.u16 buf in
    let protocol_minor_version = Decode.u16 buf in
    let authorization_protocol_name_len = Decode.u16 buf in
    let authorization_protocol_data_len = Decode.u16 buf in
    Decode.pad buf 2;
    let authorization_protocol_name =
      Decode.string ~len:authorization_protocol_name_len buf
    in
    Decode.align buf 4;
    let authorization_protocol_data =
      Decode.string ~len:authorization_protocol_data_len buf
    in
    Decode.align buf 4;
    ()

  type setup_failed = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    reason : string;
  }
  [@@deriving sexp]

  let decode_setup_failed buf : setup_failed =
    let status = Decode.u8 buf in
    let reason_len = Decode.u8 buf in
    let protocol_major_version = Decode.u16 buf in
    let protocol_minor_version = Decode.u16 buf in
    let length = Decode.u16 buf in
    let reason = Decode.string ~len:reason_len buf in
    ()

  type setup_authenticate = { status : u8; reason : string } [@@deriving sexp]

  let decode_setup_authenticate buf : setup_authenticate =
    let status = Decode.u8 buf in
    Decode.pad buf 5;
    let length = Decode.u16 buf in
    let length = length / 4 in
    let reason = Decode.string ~len:length buf in
    ()

  type image_order_enum = [ `Lsb_first | `Msb_first ] [@@deriving sexp]

  type setup = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    release_number : u32;
    resource_id_base : u32;
    resource_id_mask : u32;
    motion_buffer_size : u32;
    maximum_request_length : u16;
    image_byte_order : image_order_enum;
    bitmap_format_bit_order : image_order_enum;
    bitmap_format_scanline_unit : u8;
    bitmap_format_scanline_pad : u8;
    min_keycode : keycode;
    max_keycode : keycode;
    vendor : string;
    pixmap_formats : format list;
    roots : screen list;
  }
  [@@deriving sexp]

  let decode_setup buf : setup =
    let status = Decode.u8 buf in
    Decode.pad buf 1;
    let protocol_major_version = Decode.u16 buf in
    let protocol_minor_version = Decode.u16 buf in
    let length = Decode.u16 buf in
    let release_number = Decode.u32 buf in
    let resource_id_base = Decode.u32 buf in
    let resource_id_mask = Decode.u32 buf in
    let motion_buffer_size = Decode.u32 buf in
    let vendor_len = Decode.u16 buf in
    let maximum_request_length = Decode.u16 buf in
    let roots_len = Decode.u8 buf in
    let pixmap_formats_len = Decode.u8 buf in
    let image_byte_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_order_enum_of_int)
        buf
    in
    let bitmap_format_bit_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_order_enum_of_int)
        buf
    in
    let bitmap_format_scanline_unit = Decode.u8 buf in
    let bitmap_format_scanline_pad = Decode.u8 buf in
    let min_keycode = decode_keycode buf in
    let max_keycode = decode_keycode buf in
    Decode.pad buf 4;
    let vendor = Decode.string ~len:vendor_len buf in
    Decode.align buf 4;
    let pixmap_formats =
      (Decode.list ~item:decode_format) ~len:pixmap_formats_len buf
    in
    let roots = (Decode.list ~item:decode_screen) ~len:roots_len buf in
    ()

  type mod_mask =
    [ `Shift | `Lock | `Control | `D1 | `D2 | `D3 | `D4 | `D5 | `Any ] list
  [@@deriving sexp]

  type key_but_mask =
    [ `Shift
    | `Lock
    | `Control
    | `Mod1
    | `Mod2
    | `Mod3
    | `Mod4
    | `Mod5
    | `Button1
    | `Button2
    | `Button3
    | `Button4
    | `Button5 ]
    list
  [@@deriving sexp]

  type window_enum = [ `None ] [@@deriving sexp]

  type key_press_event = {
    detail : keycode;
    time : timestamp;
    root : window;
    event : window;
    child : window_enum alt_enum;
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    same_screen : bool;
  }
  [@@deriving sexp]

  type key_release_event = key_press_event [@@deriving sexp]

  let decode_key_release_event = decode_key_press_event

  type button_mask = [ `D1 | `D2 | `D3 | `D4 | `D5 | `Any ] list
  [@@deriving sexp]

  type button_press_event = {
    detail : button;
    time : timestamp;
    root : window;
    event : window;
    child : window_enum alt_enum;
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    same_screen : bool;
  }
  [@@deriving sexp]

  type button_release_event = button_press_event [@@deriving sexp]

  let decode_button_release_event = decode_button_press_event

  type motion_enum = [ `Normal | `Hint ] [@@deriving sexp]

  type motion_notify_event = {
    detail : motion_enum;
    time : timestamp;
    root : window;
    event : window;
    child : window_enum alt_enum;
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    same_screen : bool;
  }
  [@@deriving sexp]

  type notify_detail_enum =
    [ `Ancestor
    | `Virtual
    | `Inferior
    | `Nonlinear
    | `Nonlinear_virtual
    | `Pointer
    | `Pointer_root
    | `None ]
  [@@deriving sexp]

  type notify_mode_enum = [ `Normal | `Grab | `Ungrab | `While_grabbed ]
  [@@deriving sexp]

  type enter_notify_event = {
    detail : notify_detail_enum;
    time : timestamp;
    root : window;
    event : window;
    child : window_enum alt_enum;
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    mode : notify_mode_enum;
    same_screen_focus : byte;
  }
  [@@deriving sexp]

  type leave_notify_event = enter_notify_event [@@deriving sexp]

  let decode_leave_notify_event = decode_enter_notify_event

  type focus_in_event = {
    detail : notify_detail_enum;
    event : window;
    mode : notify_mode_enum;
  }
  [@@deriving sexp]

  type focus_out_event = focus_in_event [@@deriving sexp]

  let decode_focus_out_event = decode_focus_in_event

  type keymap_notify_event = u8 list [@@deriving sexp]

  type expose_event = {
    window : window;
    x : u16;
    y : u16;
    width : u16;
    height : u16;
    count : u16;
  }
  [@@deriving sexp]

  type graphics_exposure_event = {
    drawable : drawable;
    x : u16;
    y : u16;
    width : u16;
    height : u16;
    minor_opcode : u16;
    count : u16;
    major_opcode : u8;
  }
  [@@deriving sexp]

  type no_exposure_event = {
    drawable : drawable;
    minor_opcode : u16;
    major_opcode : u8;
  }
  [@@deriving sexp]

  type visibility_enum = [ `Unobscured | `Partially_obscured | `Fully_obscured ]
  [@@deriving sexp]

  type visibility_notify_event = { window : window; state : visibility_enum }
  [@@deriving sexp]

  type create_notify_event = {
    parent : window;
    window : window;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    border_width : u16;
    override_redirect : bool;
  }
  [@@deriving sexp]

  type destroy_notify_event = { event : window; window : window }
  [@@deriving sexp]

  type unmap_notify_event = {
    event : window;
    window : window;
    from_configure : bool;
  }
  [@@deriving sexp]

  type map_notify_event = {
    event : window;
    window : window;
    override_redirect : bool;
  }
  [@@deriving sexp]

  type map_request_event = { parent : window; window : window }
  [@@deriving sexp]

  type reparent_notify_event = {
    event : window;
    window : window;
    parent : window;
    x : i16;
    y : i16;
    override_redirect : bool;
  }
  [@@deriving sexp]

  type configure_notify_event = {
    event : window;
    window : window;
    above_sibling : window_enum alt_enum;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    border_width : u16;
    override_redirect : bool;
  }
  [@@deriving sexp]

  type stack_mode_enum = [ `Above | `Below | `Top_if | `Bottom_if | `Opposite ]
  [@@deriving sexp]

  type config_window_mask =
    [ `X | `Y | `Width | `Height | `Border_width | `Sibling | `Stack_mode ] list
  [@@deriving sexp]

  type configure_request_event = {
    stack_mode : stack_mode_enum;
    parent : window;
    window : window;
    sibling : window_enum alt_enum;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    border_width : u16;
    value_mask : config_window_mask;
  }
  [@@deriving sexp]

  type gravity_notify_event = {
    event : window;
    window : window;
    x : i16;
    y : i16;
  }
  [@@deriving sexp]

  type resize_request_event = { window : window; width : u16; height : u16 }
  [@@deriving sexp]

  type place_enum = [ `On_top | `On_bottom ] [@@deriving sexp]

  type circulate_notify_event = {
    event : window;
    window : window;
    place : place_enum;
  }
  [@@deriving sexp]

  type circulate_request_event = circulate_notify_event [@@deriving sexp]

  let decode_circulate_request_event = decode_circulate_notify_event

  type property_enum = [ `New_value | `Delete ] [@@deriving sexp]

  type property_notify_event = {
    window : window;
    atom : atom;
    time : timestamp;
    state : property_enum;
  }
  [@@deriving sexp]

  type selection_clear_event = {
    time : timestamp;
    owner : window;
    selection : atom;
  }
  [@@deriving sexp]

  type time_enum = [ `Current_time ] [@@deriving sexp]

  type atom_enum =
    [ `None
    | `Any
    | `Primary
    | `Secondary
    | `Arc
    | `Atom
    | `Bitmap
    | `Cardinal
    | `Colormap
    | `Cursor
    | `Cut_buffer0
    | `Cut_buffer1
    | `Cut_buffer2
    | `Cut_buffer3
    | `Cut_buffer4
    | `Cut_buffer5
    | `Cut_buffer6
    | `Cut_buffer7
    | `Drawable
    | `Font
    | `Integer
    | `Pixmap
    | `Point
    | `Rectangle
    | `Resource_manager
    | `Rgb_color_map
    | `Rgb_best_map
    | `Rgb_blue_map
    | `Rgb_default_map
    | `Rgb_gray_map
    | `Rgb_green_map
    | `Rgb_red_map
    | `String
    | `Visualid
    | `Window
    | `Wm_command
    | `Wm_hints
    | `Wm_client_machine
    | `Wm_icon_name
    | `Wm_icon_size
    | `Wm_name
    | `Wm_normal_hints
    | `Wm_size_hints
    | `Wm_zoom_hints
    | `Min_space
    | `Norm_space
    | `Max_space
    | `End_space
    | `Superscript_x
    | `Superscript_y
    | `Subscript_x
    | `Subscript_y
    | `Underline_position
    | `Underline_thickness
    | `Strikeout_ascent
    | `Strikeout_descent
    | `Italic_angle
    | `X_height
    | `Quad_width
    | `Weight
    | `Point_size
    | `Resolution
    | `Copyright
    | `Notice
    | `Font_name
    | `Family_name
    | `Full_name
    | `Cap_height
    | `Wm_class
    | `Wm_transient_for ]
  [@@deriving sexp]

  type selection_request_event = {
    time : time_enum alt_enum;
    owner : window;
    requestor : window;
    selection : atom;
    target : atom;
    property : atom_enum alt_enum;
  }
  [@@deriving sexp]

  type selection_notify_event = {
    time : time_enum alt_enum;
    requestor : window;
    selection : atom;
    target : atom;
    property : atom_enum alt_enum;
  }
  [@@deriving sexp]

  type colormap_state_enum = [ `Uninstalled | `Installed ] [@@deriving sexp]
  type colormap_enum = [ `None ] [@@deriving sexp]

  type colormap_notify_event = {
    window : window;
    colormap : colormap_enum alt_enum;
    new_ : bool;
    state : colormap_state_enum;
  }
  [@@deriving sexp]

  type client_message_data_format_enum = [ `Data8 | `Data16 | `Data32 ]
  [@@deriving sexp]

  type client_message_data_format_variant =
    | Data8 of u8 list
    | Data16 of u16 list
    | Data32 of u32 list
  [@@deriving sexp]

  type client_message_event = {
    window : window;
    type_ : atom;
    data : client_message_data_format_variant;
  }
  [@@deriving sexp]

  type mapping_enum = [ `Modifier | `Keyboard | `Pointer ] [@@deriving sexp]

  type mapping_notify_event = {
    request : mapping_enum;
    first_keycode : keycode;
    count : u8;
  }
  [@@deriving sexp]

  type ge_generic_event = unit [@@deriving sexp]

  type request_error = {
    bad_value : u32;
    minor_opcode : u16;
    major_opcode : u8;
  }
  [@@deriving sexp]

  type value_error = { bad_value : u32; minor_opcode : u16; major_opcode : u8 }
  [@@deriving sexp]

  type window_error = value_error [@@deriving sexp]

  let decode_window_error = decode_value_error

  type pixmap_error = value_error [@@deriving sexp]

  let decode_pixmap_error = decode_value_error

  type atom_error = value_error [@@deriving sexp]

  let decode_atom_error = decode_value_error

  type cursor_error = value_error [@@deriving sexp]

  let decode_cursor_error = decode_value_error

  type font_error = value_error [@@deriving sexp]

  let decode_font_error = decode_value_error

  type match_error = request_error [@@deriving sexp]

  let decode_match_error = decode_request_error

  type drawable_error = value_error [@@deriving sexp]

  let decode_drawable_error = decode_value_error

  type access_error = request_error [@@deriving sexp]

  let decode_access_error = decode_request_error

  type alloc_error = request_error [@@deriving sexp]

  let decode_alloc_error = decode_request_error

  type colormap_error = value_error [@@deriving sexp]

  let decode_colormap_error = decode_value_error

  type g_context_error = value_error [@@deriving sexp]

  let decode_g_context_error = decode_value_error

  type id_choice_error = value_error [@@deriving sexp]

  let decode_id_choice_error = decode_value_error

  type name_error = request_error [@@deriving sexp]

  let decode_name_error = decode_request_error

  type length_error = request_error [@@deriving sexp]

  let decode_length_error = decode_request_error

  type implementation_error = request_error [@@deriving sexp]

  let decode_implementation_error = decode_request_error

  type window_class_enum = [ `Copy_from_parent | `Input_output | `Input_only ]
  [@@deriving sexp]

  type cw_mask =
    [ `Back_pixmap
    | `Back_pixel
    | `Border_pixmap
    | `Border_pixel
    | `Bit_gravity
    | `Win_gravity
    | `Backing_store
    | `Backing_planes
    | `Backing_pixel
    | `Override_redirect
    | `Save_under
    | `Event_mask
    | `Dont_propagate
    | `Colormap
    | `Cursor ]
    list
  [@@deriving sexp]

  type back_pixmap_enum = [ `None | `Parent_relative ] [@@deriving sexp]

  type gravity_enum =
    [ `Bit_forget
    | `Win_unmap
    | `North_west
    | `North
    | `North_east
    | `West
    | `Center
    | `East
    | `South_west
    | `South
    | `South_east
    | `Static ]
  [@@deriving sexp]

  type pixmap_enum = [ `None ] [@@deriving sexp]
  type cursor_enum = [ `None ] [@@deriving sexp]

  type map_state_enum = [ `Unmapped | `Unviewable | `Viewable ]
  [@@deriving sexp]

  type get_window_attributes_reply = {
    backing_store : backing_store_enum;
    visual : visualid;
    class_ : window_class_enum;
    bit_gravity : gravity_enum;
    win_gravity : gravity_enum;
    backing_planes : u32;
    backing_pixel : u32;
    save_under : bool;
    map_is_installed : bool;
    map_state : map_state_enum;
    override_redirect : bool;
    colormap : colormap_enum alt_enum;
    all_event_masks : event_mask;
    your_event_mask : event_mask;
    do_not_propagate_mask : event_mask;
  }
  [@@deriving sexp]

  type set_mode_enum = [ `Insert | `Delete ] [@@deriving sexp]
  type circulate_enum = [ `Raise_lowest | `Lower_highest ] [@@deriving sexp]

  type get_geometry_reply = {
    depth : u8;
    root : window;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    border_width : u16;
  }
  [@@deriving sexp]

  type query_tree_reply = {
    root : window;
    parent : window_enum alt_enum;
    children : window list;
  }
  [@@deriving sexp]

  type intern_atom_reply = atom_enum alt_enum [@@deriving sexp]
  type get_atom_name_reply = string [@@deriving sexp]
  type prop_mode_enum = [ `Replace | `Prepend | `Append ] [@@deriving sexp]
  type get_property_type_enum = [ `Any ] [@@deriving sexp]

  type get_property_reply = {
    format : u8;
    type_ : atom;
    bytes_after : u32;
    value_len : u32;
    value : string;
  }
  [@@deriving sexp]

  type list_properties_reply = atom list [@@deriving sexp]
  type get_selection_owner_reply = window_enum alt_enum [@@deriving sexp]

  type send_event_dest_enum = [ `Pointer_window | `Item_focus ]
  [@@deriving sexp]

  type grab_mode_enum = [ `Sync | `Async ] [@@deriving sexp]

  type grab_status_enum =
    [ `Success | `Already_grabbed | `Invalid_time | `Not_viewable | `Frozen ]
  [@@deriving sexp]

  type grab_pointer_reply = grab_status_enum [@@deriving sexp]

  type button_index_enum = [ `Any | `D1 | `D2 | `D3 | `D4 | `D5 ]
  [@@deriving sexp]

  type grab_keyboard_reply = grab_status_enum [@@deriving sexp]
  type grab_enum = [ `Any ] [@@deriving sexp]

  type allow_enum =
    [ `Async_pointer
    | `Sync_pointer
    | `Replay_pointer
    | `Async_keyboard
    | `Sync_keyboard
    | `Replay_keyboard
    | `Async_both
    | `Sync_both ]
  [@@deriving sexp]

  type query_pointer_reply = {
    same_screen : bool;
    root : window;
    child : window_enum alt_enum;
    root_x : i16;
    root_y : i16;
    win_x : i16;
    win_y : i16;
    mask : key_but_mask;
  }
  [@@deriving sexp]

  type timecoord = { time : timestamp; x : i16; y : i16 } [@@deriving sexp]

  let decode_timecoord buf : timecoord =
    let time = decode_timestamp buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    ()

  type get_motion_events_reply = timecoord list [@@deriving sexp]

  type translate_coordinates_reply = {
    same_screen : bool;
    child : window_enum alt_enum;
    dst_x : i16;
    dst_y : i16;
  }
  [@@deriving sexp]

  type input_focus_enum = [ `None | `Pointer_root | `Parent | `Follow_keyboard ]
  [@@deriving sexp]

  type get_input_focus_reply = {
    revert_to : input_focus_enum;
    focus : input_focus_enum alt_enum;
  }
  [@@deriving sexp]

  type query_keymap_reply = u8 list [@@deriving sexp]
  type font_draw_enum = [ `Left_to_right | `Right_to_left ] [@@deriving sexp]
  type fontprop = { name : atom; value : u32 } [@@deriving sexp]

  let decode_fontprop buf : fontprop =
    let name = decode_atom buf in
    let value = Decode.u32 buf in
    ()

  type charinfo = {
    left_side_bearing : i16;
    right_side_bearing : i16;
    character_width : i16;
    ascent : i16;
    descent : i16;
    attributes : u16;
  }
  [@@deriving sexp]

  let decode_charinfo buf : charinfo =
    let left_side_bearing = Decode.i16 buf in
    let right_side_bearing = Decode.i16 buf in
    let character_width = Decode.i16 buf in
    let ascent = Decode.i16 buf in
    let descent = Decode.i16 buf in
    let attributes = Decode.u16 buf in
    ()

  type query_font_reply = {
    min_bounds : charinfo;
    max_bounds : charinfo;
    min_char_or_byte2 : u16;
    max_char_or_byte2 : u16;
    default_char : u16;
    draw_direction : font_draw_enum;
    min_byte1 : u8;
    max_byte1 : u8;
    all_chars_exist : bool;
    font_ascent : i16;
    font_descent : i16;
    properties : fontprop list;
    char_infos : charinfo list;
  }
  [@@deriving sexp]

  type query_text_extents_reply = {
    draw_direction : font_draw_enum;
    font_ascent : i16;
    font_descent : i16;
    overall_ascent : i16;
    overall_descent : i16;
    overall_width : i32;
    overall_left : i32;
    overall_right : i32;
  }
  [@@deriving sexp]

  type str = string [@@deriving sexp]

  let decode_str buf : str =
    let name_len = Decode.u8 buf in
    let name = Decode.string ~len:name_len buf in
    ()

  type list_fonts_reply = str list [@@deriving sexp]

  type list_fonts_with_info_reply = {
    min_bounds : charinfo;
    max_bounds : charinfo;
    min_char_or_byte2 : u16;
    max_char_or_byte2 : u16;
    default_char : u16;
    draw_direction : font_draw_enum;
    min_byte1 : u8;
    max_byte1 : u8;
    all_chars_exist : bool;
    font_ascent : i16;
    font_descent : i16;
    replies_hint : u32;
    properties : fontprop list;
    name : string;
  }
  [@@deriving sexp]

  type get_font_path_reply = str list [@@deriving sexp]

  type gc_mask =
    [ `Function
    | `Plane_mask
    | `Foreground
    | `Background
    | `Line_width
    | `Line_style
    | `Cap_style
    | `Join_style
    | `Fill_style
    | `Fill_rule
    | `Tile
    | `Stipple
    | `Tile_stipple_origin_x
    | `Tile_stipple_origin_y
    | `Font
    | `Subwindow_mode
    | `Graphics_exposures
    | `Clip_origin_x
    | `Clip_origin_y
    | `Clip_mask
    | `Dash_offset
    | `Dash_list
    | `Arc_mode ]
    list
  [@@deriving sexp]

  type gx_enum =
    [ `Clear
    | `And
    | `And_reverse
    | `Copy
    | `And_inverted
    | `Noop
    | `Xor
    | `Or
    | `Nor
    | `Equiv
    | `Invert
    | `Or_reverse
    | `Copy_inverted
    | `Or_inverted
    | `Nand
    | `Set ]
  [@@deriving sexp]

  type line_style_enum = [ `Solid | `On_off_dash | `Double_dash ]
  [@@deriving sexp]

  type cap_style_enum = [ `Not_last | `Butt | `Round | `Projecting ]
  [@@deriving sexp]

  type join_style_enum = [ `Miter | `Round | `Bevel ] [@@deriving sexp]

  type fill_style_enum = [ `Solid | `Tiled | `Stippled | `Opaque_stippled ]
  [@@deriving sexp]

  type fill_rule_enum = [ `Even_odd | `Winding ] [@@deriving sexp]

  type subwindow_mode_enum = [ `Clip_by_children | `Include_inferiors ]
  [@@deriving sexp]

  type arc_mode_enum = [ `Chord | `Pie_slice ] [@@deriving sexp]
  type font_enum = [ `None ] [@@deriving sexp]

  type clip_ordering_enum = [ `Unsorted | `Y_sorted | `Yx_sorted | `Yx_banded ]
  [@@deriving sexp]

  type coord_mode_enum = [ `Origin | `Previous ] [@@deriving sexp]
  type segment = { x1 : i16; y1 : i16; x2 : i16; y2 : i16 } [@@deriving sexp]

  let decode_segment buf : segment =
    let x1 = Decode.i16 buf in
    let y1 = Decode.i16 buf in
    let x2 = Decode.i16 buf in
    let y2 = Decode.i16 buf in
    ()

  type poly_shape_enum = [ `Complex | `Nonconvex | `Convex ] [@@deriving sexp]

  type image_format_enum = [ `Xy_bitmap | `Xy_pixmap | `Z_pixmap ]
  [@@deriving sexp]

  type get_image_reply = { depth : u8; visual : visualid; data : byte list }
  [@@deriving sexp]

  type colormap_alloc_enum = [ `None | `All ] [@@deriving sexp]
  type list_installed_colormaps_reply = colormap list [@@deriving sexp]

  type alloc_color_reply = { red : u16; green : u16; blue : u16; pixel : u32 }
  [@@deriving sexp]

  type alloc_named_color_reply = {
    pixel : u32;
    exact_red : u16;
    exact_green : u16;
    exact_blue : u16;
    visual_red : u16;
    visual_green : u16;
    visual_blue : u16;
  }
  [@@deriving sexp]

  type alloc_color_cells_reply = { pixels : u32 list; masks : u32 list }
  [@@deriving sexp]

  type alloc_color_planes_reply = {
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
    pixels : u32 list;
  }
  [@@deriving sexp]

  type color_flag_mask = [ `Red | `Green | `Blue ] list [@@deriving sexp]

  type coloritem = {
    pixel : u32;
    red : u16;
    green : u16;
    blue : u16;
    flags : color_flag_mask;
  }
  [@@deriving sexp]

  let decode_coloritem buf : coloritem =
    let pixel = Decode.u32 buf in
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    let flags =
      (Decode.mask Decode.byte char_to_int64 color_flag_mask_of_int64) buf
    in
    Decode.pad buf 1;
    ()

  type rgb = { red : u16; green : u16; blue : u16 } [@@deriving sexp]

  let decode_rgb buf : rgb =
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    Decode.pad buf 2;
    ()

  type query_colors_reply = rgb list [@@deriving sexp]

  type lookup_color_reply = {
    exact_red : u16;
    exact_green : u16;
    exact_blue : u16;
    visual_red : u16;
    visual_green : u16;
    visual_blue : u16;
  }
  [@@deriving sexp]

  type query_shape_of_enum =
    [ `Largest_cursor | `Fastest_tile | `Fastest_stipple ]
  [@@deriving sexp]

  type query_best_size_reply = { width : u16; height : u16 } [@@deriving sexp]

  type query_extension_reply = {
    present : bool;
    major_opcode : u8;
    first_event : u8;
    first_error : u8;
  }
  [@@deriving sexp]

  type list_extensions_reply = str list [@@deriving sexp]

  type get_keyboard_mapping_reply = {
    keysyms_per_keycode : byte;
    keysyms : keysym list;
  }
  [@@deriving sexp]

  type kb_mask =
    [ `Key_click_percent
    | `Bell_percent
    | `Bell_pitch
    | `Bell_duration
    | `Led
    | `Led_mode
    | `Key
    | `Auto_repeat_mode ]
    list
  [@@deriving sexp]

  type led_mode_enum = [ `Off | `On ] [@@deriving sexp]
  type auto_repeat_mode_enum = [ `Off | `On | `Default ] [@@deriving sexp]

  type get_keyboard_control_reply = {
    global_auto_repeat : auto_repeat_mode_enum;
    led_mask : u32;
    key_click_percent : u8;
    bell_percent : u8;
    bell_pitch : u16;
    bell_duration : u16;
    auto_repeats : u8 list;
  }
  [@@deriving sexp]

  type get_pointer_control_reply = {
    acceleration_numerator : u16;
    acceleration_denominator : u16;
    threshold : u16;
  }
  [@@deriving sexp]

  type blanking_enum = [ `Not_preferred | `Preferred | `Default ]
  [@@deriving sexp]

  type exposures_enum = [ `Not_allowed | `Allowed | `Default ] [@@deriving sexp]

  type get_screen_saver_reply = {
    timeout : u16;
    interval : u16;
    prefer_blanking : blanking_enum;
    allow_exposures : exposures_enum;
  }
  [@@deriving sexp]

  type host_mode_enum = [ `Insert | `Delete ] [@@deriving sexp]

  type family_enum =
    [ `Internet | `Decnet | `Chaos | `Server_interpreted | `Internet6 ]
  [@@deriving sexp]

  type host = { family : family_enum; address : byte list } [@@deriving sexp]

  let decode_host buf : host =
    let family =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:family_enum_of_int)
        buf
    in
    Decode.pad buf 1;
    let address_len = Decode.u16 buf in
    let address = (Decode.list ~item:Decode.byte) ~len:address_len buf in
    Decode.align buf 4;
    ()

  type access_control_enum = [ `Disable | `Enable ] [@@deriving sexp]

  type list_hosts_reply = { mode : access_control_enum; hosts : host list }
  [@@deriving sexp]

  type close_down_enum = [ `Destroy_all | `Retain_permanent | `Retain_temporary ]
  [@@deriving sexp]

  type kill_enum = [ `All_temporary ] [@@deriving sexp]
  type screen_saver_enum = [ `Reset | `Active ] [@@deriving sexp]
  type mapping_status_enum = [ `Success | `Busy | `Failure ] [@@deriving sexp]
  type set_pointer_mapping_reply = mapping_status_enum [@@deriving sexp]
  type get_pointer_mapping_reply = u8 list [@@deriving sexp]

  type map_index_enum =
    [ `Shift | `Lock | `Control | `D1 | `D2 | `D3 | `D4 | `D5 ]
  [@@deriving sexp]

  type set_modifier_mapping_reply = mapping_status_enum [@@deriving sexp]
  type get_modifier_mapping_reply = keycode list [@@deriving sexp]
end

module Render = struct
  type pict_type_enum = [ `Indexed | `Direct ] [@@deriving sexp]
  type picture_enum = [ `None ] [@@deriving sexp]

  type pict_op_enum =
    [ `Clear
    | `Src
    | `Dst
    | `Over
    | `Over_reverse
    | `In
    | `In_reverse
    | `Out
    | `Out_reverse
    | `Atop
    | `Atop_reverse
    | `Xor
    | `Add
    | `Saturate
    | `Disjoint_clear
    | `Disjoint_src
    | `Disjoint_dst
    | `Disjoint_over
    | `Disjoint_over_reverse
    | `Disjoint_in
    | `Disjoint_in_reverse
    | `Disjoint_out
    | `Disjoint_out_reverse
    | `Disjoint_atop
    | `Disjoint_atop_reverse
    | `Disjoint_xor
    | `Conjoint_clear
    | `Conjoint_src
    | `Conjoint_dst
    | `Conjoint_over
    | `Conjoint_over_reverse
    | `Conjoint_in
    | `Conjoint_in_reverse
    | `Conjoint_out
    | `Conjoint_out_reverse
    | `Conjoint_atop
    | `Conjoint_atop_reverse
    | `Conjoint_xor
    | `Multiply
    | `Screen
    | `Overlay
    | `Darken
    | `Lighten
    | `Color_dodge
    | `Color_burn
    | `Hard_light
    | `Soft_light
    | `Difference
    | `Exclusion
    | `Hsl_hue
    | `Hsl_saturation
    | `Hsl_color
    | `Hsl_luminosity ]
  [@@deriving sexp]

  type poly_edge_enum = [ `Sharp | `Smooth ] [@@deriving sexp]
  type poly_mode_enum = [ `Precise | `Imprecise ] [@@deriving sexp]

  type cp_mask =
    [ `Repeat
    | `Alpha_map
    | `Alpha_x_origin
    | `Alpha_y_origin
    | `Clip_x_origin
    | `Clip_y_origin
    | `Clip_mask
    | `Graphics_exposure
    | `Subwindow_mode
    | `Poly_edge
    | `Poly_mode
    | `Dither
    | `Component_alpha ]
    list
  [@@deriving sexp]

  type sub_pixel_enum =
    [ `Unknown
    | `Horizontal_rgb
    | `Horizontal_bgr
    | `Vertical_rgb
    | `Vertical_bgr
    | `None ]
  [@@deriving sexp]

  type repeat_enum = [ `None | `Normal | `Pad | `Reflect ] [@@deriving sexp]
  type glyph = u32 [@@deriving sexp]

  let decode_glyph = Decode.u32

  type glyphset = xid [@@deriving sexp]

  let decode_glyphset = Decode.xid

  type picture = xid [@@deriving sexp]

  let decode_picture = Decode.xid

  type pictformat = xid [@@deriving sexp]

  let decode_pictformat = Decode.xid

  type fixed = i32 [@@deriving sexp]

  let decode_fixed = Decode.i32

  type pict_format_error = unit [@@deriving sexp]
  type picture_error = unit [@@deriving sexp]
  type pict_op_error = unit [@@deriving sexp]
  type glyph_set_error = unit [@@deriving sexp]
  type glyph_error = unit [@@deriving sexp]

  type directformat = {
    red_shift : u16;
    red_mask : u16;
    green_shift : u16;
    green_mask : u16;
    blue_shift : u16;
    blue_mask : u16;
    alpha_shift : u16;
    alpha_mask : u16;
  }
  [@@deriving sexp]

  let decode_directformat buf : directformat =
    let red_shift = Decode.u16 buf in
    let red_mask = Decode.u16 buf in
    let green_shift = Decode.u16 buf in
    let green_mask = Decode.u16 buf in
    let blue_shift = Decode.u16 buf in
    let blue_mask = Decode.u16 buf in
    let alpha_shift = Decode.u16 buf in
    let alpha_mask = Decode.u16 buf in
    ()

  type pictforminfo = {
    id : pictformat;
    type_ : pict_type_enum;
    depth : u8;
    direct : directformat;
    colormap : Xproto.colormap;
  }
  [@@deriving sexp]

  let decode_pictforminfo buf : pictforminfo =
    let id = decode_pictformat buf in
    let type_ =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:pict_type_enum_of_int)
        buf
    in
    let depth = Decode.u8 buf in
    Decode.pad buf 2;
    let direct = decode_directformat buf in
    let colormap = Xproto.decode_colormap buf in
    ()

  type pictvisual = { visual : Xproto.visualid; format : pictformat }
  [@@deriving sexp]

  let decode_pictvisual buf : pictvisual =
    let visual = Xproto.decode_visualid buf in
    let format = decode_pictformat buf in
    ()

  type pictdepth = { depth : u8; visuals : pictvisual list } [@@deriving sexp]

  let decode_pictdepth buf : pictdepth =
    let depth = Decode.u8 buf in
    Decode.pad buf 1;
    let num_visuals = Decode.u16 buf in
    Decode.pad buf 4;
    let visuals = (Decode.list ~item:decode_pictvisual) ~len:num_visuals buf in
    ()

  type pictscreen = { fallback : pictformat; depths : pictdepth list }
  [@@deriving sexp]

  let decode_pictscreen buf : pictscreen =
    let num_depths = Decode.u32 buf in
    let fallback = decode_pictformat buf in
    let depths = (Decode.list ~item:decode_pictdepth) ~len:num_depths buf in
    ()

  type indexvalue = {
    pixel : u32;
    red : u16;
    green : u16;
    blue : u16;
    alpha : u16;
  }
  [@@deriving sexp]

  let decode_indexvalue buf : indexvalue =
    let pixel = Decode.u32 buf in
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    let alpha = Decode.u16 buf in
    ()

  type color = { red : u16; green : u16; blue : u16; alpha : u16 }
  [@@deriving sexp]

  let decode_color buf : color =
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    let alpha = Decode.u16 buf in
    ()

  type pointfix = { x : fixed; y : fixed } [@@deriving sexp]

  let decode_pointfix buf : pointfix =
    let x = decode_fixed buf in
    let y = decode_fixed buf in
    ()

  type linefix = { p1 : pointfix; p2 : pointfix } [@@deriving sexp]

  let decode_linefix buf : linefix =
    let p1 = decode_pointfix buf in
    let p2 = decode_pointfix buf in
    ()

  type triangle = { p1 : pointfix; p2 : pointfix; p3 : pointfix }
  [@@deriving sexp]

  let decode_triangle buf : triangle =
    let p1 = decode_pointfix buf in
    let p2 = decode_pointfix buf in
    let p3 = decode_pointfix buf in
    ()

  type trapezoid = {
    top : fixed;
    bottom : fixed;
    left : linefix;
    right : linefix;
  }
  [@@deriving sexp]

  let decode_trapezoid buf : trapezoid =
    let top = decode_fixed buf in
    let bottom = decode_fixed buf in
    let left = decode_linefix buf in
    let right = decode_linefix buf in
    ()

  type glyphinfo = {
    width : u16;
    height : u16;
    x : i16;
    y : i16;
    x_off : i16;
    y_off : i16;
  }
  [@@deriving sexp]

  let decode_glyphinfo buf : glyphinfo =
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let x_off = Decode.i16 buf in
    let y_off = Decode.i16 buf in
    ()

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  type query_pict_formats_reply = {
    num_depths : u32;
    num_visuals : u32;
    formats : pictforminfo list;
    screens : pictscreen list;
    subpixels : sub_pixel_enum list;
  }
  [@@deriving sexp]

  type query_pict_index_values_reply = indexvalue list [@@deriving sexp]

  type transform = {
    matrix11 : fixed;
    matrix12 : fixed;
    matrix13 : fixed;
    matrix21 : fixed;
    matrix22 : fixed;
    matrix23 : fixed;
    matrix31 : fixed;
    matrix32 : fixed;
    matrix33 : fixed;
  }
  [@@deriving sexp]

  let decode_transform buf : transform =
    let matrix11 = decode_fixed buf in
    let matrix12 = decode_fixed buf in
    let matrix13 = decode_fixed buf in
    let matrix21 = decode_fixed buf in
    let matrix22 = decode_fixed buf in
    let matrix23 = decode_fixed buf in
    let matrix31 = decode_fixed buf in
    let matrix32 = decode_fixed buf in
    let matrix33 = decode_fixed buf in
    ()

  type query_filters_reply = { aliases : u16 list; filters : Xproto.str list }
  [@@deriving sexp]

  type animcursorelt = { cursor : Xproto.cursor; delay : u32 } [@@deriving sexp]

  let decode_animcursorelt buf : animcursorelt =
    let cursor = Xproto.decode_cursor buf in
    let delay = Decode.u32 buf in
    ()

  type spanfix = { l : fixed; r : fixed; y : fixed } [@@deriving sexp]

  let decode_spanfix buf : spanfix =
    let l = decode_fixed buf in
    let r = decode_fixed buf in
    let y = decode_fixed buf in
    ()

  type trap = { top : spanfix; bot : spanfix } [@@deriving sexp]

  let decode_trap buf : trap =
    let top = decode_spanfix buf in
    let bot = decode_spanfix buf in
    ()
end

