    x : i16;
    y : i16;
    width : u16;
    height : u16;
    border_width : u16;
  }
  [@@deriving sexp]

  let decode_get_geometry_reply buf : get_geometry_reply =
    Decode.pad buf 1;
    let depth = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let root = decode_window buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let border_width = Decode.u16 buf in
    Decode.pad buf 2;
    ignore length;
    { depth; root; x; y; width; height; border_width }

  type query_tree_reply = {
    root : window;
    parent : [ window_enum | window custom ];
    children : window list;
  }
