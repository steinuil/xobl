module Xtest = struct
  type get_version_reply = { major_version : u8; minor_version : u16 }
  [@@deriving sexp]

  let decode_get_version_reply buf : get_version_reply =
    Decode.pad buf 1;
    let major_version = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let minor_version = Decode.u16 buf in
    ignore length;
    { major_version; minor_version }

  type cursor_enum = [ `None | `Current ] [@@deriving sexp]

  let cursor_enum_of_int n : [ cursor_enum | int custom ] =
    match n with 0 -> `None | 1 -> `Current | _ -> `Custom n

  type compare_cursor_reply = bool [@@deriving sexp]

  let decode_compare_cursor_reply buf : compare_cursor_reply =
    Decode.pad buf 1;
    let same = Decode.bool buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    ignore length;
    same
end

module Xv = struct
  type port = xid [@@deriving sexp]

  let decode_port = Decode.xid

  type encoding = xid [@@deriving sexp]

  let decode_encoding = Decode.xid

  type type_mask =
    [ `Input_mask | `Output_mask | `Video_mask | `Still_mask | `Image_mask ]
    list
  [@@deriving sexp]

  type image_format_info_type_enum = [ `Rgb | `Yuv ] [@@deriving sexp]

  let image_format_info_type_enum_of_int n :
      [ image_format_info_type_enum | int custom ] =
    match n with 0 -> `Rgb | 1 -> `Yuv | _ -> `Custom n

  type image_format_info_format_enum = [ `Packed | `Planar ] [@@deriving sexp]

  let image_format_info_format_enum_of_int n :
      [ image_format_info_format_enum | int custom ] =
    match n with 0 -> `Packed | 1 -> `Planar | _ -> `Custom n

  type attribute_flag_mask = [ `Gettable | `Settable ] list [@@deriving sexp]

  type video_notify_reason_enum =
    [ `Started | `Stopped | `Busy | `Preempted | `Hard_error ]
  [@@deriving sexp]

  let video_notify_reason_enum_of_int n :
      [ video_notify_reason_enum | int custom ] =
    match n with
    | 0 -> `Started
    | 1 -> `Stopped
    | 2 -> `Busy
    | 3 -> `Preempted
    | 4 -> `Hard_error
    | _ -> `Custom n

  type scanline_order_enum = [ `Top_to_bottom | `Bottom_to_top ]
  [@@deriving sexp]

  let scanline_order_enum_of_int n : [ scanline_order_enum | int custom ] =
    match n with 0 -> `Top_to_bottom | 1 -> `Bottom_to_top | _ -> `Custom n

  type grab_port_status_enum =
    [ `Success
    | `Bad_extension
    | `Already_grabbed
    | `Invalid_time
    | `Bad_reply
    | `Bad_alloc ]
  [@@deriving sexp]

  let grab_port_status_enum_of_int n : [ grab_port_status_enum | int custom ] =
    match n with
    | 0 -> `Success
    | 1 -> `Bad_extension
    | 2 -> `Already_grabbed
    | 3 -> `Invalid_time
    | 4 -> `Bad_reply
    | 5 -> `Bad_alloc
    | _ -> `Custom n

  type rational = { numerator : i32; denominator : i32 } [@@deriving sexp]

  let decode_rational buf : rational =
    let numerator = Decode.i32 buf in
    let denominator = Decode.i32 buf in
    { numerator; denominator }

  type format = { visual : Xproto.visualid; depth : u8 } [@@deriving sexp]

  let decode_format buf : format =
    let visual = Xproto.decode_visualid buf in
    let depth = Decode.u8 buf in
    Decode.pad buf 3;
    { visual; depth }

  type adaptor_info = {
    base_id : port;
    num_ports : u16;
    type_ : type_mask;
    name : string;
    formats : format list;
  }
  [@@deriving sexp]

  let decode_adaptor_info buf : adaptor_info =
    let base_id = decode_port buf in
    let name_size = Decode.u16 buf in
    let num_ports = Decode.u16 buf in
    let num_formats = Decode.u16 buf in
    let type_ = (Decode.mask Decode.u8 Int64.of_int type_mask_of_int64) buf in
    Decode.pad buf 1;
    let name = Decode.string ~len:name_size buf in
    Decode.align buf 4;
    let formats = (Decode.list ~item:decode_format) ~len:num_formats buf in
    { base_id; num_ports; type_; name; formats }

  type encoding_info = {
    encoding : encoding;
    width : u16;
    height : u16;
    rate : rational;
    name : string;
  }
  [@@deriving sexp]

  let decode_encoding_info buf : encoding_info =
    let encoding = decode_encoding buf in
    let name_size = Decode.u16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    Decode.pad buf 2;
    let rate = decode_rational buf in
    let name = Decode.string ~len:name_size buf in
    Decode.align buf 4;
    { encoding; width; height; rate; name }

  type image = {
    id : u32;
    width : u16;
    height : u16;
    pitches : u32 list;
    offsets : u32 list;
    data : u8 list;
  }
  [@@deriving sexp]

  let decode_image buf : image =
    let id = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let data_size = Decode.u32 buf in
    let num_planes = Decode.u32 buf in
    let pitches = (Decode.list ~item:Decode.u32) ~len:num_planes buf in
    let offsets = (Decode.list ~item:Decode.u32) ~len:num_planes buf in
    let data = (Decode.list ~item:Decode.u8) ~len:data_size buf in
    { id; width; height; pitches; offsets; data }

  type attribute_info = {
    flags : attribute_flag_mask;
    min : i32;
    max : i32;
    name : string;
  }
  [@@deriving sexp]

  let decode_attribute_info buf : attribute_info =
    let flags =
      (Decode.mask Decode.u32 Int64.of_int attribute_flag_mask_of_int64) buf
    in
    let min = Decode.i32 buf in
    let max = Decode.i32 buf in
    let size = Decode.u32 buf in
    let name = Decode.string ~len:size buf in
    Decode.align buf 4;
    { flags; min; max; name }

  type image_format_info = {
    id : u32;
    type_ : image_format_info_type_enum;
    byte_order : Xproto.image_order_enum;
    guid : u8 list;
    bpp : u8;
    num_planes : u8;
    depth : u8;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
    format : image_format_info_format_enum;
    y_sample_bits : u32;
    u_sample_bits : u32;
    v_sample_bits : u32;
    vhorz_y_period : u32;
    vhorz_u_period : u32;
    vhorz_v_period : u32;
    vvert_y_period : u32;
    vvert_u_period : u32;
    vvert_v_period : u32;
    vcomp_order : u8 list;
    vscanline_order : scanline_order_enum;
  }
  [@@deriving sexp]

  let decode_image_format_info buf : image_format_info =
    let id = Decode.u32 buf in
    let type_ =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_format_info_type_enum_of_int)
        buf
    in
    let byte_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.image_order_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let guid = (Decode.list ~item:Decode.u8) ~len:16 buf in
    let bpp = Decode.u8 buf in
    let num_planes = Decode.u8 buf in
    Decode.pad buf 2;
    let depth = Decode.u8 buf in
    Decode.pad buf 3;
    let red_mask = Decode.u32 buf in
    let green_mask = Decode.u32 buf in
    let blue_mask = Decode.u32 buf in
    let format =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_format_info_format_enum_of_int)
        buf
    in
    Decode.pad buf 3;
    let y_sample_bits = Decode.u32 buf in
    let u_sample_bits = Decode.u32 buf in
    let v_sample_bits = Decode.u32 buf in
    let vhorz_y_period = Decode.u32 buf in
    let vhorz_u_period = Decode.u32 buf in
    let vhorz_v_period = Decode.u32 buf in
    let vvert_y_period = Decode.u32 buf in
    let vvert_u_period = Decode.u32 buf in
    let vvert_v_period = Decode.u32 buf in
    let vcomp_order = (Decode.list ~item:Decode.u8) ~len:32 buf in
    let vscanline_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:scanline_order_enum_of_int)
        buf
    in
    Decode.pad buf 11;
    {
      id;
      type_;
      byte_order;
      guid;
      bpp;
      num_planes;
      depth;
      red_mask;
      green_mask;
      blue_mask;
      format;
      y_sample_bits;
      u_sample_bits;
      v_sample_bits;
      vhorz_y_period;
      vhorz_u_period;
      vhorz_v_period;
      vvert_y_period;
      vvert_u_period;
      vvert_v_period;
      vcomp_order;
      vscanline_order;
    }

  type bad_port_error = unit [@@deriving sexp]

  let decode_bad_port_error _ : bad_port_error = Decode.pad 32

  type bad_encoding_error = unit [@@deriving sexp]

  let decode_bad_encoding_error _ : bad_encoding_error = Decode.pad 32

  type bad_control_error = unit [@@deriving sexp]

  let decode_bad_control_error _ : bad_control_error = Decode.pad 32

  type video_notify_event = {
    reason : video_notify_reason_enum;
    time : Xproto.timestamp;
    drawable : Xproto.drawable;
    port : port;
  }
  [@@deriving sexp]

  let decode_video_notify_event buf : video_notify_event =
    Decode.pad buf 1;
    let reason =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:video_notify_reason_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let time = Xproto.decode_timestamp buf in
    let drawable = Xproto.decode_drawable buf in
    let port = decode_port buf in
    ignore length;
    { reason; time; drawable; port }

  type port_notify_event = {
    time : Xproto.timestamp;
    port : port;
    attribute : Xproto.atom;
    value : i32;
  }
  [@@deriving sexp]

  let decode_port_notify_event buf : port_notify_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let time = Xproto.decode_timestamp buf in
    let port = decode_port buf in
    let attribute = Xproto.decode_atom buf in
    let value = Decode.i32 buf in
    ignore length;
    { time; port; attribute; value }

  type query_extension_reply = { major : u16; minor : u16 } [@@deriving sexp]

  let decode_query_extension_reply buf : query_extension_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major = Decode.u16 buf in
    let minor = Decode.u16 buf in
    ignore length;
    { major; minor }

  type query_adaptors_reply = adaptor_info list [@@deriving sexp]

  let decode_query_adaptors_reply buf : query_adaptors_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_adaptors = Decode.u16 buf in
    Decode.pad buf 22;
    let info = (Decode.list ~item:decode_adaptor_info) ~len:num_adaptors buf in
    ignore length;
    info

  type query_encodings_reply = encoding_info list [@@deriving sexp]

  let decode_query_encodings_reply buf : query_encodings_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_encodings = Decode.u16 buf in
    Decode.pad buf 22;
    let info =
      (Decode.list ~item:decode_encoding_info) ~len:num_encodings buf
    in
    ignore length;
    info

  type grab_port_reply = grab_port_status_enum [@@deriving sexp]

  let decode_grab_port_reply buf : grab_port_reply =
    Decode.pad buf 1;
    let result =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:grab_port_status_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    ignore length;
    result

  type query_best_size_reply = { actual_width : u16; actual_height : u16 }
  [@@deriving sexp]

  let decode_query_best_size_reply buf : query_best_size_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let actual_width = Decode.u16 buf in
    let actual_height = Decode.u16 buf in
    ignore length;
    { actual_width; actual_height }

  type get_port_attribute_reply = i32 [@@deriving sexp]

  let decode_get_port_attribute_reply buf : get_port_attribute_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let value = Decode.i32 buf in
    ignore length;
    value

  type query_port_attributes_reply = {
    text_size : u32;
    attributes : attribute_info list;
  }
  [@@deriving sexp]

  let decode_query_port_attributes_reply buf : query_port_attributes_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_attributes = Decode.u32 buf in
    let text_size = Decode.u32 buf in
    Decode.pad buf 16;
    let attributes =
      (Decode.list ~item:decode_attribute_info) ~len:num_attributes buf
    in
    ignore length;
    { text_size; attributes }

  type list_image_formats_reply = image_format_info list [@@deriving sexp]

  let decode_list_image_formats_reply buf : list_image_formats_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_formats = Decode.u32 buf in
    Decode.pad buf 20;
    let format =
      (Decode.list ~item:decode_image_format_info) ~len:num_formats buf
    in
    ignore length;
    format

  type query_image_attributes_reply = {
    data_size : u32;
    width : u16;
    height : u16;
    pitches : u32 list;
    offsets : u32 list;
  }
  [@@deriving sexp]

  let decode_query_image_attributes_reply buf : query_image_attributes_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_planes = Decode.u32 buf in
    let data_size = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    Decode.pad buf 12;
    let pitches = (Decode.list ~item:Decode.u32) ~len:num_planes buf in
    let offsets = (Decode.list ~item:Decode.u32) ~len:num_planes buf in
    ignore length;
    { data_size; width; height; pitches; offsets }
end

module Xvmc = struct
  type context = xid [@@deriving sexp]

  let decode_context = Decode.xid

  type surface = xid [@@deriving sexp]

  let decode_surface = Decode.xid

  type subpicture = xid [@@deriving sexp]

  let decode_subpicture = Decode.xid

  type surface_info = {
    id : surface;
    chroma_format : u16;
    pad0 : u16;
    max_width : u16;
    max_height : u16;
    subpicture_max_width : u16;
    subpicture_max_height : u16;
    mc_type : u32;
    flags : u32;
  }
  [@@deriving sexp]

  let decode_surface_info buf : surface_info =
    let id = decode_surface buf in
    let chroma_format = Decode.u16 buf in
    let pad0 = Decode.u16 buf in
    let max_width = Decode.u16 buf in
    let max_height = Decode.u16 buf in
    let subpicture_max_width = Decode.u16 buf in
    let subpicture_max_height = Decode.u16 buf in
    let mc_type = Decode.u32 buf in
    let flags = Decode.u32 buf in
    {
      id;
      chroma_format;
      pad0;
      max_width;
      max_height;
      subpicture_max_width;
      subpicture_max_height;
      mc_type;
      flags;
    }

  type query_version_reply = { major : u32; minor : u32 } [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major = Decode.u32 buf in
    let minor = Decode.u32 buf in
    ignore length;
    { major; minor }

  type list_surface_types_reply = surface_info list [@@deriving sexp]

  let decode_list_surface_types_reply buf : list_surface_types_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num = Decode.u32 buf in
    Decode.pad buf 20;
    let surfaces = (Decode.list ~item:decode_surface_info) ~len:num buf in
    ignore length;
    surfaces

  type create_context_reply = {
    width_actual : u16;
    height_actual : u16;
    flags_return : u32;
    priv_data : u32 list;
  }
  [@@deriving sexp]

  let decode_create_context_reply buf : create_context_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let width_actual = Decode.u16 buf in
    let height_actual = Decode.u16 buf in
    let flags_return = Decode.u32 buf in
    Decode.pad buf 20;
    let priv_data = (Decode.list ~item:Decode.u32) ~len:length buf in
    ignore length;
    { width_actual; height_actual; flags_return; priv_data }

  type create_surface_reply = u32 list [@@deriving sexp]

  let decode_create_surface_reply buf : create_surface_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 24;
    let priv_data = (Decode.list ~item:Decode.u32) ~len:length buf in
    ignore length;
    priv_data

  type create_subpicture_reply = {
    width_actual : u16;
    height_actual : u16;
    num_palette_entries : u16;
    entry_bytes : u16;
    component_order : u8 list;
    priv_data : u32 list;
  }
  [@@deriving sexp]

  let decode_create_subpicture_reply buf : create_subpicture_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let width_actual = Decode.u16 buf in
    let height_actual = Decode.u16 buf in
    let num_palette_entries = Decode.u16 buf in
    let entry_bytes = Decode.u16 buf in
    let component_order = (Decode.list ~item:Decode.u8) ~len:4 buf in
    Decode.pad buf 12;
    let priv_data = (Decode.list ~item:Decode.u32) ~len:length buf in
    ignore length;
    {
      width_actual;
      height_actual;
      num_palette_entries;
      entry_bytes;
      component_order;
      priv_data;
    }

  type list_subpicture_types_reply = Xv.image_format_info list [@@deriving sexp]

  let decode_list_subpicture_types_reply buf : list_subpicture_types_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num = Decode.u32 buf in
    Decode.pad buf 20;
    let types = (Decode.list ~item:Xv.decode_image_format_info) ~len:num buf in
    ignore length;
    types
end
