    let sourceid = decode_device_id buf in
    let valuators_len = Decode.u16 buf in
    let flags =
      (Decode.mask Decode.u32 Int64.of_int key_event_flags_mask_of_int64) buf
    in
    Decode.pad buf 4;
    let valuator_mask = (Decode.list ~item:Decode.u32) ~len:valuators_len buf in
    let axisvalues =
      (Decode.list ~item:decode_fp3232)
        ~len:
          (sum_of_expr
