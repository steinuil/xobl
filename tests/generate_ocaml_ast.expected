    { width; data }

  type get_histogram_parameterfv_reply = {
    datum : float32;
    data : float32 list;
  }
  [@@deriving sexp]

  let decode_get_histogram_parameterfv_reply buf :
      get_histogram_parameterfv_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    let datum = decode_float32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:decode_float32) ~len:n buf in
    ignore length;
    { datum; data }

  type get_histogram_parameteriv_reply = { datum : i32; data : i32 list }
  [@@deriving sexp]

  let decode_get_histogram_parameteriv_reply buf :
      get_histogram_parameteriv_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    let datum = Decode.i32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.i32) ~len:n buf in
    ignore length;
    { datum; data }

  type get_minmax_reply = byte list [@@deriving sexp]

  let decode_get_minmax_reply buf : get_minmax_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 24;
    let data = (Decode.list ~item:Decode.byte) ~len:(length * 4) buf in
    ignore length;
    data

  type get_minmax_parameterfv_reply = { datum : float32; data : float32 list }
  [@@deriving sexp]

  let decode_get_minmax_parameterfv_reply buf : get_minmax_parameterfv_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    let datum = decode_float32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:decode_float32) ~len:n buf in
    ignore length;
    { datum; data }

  type get_minmax_parameteriv_reply = { datum : i32; data : i32 list }
  [@@deriving sexp]

  let decode_get_minmax_parameteriv_reply buf : get_minmax_parameteriv_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    let datum = Decode.i32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.i32) ~len:n buf in
    ignore length;
    { datum; data }

  type get_compressed_tex_image_arb_reply = { size : i32; data : byte list }
  [@@deriving sexp]

  let decode_get_compressed_tex_image_arb_reply buf :
      get_compressed_tex_image_arb_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 8;
    let size = Decode.i32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.byte) ~len:(length * 4) buf in
    ignore length;
    { size; data }

  type gen_queries_arb_reply = u32 list [@@deriving sexp]

  let decode_gen_queries_arb_reply buf : gen_queries_arb_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 24;
    let data = (Decode.list ~item:Decode.u32) ~len:length buf in
    ignore length;
    data

  type is_query_arb_reply = bool32 [@@deriving sexp]

  let decode_is_query_arb_reply buf : is_query_arb_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let ret_val = decode_bool32 buf in
    ignore length;
    ret_val

  type get_queryiv_arb_reply = { datum : i32; data : i32 list }
  [@@deriving sexp]

  let decode_get_queryiv_arb_reply buf : get_queryiv_arb_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    let datum = Decode.i32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.i32) ~len:n buf in
    ignore length;
    { datum; data }

  type get_query_objectiv_arb_reply = { datum : i32; data : i32 list }
  [@@deriving sexp]

  let decode_get_query_objectiv_arb_reply buf : get_query_objectiv_arb_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    let datum = Decode.i32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.i32) ~len:n buf in
    ignore length;
    { datum; data }

  type get_query_objectuiv_arb_reply = { datum : u32; data : u32 list }
  [@@deriving sexp]

  let decode_get_query_objectuiv_arb_reply buf : get_query_objectuiv_arb_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    let datum = Decode.u32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.u32) ~len:n buf in
    ignore length;
    { datum; data }
end

module Randr = struct
  type mode = xid [@@deriving sexp]

  let decode_mode = Decode.xid

  type crtc = xid [@@deriving sexp]

  let decode_crtc = Decode.xid

  type output = xid [@@deriving sexp]

  let decode_output = Decode.xid

  type provider = xid [@@deriving sexp]

  let decode_provider = Decode.xid

  type lease = xid [@@deriving sexp]

  let decode_lease = Decode.xid

  type bad_output_error = unit [@@deriving sexp]

  let decode_bad_output_error _ : bad_output_error = Decode.pad 32

  type bad_crtc_error = unit [@@deriving sexp]

  let decode_bad_crtc_error _ : bad_crtc_error = Decode.pad 32

  type bad_mode_error = unit [@@deriving sexp]

  let decode_bad_mode_error _ : bad_mode_error = Decode.pad 32

  type bad_provider_error = unit [@@deriving sexp]

  let decode_bad_provider_error _ : bad_provider_error = Decode.pad 32

  type rotation_mask =
    [ `Rotate_0
    | `Rotate_90
    | `Rotate_180
    | `Rotate_270
    | `Reflect_x
    | `Reflect_y ]
    list
  [@@deriving sexp]

  type screen_size = { width : u16; height : u16; mwidth : u16; mheight : u16 }
  [@@deriving sexp]

  let decode_screen_size buf : screen_size =
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let mwidth = Decode.u16 buf in
    let mheight = Decode.u16 buf in
    { width; height; mwidth; mheight }

  type refresh_rates = u16 list [@@deriving sexp]

  let decode_refresh_rates buf : refresh_rates =
    let n_rates = Decode.u16 buf in
    let rates = (Decode.list ~item:Decode.u16) ~len:n_rates buf in
    rates

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    { major_version; minor_version }

  type set_config_enum =
    [ `Success | `Invalid_config_time | `Invalid_time | `Failed ]
  [@@deriving sexp]

  let set_config_enum_of_int n : [ set_config_enum | int custom ] =
    match n with
    | 0 -> `Success
    | 1 -> `Invalid_config_time
    | 2 -> `Invalid_time
    | 3 -> `Failed
    | _ -> `Custom n

  type set_screen_config_reply = {
    status : set_config_enum;
    new_timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    root : Xproto.window;
    subpixel_order : Render.sub_pixel_enum;
  }
  [@@deriving sexp]

  let decode_set_screen_config_reply buf : set_screen_config_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:set_config_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let new_timestamp = Xproto.decode_timestamp buf in
    let config_timestamp = Xproto.decode_timestamp buf in
    let root = Xproto.decode_window buf in
    let subpixel_order =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:Render.sub_pixel_enum_of_int)
        buf
    in
    Decode.pad buf 10;
    ignore length;
    { status; new_timestamp; config_timestamp; root; subpixel_order }

  type notify_mask =
    [ `Screen_change
    | `Crtc_change
    | `Output_change
    | `Output_property
    | `Provider_change
    | `Provider_property
    | `Resource_change
    | `Lease ]
    list
  [@@deriving sexp]

  type get_screen_info_reply = {
    rotations : rotation_mask;
    root : Xproto.window;
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    size_id : u16;
    rotation : rotation_mask;
    rate : u16;
    n_info : u16;
    sizes : screen_size list;
    rates : refresh_rates list;
  }
  [@@deriving sexp]

  let decode_get_screen_info_reply buf : get_screen_info_reply =
    Decode.pad buf 1;
    let rotations =
      (Decode.mask Decode.u8 Int64.of_int rotation_mask_of_int64) buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let root = Xproto.decode_window buf in
    let timestamp = Xproto.decode_timestamp buf in
    let config_timestamp = Xproto.decode_timestamp buf in
    let n_sizes = Decode.u16 buf in
    let size_id = Decode.u16 buf in
    let rotation =
      (Decode.mask Decode.u16 Int64.of_int rotation_mask_of_int64) buf
    in
    let rate = Decode.u16 buf in
    let n_info = Decode.u16 buf in
    Decode.pad buf 2;
    let sizes = (Decode.list ~item:decode_screen_size) ~len:n_sizes buf in
    let rates =
      (Decode.list ~item:decode_refresh_rates) ~len:(n_info - n_sizes) buf
    in
    ignore length;
    {
      rotations;
      root;
      timestamp;
      config_timestamp;
      size_id;
      rotation;
      rate;
      n_info;
      sizes;
      rates;
    }

  type get_screen_size_range_reply = {
    min_width : u16;
    min_height : u16;
    max_width : u16;
    max_height : u16;
  }
  [@@deriving sexp]

  let decode_get_screen_size_range_reply buf : get_screen_size_range_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let min_width = Decode.u16 buf in
    let min_height = Decode.u16 buf in
    let max_width = Decode.u16 buf in
    let max_height = Decode.u16 buf in
    Decode.pad buf 16;
    ignore length;
    { min_width; min_height; max_width; max_height }

  type mode_flag_mask =
    [ `Hsync_positive
    | `Hsync_negative
    | `Vsync_positive
    | `Vsync_negative
    | `Interlace
    | `Double_scan
    | `Csync
    | `Csync_positive
    | `Csync_negative
    | `Hskew_present
    | `Bcast
    | `Pixel_multiplex
    | `Double_clock
    | `Halve_clock ]
    list
  [@@deriving sexp]

  type mode_info = {
    id : u32;
    width : u16;
    height : u16;
    dot_clock : u32;
    hsync_start : u16;
    hsync_end : u16;
    htotal : u16;
    hskew : u16;
    vsync_start : u16;
    vsync_end : u16;
    vtotal : u16;
    name_len : u16;
    mode_flags : mode_flag_mask;
  }
  [@@deriving sexp]

  let decode_mode_info buf : mode_info =
    let id = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let dot_clock = Decode.u32 buf in
    let hsync_start = Decode.u16 buf in
    let hsync_end = Decode.u16 buf in
    let htotal = Decode.u16 buf in
    let hskew = Decode.u16 buf in
    let vsync_start = Decode.u16 buf in
    let vsync_end = Decode.u16 buf in
    let vtotal = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    let mode_flags =
      (Decode.mask Decode.u32 Int64.of_int mode_flag_mask_of_int64) buf
    in
    {
      id;
      width;
      height;
      dot_clock;
      hsync_start;
      hsync_end;
      htotal;
      hskew;
      vsync_start;
      vsync_end;
      vtotal;
      name_len;
      mode_flags;
    }

  type get_screen_resources_reply = {
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    crtcs : crtc list;
    outputs : output list;
    modes : mode_info list;
    names : byte list;
  }
  [@@deriving sexp]

  let decode_get_screen_resources_reply buf : get_screen_resources_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let config_timestamp = Xproto.decode_timestamp buf in
    let num_crtcs = Decode.u16 buf in
    let num_outputs = Decode.u16 buf in
    let num_modes = Decode.u16 buf in
    let names_len = Decode.u16 buf in
    Decode.pad buf 8;
    let crtcs = (Decode.list ~item:decode_crtc) ~len:num_crtcs buf in
    let outputs = (Decode.list ~item:decode_output) ~len:num_outputs buf in
    let modes = (Decode.list ~item:decode_mode_info) ~len:num_modes buf in
    let names = (Decode.list ~item:Decode.byte) ~len:names_len buf in
    ignore length;
    { timestamp; config_timestamp; crtcs; outputs; modes; names }

  type connection_enum = [ `Connected | `Disconnected | `Unknown ]
  [@@deriving sexp]

  let connection_enum_of_int n : [ connection_enum | int custom ] =
    match n with
    | 0 -> `Connected
    | 1 -> `Disconnected
    | 2 -> `Unknown
    | _ -> `Custom n

  type get_output_info_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
    crtc : crtc;
    mm_width : u32;
    mm_height : u32;
    connection : connection_enum;
    subpixel_order : Render.sub_pixel_enum;
    num_preferred : u16;
    crtcs : crtc list;
    modes : mode list;
    clones : output list;
    name : byte list;
  }
  [@@deriving sexp]

  let decode_get_output_info_reply buf : get_output_info_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:set_config_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let crtc = decode_crtc buf in
    let mm_width = Decode.u32 buf in
    let mm_height = Decode.u32 buf in
    let connection =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:connection_enum_of_int)
        buf
    in
    let subpixel_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Render.sub_pixel_enum_of_int)
        buf
    in
    let num_crtcs = Decode.u16 buf in
    let num_modes = Decode.u16 buf in
    let num_preferred = Decode.u16 buf in
    let num_clones = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    let crtcs = (Decode.list ~item:decode_crtc) ~len:num_crtcs buf in
    let modes = (Decode.list ~item:decode_mode) ~len:num_modes buf in
    let clones = (Decode.list ~item:decode_output) ~len:num_clones buf in
    let name = (Decode.list ~item:Decode.byte) ~len:name_len buf in
    ignore length;
    {
      status;
      timestamp;
      crtc;
      mm_width;
      mm_height;
      connection;
      subpixel_order;
      num_preferred;
      crtcs;
      modes;
      clones;
      name;
    }

  type list_output_properties_reply = Xproto.atom list [@@deriving sexp]

  let decode_list_output_properties_reply buf : list_output_properties_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_atoms = Decode.u16 buf in
    Decode.pad buf 22;
    let atoms = (Decode.list ~item:Xproto.decode_atom) ~len:num_atoms buf in
    ignore length;
    atoms

  type query_output_property_reply = {
    pending : bool;
    range : bool;
    immutable : bool;
    valid_values : i32 list;
  }
  [@@deriving sexp]

  let decode_query_output_property_reply buf : query_output_property_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let pending = Decode.bool buf in
    let range = Decode.bool buf in
    let immutable = Decode.bool buf in
    Decode.pad buf 21;
    let valid_values = (Decode.list ~item:Decode.i32) ~len:length buf in
    ignore length;
    { pending; range; immutable; valid_values }

  type get_output_property_reply = {
    format : u8;
    type_ : [ Xproto.atom_enum | Xproto.atom custom ];
    bytes_after : u32;
    num_items : u32;
    data : byte list;
  }
  [@@deriving sexp]

  let decode_get_output_property_reply buf : get_output_property_reply =
    Decode.pad buf 1;
    let format = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let type_ =
      (Decode.alt_enum Xproto.decode_atom identity Xproto.atom_enum_of_int) buf
    in
    let bytes_after = Decode.u32 buf in
    let num_items = Decode.u32 buf in
    Decode.pad buf 12;
    let data =
      (Decode.list ~item:Decode.byte) ~len:(num_items * (format / 8)) buf
    in
    ignore length;
    { format; type_; bytes_after; num_items; data }

  type create_mode_reply = mode [@@deriving sexp]

  let decode_create_mode_reply buf : create_mode_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let mode = decode_mode buf in
    Decode.pad buf 20;
    ignore length;
    mode

  type get_crtc_info_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    mode : mode;
    rotation : rotation_mask;
    rotations : rotation_mask;
    outputs : output list;
    possible : output list;
  }
  [@@deriving sexp]

  let decode_get_crtc_info_reply buf : get_crtc_info_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:set_config_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let mode = decode_mode buf in
    let rotation =
      (Decode.mask Decode.u16 Int64.of_int rotation_mask_of_int64) buf
    in
    let rotations =
      (Decode.mask Decode.u16 Int64.of_int rotation_mask_of_int64) buf
    in
    let num_outputs = Decode.u16 buf in
    let num_possible_outputs = Decode.u16 buf in
    let outputs = (Decode.list ~item:decode_output) ~len:num_outputs buf in
    let possible =
      (Decode.list ~item:decode_output) ~len:num_possible_outputs buf
    in
    ignore length;
    {
      status;
      timestamp;
      x;
      y;
      width;
      height;
      mode;
      rotation;
      rotations;
      outputs;
      possible;
    }

  type set_crtc_config_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
  }
  [@@deriving sexp]

  let decode_set_crtc_config_reply buf : set_crtc_config_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:set_config_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    Decode.pad buf 20;
    ignore length;
    { status; timestamp }

  type get_crtc_gamma_size_reply = u16 [@@deriving sexp]

  let decode_get_crtc_gamma_size_reply buf : get_crtc_gamma_size_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let size = Decode.u16 buf in
    Decode.pad buf 22;
    ignore length;
    size

  type get_crtc_gamma_reply = {
    red : u16 list;
    green : u16 list;
    blue : u16 list;
  }
  [@@deriving sexp]

  let decode_get_crtc_gamma_reply buf : get_crtc_gamma_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let size = Decode.u16 buf in
    Decode.pad buf 22;
    let red = (Decode.list ~item:Decode.u16) ~len:size buf in
    let green = (Decode.list ~item:Decode.u16) ~len:size buf in
    let blue = (Decode.list ~item:Decode.u16) ~len:size buf in
    ignore length;
    { red; green; blue }

  type get_screen_resources_current_reply = {
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    crtcs : crtc list;
    outputs : output list;
    modes : mode_info list;
    names : byte list;
  }
  [@@deriving sexp]

  let decode_get_screen_resources_current_reply buf :
      get_screen_resources_current_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let config_timestamp = Xproto.decode_timestamp buf in
    let num_crtcs = Decode.u16 buf in
    let num_outputs = Decode.u16 buf in
    let num_modes = Decode.u16 buf in
    let names_len = Decode.u16 buf in
    Decode.pad buf 8;
    let crtcs = (Decode.list ~item:decode_crtc) ~len:num_crtcs buf in
    let outputs = (Decode.list ~item:decode_output) ~len:num_outputs buf in
    let modes = (Decode.list ~item:decode_mode_info) ~len:num_modes buf in
    let names = (Decode.list ~item:Decode.byte) ~len:names_len buf in
    ignore length;
    { timestamp; config_timestamp; crtcs; outputs; modes; names }

  type transform_mask = [ `Unit | `Scale_up | `Scale_down | `Projective ] list
  [@@deriving sexp]

  type get_crtc_transform_reply = {
    pending_transform : Render.transform;
    has_transforms : bool;
    current_transform : Render.transform;
    pending_filter_name : string;
    pending_params : Render.fixed list;
    current_filter_name : string;
    current_params : Render.fixed list;
  }
  [@@deriving sexp]

  let decode_get_crtc_transform_reply buf : get_crtc_transform_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let pending_transform = Render.decode_transform buf in
    let has_transforms = Decode.bool buf in
    Decode.pad buf 3;
    let current_transform = Render.decode_transform buf in
    Decode.pad buf 4;
    let pending_len = Decode.u16 buf in
    let pending_nparams = Decode.u16 buf in
    let current_len = Decode.u16 buf in
    let current_nparams = Decode.u16 buf in
    let pending_filter_name = Decode.string ~len:pending_len buf in
    Decode.align buf 4;
    let pending_params =
      (Decode.list ~item:Render.decode_fixed) ~len:pending_nparams buf
    in
    let current_filter_name = Decode.string ~len:current_len buf in
    Decode.align buf 4;
    let current_params =
      (Decode.list ~item:Render.decode_fixed) ~len:current_nparams buf
    in
    ignore length;
    {
      pending_transform;
      has_transforms;
      current_transform;
      pending_filter_name;
      pending_params;
      current_filter_name;
      current_params;
    }

  type get_panning_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
    left : u16;
    top : u16;
    width : u16;
    height : u16;
    track_left : u16;
    track_top : u16;
    track_width : u16;
    track_height : u16;
    border_left : i16;
    border_top : i16;
    border_right : i16;
    border_bottom : i16;
  }
  [@@deriving sexp]

  let decode_get_panning_reply buf : get_panning_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:set_config_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let left = Decode.u16 buf in
    let top = Decode.u16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let track_left = Decode.u16 buf in
    let track_top = Decode.u16 buf in
    let track_width = Decode.u16 buf in
    let track_height = Decode.u16 buf in
    let border_left = Decode.i16 buf in
    let border_top = Decode.i16 buf in
    let border_right = Decode.i16 buf in
    let border_bottom = Decode.i16 buf in
    ignore length;
    {
      status;
      timestamp;
      left;
      top;
      width;
      height;
      track_left;
      track_top;
      track_width;
      track_height;
      border_left;
      border_top;
      border_right;
      border_bottom;
    }

  type set_panning_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
  }
  [@@deriving sexp]

  let decode_set_panning_reply buf : set_panning_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:set_config_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    ignore length;
    { status; timestamp }

  type get_output_primary_reply = output [@@deriving sexp]

  let decode_get_output_primary_reply buf : get_output_primary_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let output = decode_output buf in
    ignore length;
    output

  type get_providers_reply = {
    timestamp : Xproto.timestamp;
    providers : provider list;
  }
  [@@deriving sexp]

  let decode_get_providers_reply buf : get_providers_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let num_providers = Decode.u16 buf in
    Decode.pad buf 18;
    let providers =
      (Decode.list ~item:decode_provider) ~len:num_providers buf
    in
    ignore length;
    { timestamp; providers }

  type provider_capability_mask =
    [ `Source_output | `Sink_output | `Source_offload | `Sink_offload ] list
  [@@deriving sexp]

  type get_provider_info_reply = {
    status : u8;
    timestamp : Xproto.timestamp;
    capabilities : provider_capability_mask;
    crtcs : crtc list;
    outputs : output list;
    associated_providers : provider list;
    associated_capability : u32 list;
    name : string;
  }
  [@@deriving sexp]

  let decode_get_provider_info_reply buf : get_provider_info_reply =
    Decode.pad buf 1;
    let status = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let capabilities =
      (Decode.mask Decode.u32 Int64.of_int provider_capability_mask_of_int64)
        buf
    in
    let num_crtcs = Decode.u16 buf in
    let num_outputs = Decode.u16 buf in
    let num_associated_providers = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    Decode.pad buf 8;
    let crtcs = (Decode.list ~item:decode_crtc) ~len:num_crtcs buf in
    let outputs = (Decode.list ~item:decode_output) ~len:num_outputs buf in
    let associated_providers =
      (Decode.list ~item:decode_provider) ~len:num_associated_providers buf
    in
    let associated_capability =
      (Decode.list ~item:Decode.u32) ~len:num_associated_providers buf
    in
    let name = Decode.string ~len:name_len buf in
    ignore length;
    {
      status;
      timestamp;
      capabilities;
      crtcs;
      outputs;
      associated_providers;
      associated_capability;
      name;
    }

  type list_provider_properties_reply = Xproto.atom list [@@deriving sexp]

  let decode_list_provider_properties_reply buf : list_provider_properties_reply
      =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_atoms = Decode.u16 buf in
    Decode.pad buf 22;
    let atoms = (Decode.list ~item:Xproto.decode_atom) ~len:num_atoms buf in
    ignore length;
    atoms

  type query_provider_property_reply = {
    pending : bool;
    range : bool;
    immutable : bool;
    valid_values : i32 list;
  }
  [@@deriving sexp]

  let decode_query_provider_property_reply buf : query_provider_property_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let pending = Decode.bool buf in
    let range = Decode.bool buf in
    let immutable = Decode.bool buf in
    Decode.pad buf 21;
    let valid_values = (Decode.list ~item:Decode.i32) ~len:length buf in
    ignore length;
    { pending; range; immutable; valid_values }

  type get_provider_property_reply = {
    format : u8;
    type_ : Xproto.atom;
    bytes_after : u32;
    num_items : u32;
    data : string;
  }
  [@@deriving sexp]

  let decode_get_provider_property_reply buf : get_provider_property_reply =
    Decode.pad buf 1;
    let format = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let type_ = Xproto.decode_atom buf in
    let bytes_after = Decode.u32 buf in
    let num_items = Decode.u32 buf in
    Decode.pad buf 12;
    let data = Decode.string ~len:(num_items * (format / 8)) buf in
    ignore length;
    { format; type_; bytes_after; num_items; data }

  type screen_change_notify_event = {
    rotation : rotation_mask;
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    root : Xproto.window;
    request_window : Xproto.window;
    size_id : u16;
    subpixel_order : Render.sub_pixel_enum;
    width : u16;
    height : u16;
    mwidth : u16;
    mheight : u16;
  }
  [@@deriving sexp]

  let decode_screen_change_notify_event buf : screen_change_notify_event =
    Decode.pad buf 1;
    let rotation =
      (Decode.mask Decode.u8 Int64.of_int rotation_mask_of_int64) buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let config_timestamp = Xproto.decode_timestamp buf in
    let root = Xproto.decode_window buf in
    let request_window = Xproto.decode_window buf in
    let size_id = Decode.u16 buf in
    let subpixel_order =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:Render.sub_pixel_enum_of_int)
        buf
    in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let mwidth = Decode.u16 buf in
    let mheight = Decode.u16 buf in
    ignore length;
    {
      rotation;
      timestamp;
      config_timestamp;
      root;
      request_window;
      size_id;
      subpixel_order;
      width;
      height;
      mwidth;
      mheight;
    }

  type notify_enum =
    [ `Crtc_change
    | `Output_change
    | `Output_property
    | `Provider_change
    | `Provider_property
    | `Resource_change
    | `Lease ]
  [@@deriving sexp]

  let notify_enum_of_int n : [ notify_enum | int custom ] =
    match n with
    | 0 -> `Crtc_change
    | 1 -> `Output_change
    | 2 -> `Output_property
    | 3 -> `Provider_change
    | 4 -> `Provider_property
    | 5 -> `Resource_change
    | 6 -> `Lease
    | _ -> `Custom n

  type crtc_change = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
    crtc : crtc;
    mode : mode;
    rotation : rotation_mask;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
  }
  [@@deriving sexp]

  let decode_crtc_change buf : crtc_change =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let crtc = decode_crtc buf in
    let mode = decode_mode buf in
    let rotation =
      (Decode.mask Decode.u16 Int64.of_int rotation_mask_of_int64) buf
    in
    Decode.pad buf 2;
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    { timestamp; window; crtc; mode; rotation; x; y; width; height }

  type output_change = {
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    window : Xproto.window;
    output : output;
    crtc : crtc;
    mode : mode;
    rotation : rotation_mask;
    connection : connection_enum;
    subpixel_order : Render.sub_pixel_enum;
  }
  [@@deriving sexp]

  let decode_output_change buf : output_change =
    let timestamp = Xproto.decode_timestamp buf in
    let config_timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let output = decode_output buf in
    let crtc = decode_crtc buf in
    let mode = decode_mode buf in
    let rotation =
      (Decode.mask Decode.u16 Int64.of_int rotation_mask_of_int64) buf
    in
    let connection =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:connection_enum_of_int)
        buf
    in
    let subpixel_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Render.sub_pixel_enum_of_int)
        buf
    in
    {
      timestamp;
      config_timestamp;
      window;
      output;
      crtc;
      mode;
      rotation;
      connection;
      subpixel_order;
    }

  type output_property = {
    window : Xproto.window;
    output : output;
    atom : Xproto.atom;
    timestamp : Xproto.timestamp;
    status : Xproto.property_enum;
  }
  [@@deriving sexp]

  let decode_output_property buf : output_property =
    let window = Xproto.decode_window buf in
    let output = decode_output buf in
    let atom = Xproto.decode_atom buf in
    let timestamp = Xproto.decode_timestamp buf in
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.property_enum_of_int)
        buf
    in
    Decode.pad buf 11;
    { window; output; atom; timestamp; status }

  type provider_change = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
    provider : provider;
  }
  [@@deriving sexp]

  let decode_provider_change buf : provider_change =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let provider = decode_provider buf in
    Decode.pad buf 16;
    { timestamp; window; provider }

  type provider_property = {
    window : Xproto.window;
    provider : provider;
    atom : Xproto.atom;
    timestamp : Xproto.timestamp;
    state : u8;
  }
  [@@deriving sexp]

  let decode_provider_property buf : provider_property =
    let window = Xproto.decode_window buf in
    let provider = decode_provider buf in
    let atom = Xproto.decode_atom buf in
    let timestamp = Xproto.decode_timestamp buf in
    let state = Decode.u8 buf in
    Decode.pad buf 11;
    { window; provider; atom; timestamp; state }

  type resource_change = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
  }
  [@@deriving sexp]

  let decode_resource_change buf : resource_change =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    Decode.pad buf 20;
    { timestamp; window }

  type monitor_info = {
    name : Xproto.atom;
    primary : bool;
    automatic : bool;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    width_in_millimeters : u32;
    height_in_millimeters : u32;
    outputs : output list;
  }
  [@@deriving sexp]

  let decode_monitor_info buf : monitor_info =
    let name = Xproto.decode_atom buf in
    let primary = Decode.bool buf in
    let automatic = Decode.bool buf in
    let n_output = Decode.u16 buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let width_in_millimeters = Decode.u32 buf in
    let height_in_millimeters = Decode.u32 buf in
    let outputs = (Decode.list ~item:decode_output) ~len:n_output buf in
    {
      name;
      primary;
      automatic;
      x;
      y;
      width;
      height;
      width_in_millimeters;
      height_in_millimeters;
      outputs;
    }

  type get_monitors_reply = {
    timestamp : Xproto.timestamp;
    n_outputs : u32;
    monitors : monitor_info list;
  }
  [@@deriving sexp]

  let decode_get_monitors_reply buf : get_monitors_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let n_monitors = Decode.u32 buf in
    let n_outputs = Decode.u32 buf in
    Decode.pad buf 12;
    let monitors =
      (Decode.list ~item:decode_monitor_info) ~len:n_monitors buf
    in
    ignore length;
    { timestamp; n_outputs; monitors }

  type create_lease_reply = { nfd : u8; master_fd : file_descr }
  [@@deriving sexp]

  let decode_create_lease_reply buf : create_lease_reply =
    Decode.pad buf 1;
    let nfd = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let master_fd = Decode.file_descr buf in
    Decode.pad buf 24;
    ignore length;
    { nfd; master_fd }

  type lease_notify = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
    lease : lease;
    created : u8;
  }
  [@@deriving sexp]

  let decode_lease_notify buf : lease_notify =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let lease = decode_lease buf in
    let created = Decode.u8 buf in
    Decode.pad buf 15;
    { timestamp; window; lease; created }

  type notify_variant =
    | Crtc_change of crtc_change
    | Output_change of output_change
    | Output_property of output_property
    | Provider_change of provider_change
    | Provider_property of provider_property
    | Resource_change of resource_change
    | Lease of lease_notify
  [@@deriving sexp]

  let decode_notify_variant buf ~tag : notify_variant =
    match tag with
    | 0 ->
        let cc = decode_crtc_change buf in
        Crtc_change cc
    | 1 ->
        let oc = decode_output_change buf in
        Output_change oc
    | 2 ->
        let op = decode_output_property buf in
        Output_property op
    | 3 ->
        let pc = decode_provider_change buf in
        Provider_change pc
    | 4 ->
        let pp = decode_provider_property buf in
        Provider_property pp
    | 5 ->
        let rc = decode_resource_change buf in
        Resource_change rc
    | 6 ->
        let lc = decode_lease_notify buf in
        Lease lc

  type notify_event = notify_variant [@@deriving sexp]

  let decode_notify_event buf : notify_event =
    Decode.pad buf 1;
    let u_tag = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let u = decode_notify_variant ~tag:u_tag buf in
    ignore length;
    u
end

module Sync = struct
  type alarm = xid [@@deriving sexp]

  let decode_alarm = Decode.xid

  type alarmstate_enum = [ `Active | `Inactive | `Destroyed ] [@@deriving sexp]

  let alarmstate_enum_of_int n : [ alarmstate_enum | int custom ] =
    match n with
    | 0 -> `Active
    | 1 -> `Inactive
    | 2 -> `Destroyed
    | _ -> `Custom n

  type counter = xid [@@deriving sexp]

  let decode_counter = Decode.xid

  type fence = xid [@@deriving sexp]

  let decode_fence = Decode.xid

  type testtype_enum =
    [ `Positive_transition
    | `Negative_transition
    | `Positive_comparison
    | `Negative_comparison ]
  [@@deriving sexp]

  let testtype_enum_of_int n : [ testtype_enum | int custom ] =
    match n with
    | 0 -> `Positive_transition
    | 1 -> `Negative_transition
    | 2 -> `Positive_comparison
    | 3 -> `Negative_comparison
    | _ -> `Custom n

  type valuetype_enum = [ `Absolute | `Relative ] [@@deriving sexp]

  let valuetype_enum_of_int n : [ valuetype_enum | int custom ] =
    match n with 0 -> `Absolute | 1 -> `Relative | _ -> `Custom n

  type ca_mask =
    [ `Counter | `Value_type | `Value | `Test_type | `Delta | `Events ] list
  [@@deriving sexp]

  type int64 = { hi : i32; lo : u32 } [@@deriving sexp]

  let decode_int64 buf : int64 =
    let hi = Decode.i32 buf in
    let lo = Decode.u32 buf in
    { hi; lo }

  type systemcounter = { counter : counter; resolution : int64; name : string }
  [@@deriving sexp]

  let decode_systemcounter buf : systemcounter =
    let counter = decode_counter buf in
    let resolution = decode_int64 buf in
    let name_len = Decode.u16 buf in
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    { counter; resolution; name }

  type trigger = {
    counter : counter;
    wait_type : valuetype_enum;
    wait_value : int64;
    test_type : testtype_enum;
  }
  [@@deriving sexp]

  let decode_trigger buf : trigger =
    let counter = decode_counter buf in
    let wait_type =
      (Decode.enum ~decode:Decode.u32 ~int_of_t:identity
         ~enum_of_int:valuetype_enum_of_int)
        buf
    in
    let wait_value = decode_int64 buf in
    let test_type =
      (Decode.enum ~decode:Decode.u32 ~int_of_t:identity
         ~enum_of_int:testtype_enum_of_int)
        buf
    in
    { counter; wait_type; wait_value; test_type }

  type waitcondition = { trigger : trigger; event_threshold : int64 }
  [@@deriving sexp]

  let decode_waitcondition buf : waitcondition =
    let trigger = decode_trigger buf in
    let event_threshold = decode_int64 buf in
    { trigger; event_threshold }

  type counter_error = u32 [@@deriving sexp]

  let decode_counter_error buf : counter_error =
    Decode.pad buf 4;
    let bad_counter = Decode.u32 buf in
    Decode.pad buf 3;
    Decode.align buf 32;
    bad_counter

  type alarm_error = u32 [@@deriving sexp]

  let decode_alarm_error buf : alarm_error =
    Decode.pad buf 4;
    let bad_alarm = Decode.u32 buf in
    Decode.pad buf 3;
    Decode.align buf 32;
    bad_alarm

  type initialize_reply = { major_version : u8; minor_version : u8 }
  [@@deriving sexp]

  let decode_initialize_reply buf : initialize_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u8 buf in
    let minor_version = Decode.u8 buf in
    Decode.pad buf 22;
    ignore length;
    { major_version; minor_version }

  type list_system_counters_reply = systemcounter list [@@deriving sexp]

  let decode_list_system_counters_reply buf : list_system_counters_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let counters_len = Decode.u32 buf in
    Decode.pad buf 20;
    let counters =
      (Decode.list ~item:decode_systemcounter) ~len:counters_len buf
    in
    ignore length;
    counters

  type query_counter_reply = int64 [@@deriving sexp]

  let decode_query_counter_reply buf : query_counter_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let counter_value = decode_int64 buf in
    ignore length;
    counter_value

  type query_alarm_reply = {
    trigger : trigger;
    delta : int64;
    events : bool;
    state : alarmstate_enum;
  }
  [@@deriving sexp]

  let decode_query_alarm_reply buf : query_alarm_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let trigger = decode_trigger buf in
    let delta = decode_int64 buf in
    let events = Decode.bool buf in
    let state =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:alarmstate_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    ignore length;
    { trigger; delta; events; state }

  type get_priority_reply = i32 [@@deriving sexp]

  let decode_get_priority_reply buf : get_priority_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let priority = Decode.i32 buf in
    ignore length;
    priority

  type query_fence_reply = bool [@@deriving sexp]

  let decode_query_fence_reply buf : query_fence_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let triggered = Decode.bool buf in
    Decode.pad buf 23;
    ignore length;
    triggered

  type counter_notify_event = {
    kind : u8;
    counter : counter;
    wait_value : int64;
    counter_value : int64;
    timestamp : Xproto.timestamp;
    count : u16;
    destroyed : bool;
  }
  [@@deriving sexp]

  let decode_counter_notify_event buf : counter_notify_event =
    Decode.pad buf 1;
    let kind = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let counter = decode_counter buf in
    let wait_value = decode_int64 buf in
    let counter_value = decode_int64 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let count = Decode.u16 buf in
    let destroyed = Decode.bool buf in
    Decode.pad buf 1;
    ignore length;
    { kind; counter; wait_value; counter_value; timestamp; count; destroyed }

  type alarm_notify_event = {
    kind : u8;
    alarm : alarm;
    counter_value : int64;
    alarm_value : int64;
    timestamp : Xproto.timestamp;
    state : alarmstate_enum;
  }
  [@@deriving sexp]

  let decode_alarm_notify_event buf : alarm_notify_event =
    Decode.pad buf 1;
    let kind = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let alarm = decode_alarm buf in
    let counter_value = decode_int64 buf in
    let alarm_value = decode_int64 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let state =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:alarmstate_enum_of_int)
        buf
    in
    Decode.pad buf 3;
    ignore length;
    { kind; alarm; counter_value; alarm_value; timestamp; state }
end

module Present = struct
  type event_enum =
    [ `Configure_notify | `Complete_notify | `Idle_notify | `Redirect_notify ]
  [@@deriving sexp]

  let event_enum_of_int n : [ event_enum | int custom ] =
    match n with
    | 0 -> `Configure_notify
    | 1 -> `Complete_notify
    | 2 -> `Idle_notify
    | 3 -> `Redirect_notify
    | _ -> `Custom n

  type event_mask =
    [ `Configure_notify | `Complete_notify | `Idle_notify | `Redirect_notify ]
    list
  [@@deriving sexp]

  type option_mask = [ `Async | `Copy | `Ust | `Suboptimal ] list
  [@@deriving sexp]

  type capability_mask = [ `Async | `Fence | `Ust ] list [@@deriving sexp]
  type complete_kind_enum = [ `Pixmap | `Notify_msc ] [@@deriving sexp]

  let complete_kind_enum_of_int n : [ complete_kind_enum | int custom ] =
    match n with 0 -> `Pixmap | 1 -> `Notify_msc | _ -> `Custom n

  type complete_mode_enum = [ `Copy | `Flip | `Skip | `Suboptimal_copy ]
  [@@deriving sexp]

  let complete_mode_enum_of_int n : [ complete_mode_enum | int custom ] =
    match n with
    | 0 -> `Copy
    | 1 -> `Flip
    | 2 -> `Skip
    | 3 -> `Suboptimal_copy
    | _ -> `Custom n

  type notify = { window : Xproto.window; serial : u32 } [@@deriving sexp]

  let decode_notify buf : notify =
    let window = Xproto.decode_window buf in
    let serial = Decode.u32 buf in
    { window; serial }

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    ignore length;
    { major_version; minor_version }

  type event = xid [@@deriving sexp]

  let decode_event = Decode.xid

  type query_capabilities_reply = u32 [@@deriving sexp]

  let decode_query_capabilities_reply buf : query_capabilities_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let capabilities = Decode.u32 buf in
    ignore length;
    capabilities

  type generic_event = {
    extension : u8;
    length : u32;
    evtype : u16;
    event : event;
  }
  [@@deriving sexp]

  let decode_generic_event buf : generic_event =
    Decode.pad buf 1;
    let extension = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let length = Decode.u32 buf in
    let evtype = Decode.u16 buf in
    Decode.pad buf 2;
    let event = decode_event buf in
    ignore length;
    { extension; length; evtype; event }

  type configure_notify_event = {
    event : event;
    window : Xproto.window;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    off_x : i16;
    off_y : i16;
    pixmap_width : u16;
    pixmap_height : u16;
    pixmap_flags : u32;
  }
  [@@deriving sexp]

  let decode_configure_notify_event buf : configure_notify_event =
    Decode.pad buf 5;
    let length = Decode.u32 buf in
    let event = decode_event buf in
    let window = Xproto.decode_window buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let off_x = Decode.i16 buf in
    let off_y = Decode.i16 buf in
    let pixmap_width = Decode.u16 buf in
    let pixmap_height = Decode.u16 buf in
    let pixmap_flags = Decode.u32 buf in
    ignore length;
    {
      event;
      window;
      x;
      y;
      width;
      height;
      off_x;
      off_y;
      pixmap_width;
      pixmap_height;
      pixmap_flags;
    }

  type complete_notify_event = {
    kind : complete_kind_enum;
    mode : complete_mode_enum;
    event : event;
    window : Xproto.window;
    serial : u32;
    ust : u64;
    msc : u64;
  }
  [@@deriving sexp]

  let decode_complete_notify_event buf : complete_notify_event =
    Decode.pad buf 1;
    let kind =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:complete_kind_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let mode =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:complete_mode_enum_of_int)
        buf
    in
    let event = decode_event buf in
    let window = Xproto.decode_window buf in
    let serial = Decode.u32 buf in
    let ust = Decode.u64 buf in
    let msc = Decode.u64 buf in
    ignore length;
    { kind; mode; event; window; serial; ust; msc }

  type idle_notify_event = {
    event : event;
    window : Xproto.window;
    serial : u32;
    pixmap : Xproto.pixmap;
    idle_fence : Sync.fence;
  }
  [@@deriving sexp]

  let decode_idle_notify_event buf : idle_notify_event =
    Decode.pad buf 5;
    let length = Decode.u32 buf in
    let event = decode_event buf in
    let window = Xproto.decode_window buf in
    let serial = Decode.u32 buf in
    let pixmap = Xproto.decode_pixmap buf in
    let idle_fence = Sync.decode_fence buf in
    ignore length;
    { event; window; serial; pixmap; idle_fence }

  type redirect_notify_event = {
    update_window : bool;
    event : event;
    event_window : Xproto.window;
    window : Xproto.window;
    pixmap : Xproto.pixmap;
    serial : u32;
    valid_region : Xfixes.region;
    update_region : Xfixes.region;
    valid_rect : Xproto.rectangle;
    update_rect : Xproto.rectangle;
    x_off : i16;
    y_off : i16;
    target_crtc : Randr.crtc;
    wait_fence : Sync.fence;
    idle_fence : Sync.fence;
    options : u32;
    target_msc : u64;
    divisor : u64;
    remainder : u64;
    notifies : notify list;
  }
  [@@deriving sexp]
end

module Record = struct
  type context = xid [@@deriving sexp]

  let decode_context = Decode.xid

  type range8 = { first : u8; last : u8 } [@@deriving sexp]

  let decode_range8 buf : range8 =
    let first = Decode.u8 buf in
    let last = Decode.u8 buf in
    { first; last }

  type range16 = { first : u16; last : u16 } [@@deriving sexp]

  let decode_range16 buf : range16 =
    let first = Decode.u16 buf in
    let last = Decode.u16 buf in
    { first; last }

  type ext_range = { major : range8; minor : range16 } [@@deriving sexp]

  let decode_ext_range buf : ext_range =
    let major = decode_range8 buf in
    let minor = decode_range16 buf in
    { major; minor }

  type range = {
    core_requests : range8;
    core_replies : range8;
    ext_requests : ext_range;
    ext_replies : ext_range;
    delivered_events : range8;
    device_events : range8;
    errors : range8;
    client_started : bool;
    client_died : bool;
  }
  [@@deriving sexp]

  let decode_range buf : range =
    let core_requests = decode_range8 buf in
    let core_replies = decode_range8 buf in
    let ext_requests = decode_ext_range buf in
    let ext_replies = decode_ext_range buf in
    let delivered_events = decode_range8 buf in
    let device_events = decode_range8 buf in
    let errors = decode_range8 buf in
    let client_started = Decode.bool buf in
    let client_died = Decode.bool buf in
    {
      core_requests;
      core_replies;
      ext_requests;
      ext_replies;
      delivered_events;
      device_events;
      errors;
      client_started;
      client_died;
    }

  type element_header = u8 [@@deriving sexp]

  let decode_element_header = Decode.u8

  type h_type_mask =
    [ `From_server_time | `From_client_time | `From_client_sequence ] list
  [@@deriving sexp]

  type client_spec = u32 [@@deriving sexp]

  let decode_client_spec = Decode.u32

  type cs_enum = [ `Current_clients | `Future_clients | `All_clients ]
  [@@deriving sexp]

  let cs_enum_of_int n : [ cs_enum | int custom ] =
    match n with
    | 1 -> `Current_clients
    | 2 -> `Future_clients
    | 3 -> `All_clients
    | _ -> `Custom n

  type client_info = { client_resource : client_spec; ranges : range list }
  [@@deriving sexp]

  let decode_client_info buf : client_info =
    let client_resource = decode_client_spec buf in
    let num_ranges = Decode.u32 buf in
    let ranges = (Decode.list ~item:decode_range) ~len:num_ranges buf in
    { client_resource; ranges }

  type bad_context_error = u32 [@@deriving sexp]

  let decode_bad_context_error buf : bad_context_error =
    Decode.pad buf 4;
    let invalid_record = Decode.u32 buf in
    Decode.align buf 32;
    invalid_record

  type query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u16 buf in
    let minor_version = Decode.u16 buf in
    ignore length;
    { major_version; minor_version }

  type get_context_reply = {
    enabled : bool;
    element_header : element_header;
    intercepted_clients : client_info list;
  }
  [@@deriving sexp]

  let decode_get_context_reply buf : get_context_reply =
    Decode.pad buf 1;
    let enabled = Decode.bool buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let element_header = decode_element_header buf in
    Decode.pad buf 3;
    let num_intercepted_clients = Decode.u32 buf in
    Decode.pad buf 16;
    let intercepted_clients =
      (Decode.list ~item:decode_client_info) ~len:num_intercepted_clients buf
    in
    ignore length;
    { enabled; element_header; intercepted_clients }

  type enable_context_reply = {
    category : u8;
    element_header : element_header;
    client_swapped : bool;
    xid_base : u32;
    server_time : u32;
    rec_sequence_num : u32;
    data : byte list;
  }
  [@@deriving sexp]

  let decode_enable_context_reply buf : enable_context_reply =
    Decode.pad buf 1;
    let category = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let element_header = decode_element_header buf in
    let client_swapped = Decode.bool buf in
    Decode.pad buf 2;
    let xid_base = Decode.u32 buf in
    let server_time = Decode.u32 buf in
    let rec_sequence_num = Decode.u32 buf in
    Decode.pad buf 8;
    let data = (Decode.list ~item:Decode.byte) ~len:(length * 4) buf in
    ignore length;
    {
      category;
      element_header;
      client_swapped;
      xid_base;
      server_time;
      rec_sequence_num;
      data;
    }
end

module Res = struct
  type client = { resource_base : u32; resource_mask : u32 } [@@deriving sexp]

  let decode_client buf : client =
    let resource_base = Decode.u32 buf in
    let resource_mask = Decode.u32 buf in
    { resource_base; resource_mask }

  type type_ = { resource_type : Xproto.atom; count : u32 } [@@deriving sexp]

  let decode_type buf : type_ =
    let resource_type = Xproto.decode_atom buf in
    let count = Decode.u32 buf in
    { resource_type; count }

  type client_id_mask = [ `Client_xid | `Local_client_pid ] list
  [@@deriving sexp]

  type client_id_spec = { client : u32; mask : client_id_mask }
  [@@deriving sexp]

  let decode_client_id_spec buf : client_id_spec =
    let client = Decode.u32 buf in
    let mask =
      (Decode.mask Decode.u32 Int64.of_int client_id_mask_mask_of_int64) buf
    in
    { client; mask }

  type client_id_value = { spec : client_id_spec; value : u32 list }
  [@@deriving sexp]

  let decode_client_id_value buf : client_id_value =
    let spec = decode_client_id_spec buf in
    let length = Decode.u32 buf in
    let length = length * 4 in
    let value = (Decode.list ~item:Decode.u32) ~len:length buf in
    { spec; value }

  type resource_id_spec = { resource : u32; type_ : u32 } [@@deriving sexp]

  let decode_resource_id_spec buf : resource_id_spec =
    let resource = Decode.u32 buf in
    let type_ = Decode.u32 buf in
    { resource; type_ }

  type resource_size_spec = {
    spec : resource_id_spec;
    bytes : u32;
    ref_count : u32;
    use_count : u32;
  }
  [@@deriving sexp]

  let decode_resource_size_spec buf : resource_size_spec =
    let spec = decode_resource_id_spec buf in
    let bytes = Decode.u32 buf in
    let ref_count = Decode.u32 buf in
    let use_count = Decode.u32 buf in
    { spec; bytes; ref_count; use_count }

  type resource_size_value = {
    size : resource_size_spec;
    cross_references : resource_size_spec list;
  }
  [@@deriving sexp]

  let decode_resource_size_value buf : resource_size_value =
    let size = decode_resource_size_spec buf in
    let num_cross_references = Decode.u32 buf in
    let cross_references =
      (Decode.list ~item:decode_resource_size_spec)
        ~len:num_cross_references buf
    in
    { size; cross_references }

  type query_version_reply = { server_major : u16; server_minor : u16 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let server_major = Decode.u16 buf in
    let server_minor = Decode.u16 buf in
    ignore length;
    { server_major; server_minor }

  type query_clients_reply = client list [@@deriving sexp]

  let decode_query_clients_reply buf : query_clients_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_clients = Decode.u32 buf in
    Decode.pad buf 20;
    let clients = (Decode.list ~item:decode_client) ~len:num_clients buf in
    ignore length;
    clients

  type query_client_resources_reply = type_ list [@@deriving sexp]

  let decode_query_client_resources_reply buf : query_client_resources_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_types = Decode.u32 buf in
    Decode.pad buf 20;
    let types = (Decode.list ~item:decode_type) ~len:num_types buf in
    ignore length;
    types

  type query_client_pixmap_bytes_reply = { bytes : u32; bytes_overflow : u32 }
  [@@deriving sexp]

  let decode_query_client_pixmap_bytes_reply buf :
      query_client_pixmap_bytes_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let bytes = Decode.u32 buf in
    let bytes_overflow = Decode.u32 buf in
    ignore length;
    { bytes; bytes_overflow }

  type query_client_ids_reply = client_id_value list [@@deriving sexp]

  let decode_query_client_ids_reply buf : query_client_ids_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_ids = Decode.u32 buf in
    Decode.pad buf 20;
    let ids = (Decode.list ~item:decode_client_id_value) ~len:num_ids buf in
    ignore length;
    ids

  type query_resource_bytes_reply = resource_size_value list [@@deriving sexp]

  let decode_query_resource_bytes_reply buf : query_resource_bytes_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_sizes = Decode.u32 buf in
    Decode.pad buf 20;
    let sizes =
      (Decode.list ~item:decode_resource_size_value) ~len:num_sizes buf
    in
    ignore length;
    sizes
end

module Screensaver = struct
  type kind_enum = [ `Blanked | `Internal | `External ] [@@deriving sexp]

  let kind_enum_of_int n : [ kind_enum | int custom ] =
    match n with
    | 0 -> `Blanked
    | 1 -> `Internal
    | 2 -> `External
    | _ -> `Custom n

  type event_mask = [ `Notify_mask | `Cycle_mask ] list [@@deriving sexp]
  type state_enum = [ `Off | `On | `Cycle | `Disabled ] [@@deriving sexp]

  let state_enum_of_int n : [ state_enum | int custom ] =
    match n with
    | 0 -> `Off
    | 1 -> `On
    | 2 -> `Cycle
    | 3 -> `Disabled
    | _ -> `Custom n

  type query_version_reply = {
    server_major_version : u16;
    server_minor_version : u16;
  }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let server_major_version = Decode.u16 buf in
    let server_minor_version = Decode.u16 buf in
    Decode.pad buf 20;
    ignore length;
    { server_major_version; server_minor_version }

  type query_info_reply = {
    state : u8;
    saver_window : Xproto.window;
    ms_until_server : u32;
    ms_since_user_input : u32;
    event_mask : u32;
    kind : kind_enum;
  }
  [@@deriving sexp]

  let decode_query_info_reply buf : query_info_reply =
    Decode.pad buf 1;
    let state = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let saver_window = Xproto.decode_window buf in
    let ms_until_server = Decode.u32 buf in
    let ms_since_user_input = Decode.u32 buf in
    let event_mask = Decode.u32 buf in
    let kind =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:kind_enum_of_int)
        buf
    in
    Decode.pad buf 7;
    ignore length;
    {
      state;
      saver_window;
      ms_until_server;
      ms_since_user_input;
      event_mask;
      kind;
    }

  type notify_event = {
    state : state_enum;
    time : Xproto.timestamp;
    root : Xproto.window;
    window : Xproto.window;
    kind : kind_enum;
    forced : bool;
  }
  [@@deriving sexp]

  let decode_notify_event buf : notify_event =
    Decode.pad buf 1;
    let state =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:state_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let time = Xproto.decode_timestamp buf in
    let root = Xproto.decode_window buf in
    let window = Xproto.decode_window buf in
    let kind =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:kind_enum_of_int)
        buf
    in
    let forced = Decode.bool buf in
    Decode.pad buf 14;
    ignore length;
    { state; time; root; window; kind; forced }
end

module Shm = struct
  type seg = xid [@@deriving sexp]

  let decode_seg = Decode.xid

  type completion_event = {
    drawable : Xproto.drawable;
    minor_event : u16;
    major_event : byte;
    shmseg : seg;
    offset : u32;
  }
  [@@deriving sexp]

  let decode_completion_event buf : completion_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let drawable = Xproto.decode_drawable buf in
    let minor_event = Decode.u16 buf in
    let major_event = Decode.byte buf in
    Decode.pad buf 1;
    let shmseg = decode_seg buf in
    let offset = Decode.u32 buf in
    ignore length;
    { drawable; minor_event; major_event; shmseg; offset }

  type bad_seg_error = Xproto.value_error [@@deriving sexp]

  let decode_bad_seg_error = Xproto.decode_value_error

  type query_version_reply = {
    shared_pixmaps : bool;
    major_version : u16;
    minor_version : u16;
    uid : u16;
    gid : u16;
    pixmap_format : u8;
  }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 1;
    let shared_pixmaps = Decode.bool buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let major_version = Decode.u16 buf in
    let minor_version = Decode.u16 buf in
    let uid = Decode.u16 buf in
    let gid = Decode.u16 buf in
    let pixmap_format = Decode.u8 buf in
    Decode.pad buf 15;
    ignore length;
    { shared_pixmaps; major_version; minor_version; uid; gid; pixmap_format }

  type get_image_reply = { depth : u8; visual : Xproto.visualid; size : u32 }
  [@@deriving sexp]

  let decode_get_image_reply buf : get_image_reply =
    Decode.pad buf 1;
    let depth = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let visual = Xproto.decode_visualid buf in
    let size = Decode.u32 buf in
    ignore length;
    { depth; visual; size }

  type create_segment_reply = { nfd : u8; shm_fd : file_descr }
  [@@deriving sexp]

  let decode_create_segment_reply buf : create_segment_reply =
    Decode.pad buf 1;
    let nfd = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let shm_fd = Decode.file_descr buf in
    Decode.pad buf 24;
    ignore length;
    { nfd; shm_fd }
end

module Xc_misc = struct
  type get_version_reply = {
    server_major_version : u16;
    server_minor_version : u16;
  }
  [@@deriving sexp]

  let decode_get_version_reply buf : get_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let server_major_version = Decode.u16 buf in
    let server_minor_version = Decode.u16 buf in
    ignore length;
    { server_major_version; server_minor_version }

  type get_xid_range_reply = { start_id : u32; count : u32 } [@@deriving sexp]

  let decode_get_xid_range_reply buf : get_xid_range_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let start_id = Decode.u32 buf in
    let count = Decode.u32 buf in
    ignore length;
    { start_id; count }

  type get_xid_list_reply = u32 list [@@deriving sexp]

  let decode_get_xid_list_reply buf : get_xid_list_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let ids_len = Decode.u32 buf in
    Decode.pad buf 20;
    let ids = (Decode.list ~item:Decode.u32) ~len:ids_len buf in
    ignore length;
    ids
end

module Xf86dri = struct
  type drm_clip_rect = { x1 : i16; y1 : i16; x2 : i16; x3 : i16 }
  [@@deriving sexp]

  let decode_drm_clip_rect buf : drm_clip_rect =
    let x1 = Decode.i16 buf in
    let y1 = Decode.i16 buf in
    let x2 = Decode.i16 buf in
    let x3 = Decode.i16 buf in
    { x1; y1; x2; x3 }

  type query_version_reply = {
    dri_major_version : u16;
    dri_minor_version : u16;
    dri_minor_patch : u32;
  }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let dri_major_version = Decode.u16 buf in
    let dri_minor_version = Decode.u16 buf in
    let dri_minor_patch = Decode.u32 buf in
    ignore length;
    { dri_major_version; dri_minor_version; dri_minor_patch }

  type query_direct_rendering_capable_reply = bool [@@deriving sexp]

  let decode_query_direct_rendering_capable_reply buf :
      query_direct_rendering_capable_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let is_capable = Decode.bool buf in
    ignore length;
    is_capable

  type open_connection_reply = {
    sarea_handle_low : u32;
    sarea_handle_high : u32;
    bus_id : string;
  }
  [@@deriving sexp]

  let decode_open_connection_reply buf : open_connection_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let sarea_handle_low = Decode.u32 buf in
    let sarea_handle_high = Decode.u32 buf in
    let bus_id_len = Decode.u32 buf in
    Decode.pad buf 12;
    let bus_id = Decode.string ~len:bus_id_len buf in
    ignore length;
    { sarea_handle_low; sarea_handle_high; bus_id }

  type get_client_driver_name_reply = {
    client_driver_major_version : u32;
    client_driver_minor_version : u32;
    client_driver_patch_version : u32;
    client_driver_name : string;
  }
  [@@deriving sexp]

  let decode_get_client_driver_name_reply buf : get_client_driver_name_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let client_driver_major_version = Decode.u32 buf in
    let client_driver_minor_version = Decode.u32 buf in
    let client_driver_patch_version = Decode.u32 buf in
    let client_driver_name_len = Decode.u32 buf in
    Decode.pad buf 8;
    let client_driver_name = Decode.string ~len:client_driver_name_len buf in
    ignore length;
    {
      client_driver_major_version;
      client_driver_minor_version;
      client_driver_patch_version;
      client_driver_name;
    }

  type create_context_reply = u32 [@@deriving sexp]

  let decode_create_context_reply buf : create_context_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let hw_context = Decode.u32 buf in
    ignore length;
    hw_context

  type create_drawable_reply = u32 [@@deriving sexp]

  let decode_create_drawable_reply buf : create_drawable_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let hw_drawable_handle = Decode.u32 buf in
    ignore length;
    hw_drawable_handle

  type get_drawable_info_reply = {
    drawable_table_index : u32;
    drawable_table_stamp : u32;
    drawable_origin_x : i16;
    drawable_origin_y : i16;
    drawable_size_w : i16;
    drawable_size_h : i16;
    back_x : i16;
    back_y : i16;
    clip_rects : drm_clip_rect list;
    back_clip_rects : drm_clip_rect list;
  }
  [@@deriving sexp]

  let decode_get_drawable_info_reply buf : get_drawable_info_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let drawable_table_index = Decode.u32 buf in
    let drawable_table_stamp = Decode.u32 buf in
    let drawable_origin_x = Decode.i16 buf in
    let drawable_origin_y = Decode.i16 buf in
    let drawable_size_w = Decode.i16 buf in
    let drawable_size_h = Decode.i16 buf in
    let num_clip_rects = Decode.u32 buf in
    let back_x = Decode.i16 buf in
    let back_y = Decode.i16 buf in
    let num_back_clip_rects = Decode.u32 buf in
    let clip_rects =
      (Decode.list ~item:decode_drm_clip_rect) ~len:num_clip_rects buf
    in
    let back_clip_rects =
      (Decode.list ~item:decode_drm_clip_rect) ~len:num_back_clip_rects buf
    in
    ignore length;
    {
      drawable_table_index;
      drawable_table_stamp;
      drawable_origin_x;
      drawable_origin_y;
      drawable_size_w;
      drawable_size_h;
      back_x;
      back_y;
      clip_rects;
      back_clip_rects;
    }

  type get_device_info_reply = {
    framebuffer_handle_low : u32;
    framebuffer_handle_high : u32;
    framebuffer_origin_offset : u32;
    framebuffer_size : u32;
    framebuffer_stride : u32;
    device_private : u32 list;
  }
  [@@deriving sexp]

  let decode_get_device_info_reply buf : get_device_info_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let framebuffer_handle_low = Decode.u32 buf in
    let framebuffer_handle_high = Decode.u32 buf in
    let framebuffer_origin_offset = Decode.u32 buf in
    let framebuffer_size = Decode.u32 buf in
    let framebuffer_stride = Decode.u32 buf in
    let device_private_size = Decode.u32 buf in
    let device_private =
      (Decode.list ~item:Decode.u32) ~len:device_private_size buf
    in
    ignore length;
    {
      framebuffer_handle_low;
      framebuffer_handle_high;
      framebuffer_origin_offset;
      framebuffer_size;
      framebuffer_stride;
      device_private;
    }

  type auth_connection_reply = u32 [@@deriving sexp]

  let decode_auth_connection_reply buf : auth_connection_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let authenticated = Decode.u32 buf in
    ignore length;
    authenticated
end

module Xf86vidmode = struct
  type syncrange = u32 [@@deriving sexp]

  let decode_syncrange = Decode.u32

  type dotclock = u32 [@@deriving sexp]

  let decode_dotclock = Decode.u32

  type mode_flag_mask =
    [ `Positive_h_sync
    | `Negative_h_sync
    | `Positive_v_sync
    | `Negative_v_sync
    | `Interlace
    | `Composite_sync
    | `Positive_c_sync
    | `Negative_c_sync
    | `H_skew
    | `Broadcast
    | `Pixmux
    | `Double_clock
    | `Half_clock ]
    list
  [@@deriving sexp]

  type clock_flag_mask = [ `Programable ] list [@@deriving sexp]
  type permission_mask = [ `Read | `Write ] list [@@deriving sexp]

  type mode_info = {
    dotclock : dotclock;
    hdisplay : u16;
    hsyncstart : u16;
    hsyncend : u16;
    htotal : u16;
    hskew : u32;
    vdisplay : u16;
    vsyncstart : u16;
    vsyncend : u16;
    vtotal : u16;
    flags : mode_flag_mask;
    privsize : u32;
  }
  [@@deriving sexp]

  let decode_mode_info buf : mode_info =
    let dotclock = decode_dotclock buf in
    let hdisplay = Decode.u16 buf in
    let hsyncstart = Decode.u16 buf in
    let hsyncend = Decode.u16 buf in
    let htotal = Decode.u16 buf in
    let hskew = Decode.u32 buf in
    let vdisplay = Decode.u16 buf in
    let vsyncstart = Decode.u16 buf in
    let vsyncend = Decode.u16 buf in
    let vtotal = Decode.u16 buf in
    Decode.pad buf 4;
    let flags =
      (Decode.mask Decode.u32 Int64.of_int mode_flag_mask_of_int64) buf
    in
    Decode.pad buf 12;
    let privsize = Decode.u32 buf in
    {
      dotclock;
      hdisplay;
      hsyncstart;
      hsyncend;
      htotal;
      hskew;
      vdisplay;
      vsyncstart;
      vsyncend;
      vtotal;
      flags;
      privsize;
    }

  type query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u16 buf in
    let minor_version = Decode.u16 buf in
    ignore length;
    { major_version; minor_version }

  type get_mode_line_reply = {
    dotclock : dotclock;
    hdisplay : u16;
    hsyncstart : u16;
    hsyncend : u16;
    htotal : u16;
    hskew : u16;
    vdisplay : u16;
    vsyncstart : u16;
    vsyncend : u16;
    vtotal : u16;
    flags : mode_flag_mask;
    private_ : u8 list;
  }
  [@@deriving sexp]

  let decode_get_mode_line_reply buf : get_mode_line_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let dotclock = decode_dotclock buf in
    let hdisplay = Decode.u16 buf in
    let hsyncstart = Decode.u16 buf in
    let hsyncend = Decode.u16 buf in
    let htotal = Decode.u16 buf in
    let hskew = Decode.u16 buf in
    let vdisplay = Decode.u16 buf in
    let vsyncstart = Decode.u16 buf in
    let vsyncend = Decode.u16 buf in
    let vtotal = Decode.u16 buf in
    Decode.pad buf 2;
    let flags =
      (Decode.mask Decode.u32 Int64.of_int mode_flag_mask_of_int64) buf
    in
    Decode.pad buf 12;
    let privsize = Decode.u32 buf in
    let private_ = (Decode.list ~item:Decode.u8) ~len:privsize buf in
    ignore length;
    {
      dotclock;
      hdisplay;
      hsyncstart;
      hsyncend;
      htotal;
      hskew;
      vdisplay;
      vsyncstart;
      vsyncend;
      vtotal;
      flags;
      private_;
    }

  type get_monitor_reply = {
    hsync : syncrange list;
    vsync : syncrange list;
    vendor : string;
    alignment_pad : string;
    model : string;
  }
  [@@deriving sexp]

  let decode_get_monitor_reply buf : get_monitor_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let vendor_length = Decode.u8 buf in
    let model_length = Decode.u8 buf in
    let num_hsync = Decode.u8 buf in
    let num_vsync = Decode.u8 buf in
    Decode.pad buf 20;
    let hsync = (Decode.list ~item:decode_syncrange) ~len:num_hsync buf in
    let vsync = (Decode.list ~item:decode_syncrange) ~len:num_vsync buf in
    let vendor = Decode.string ~len:vendor_length buf in
    let alignment_pad =
      Decode.string ~len:(((vendor_length + 3) land lnot 3) - vendor_length) buf
    in
    let model = Decode.string ~len:model_length buf in
    ignore length;
    { hsync; vsync; vendor; alignment_pad; model }

  type get_all_mode_lines_reply = mode_info list [@@deriving sexp]

  let decode_get_all_mode_lines_reply buf : get_all_mode_lines_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let modecount = Decode.u32 buf in
    Decode.pad buf 20;
    let modeinfo = (Decode.list ~item:decode_mode_info) ~len:modecount buf in
    ignore length;
    modeinfo

  type validate_mode_line_reply = u32 [@@deriving sexp]

  let decode_validate_mode_line_reply buf : validate_mode_line_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let status = Decode.u32 buf in
    Decode.pad buf 20;
    ignore length;
    status

  type get_view_port_reply = { x : u32; y : u32 } [@@deriving sexp]

  let decode_get_view_port_reply buf : get_view_port_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let x = Decode.u32 buf in
    let y = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    { x; y }

  type get_dot_clocks_reply = {
    flags : clock_flag_mask;
    clocks : u32;
    maxclocks : u32;
    clock : u32 list;
  }
  [@@deriving sexp]

  let decode_get_dot_clocks_reply buf : get_dot_clocks_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let flags =
      (Decode.mask Decode.u32 Int64.of_int clock_flag_mask_of_int64) buf
    in
    let clocks = Decode.u32 buf in
    let maxclocks = Decode.u32 buf in
    Decode.pad buf 12;
    let clock =
      (Decode.list ~item:Decode.u32) ~len:((1 - (flags land 1)) * clocks) buf
    in
    ignore length;
    { flags; clocks; maxclocks; clock }

  type get_gamma_reply = { red : u32; green : u32; blue : u32 }
  [@@deriving sexp]

  let decode_get_gamma_reply buf : get_gamma_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let red = Decode.u32 buf in
    let green = Decode.u32 buf in
    let blue = Decode.u32 buf in
    Decode.pad buf 12;
    ignore length;
    { red; green; blue }

  type get_gamma_ramp_reply = {
    size : u16;
    red : u16 list;
    green : u16 list;
    blue : u16 list;
  }
  [@@deriving sexp]

  let decode_get_gamma_ramp_reply buf : get_gamma_ramp_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let size = Decode.u16 buf in
    Decode.pad buf 22;
    let red =
      (Decode.list ~item:Decode.u16) ~len:((size + 1) land lnot 1) buf
    in
    let green =
      (Decode.list ~item:Decode.u16) ~len:((size + 1) land lnot 1) buf
    in
    let blue =
      (Decode.list ~item:Decode.u16) ~len:((size + 1) land lnot 1) buf
    in
    ignore length;
    { size; red; green; blue }

  type get_gamma_ramp_size_reply = u16 [@@deriving sexp]

  let decode_get_gamma_ramp_size_reply buf : get_gamma_ramp_size_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let size = Decode.u16 buf in
    Decode.pad buf 22;
    ignore length;
    size

  type get_permissions_reply = permission_mask [@@deriving sexp]

  let decode_get_permissions_reply buf : get_permissions_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let permissions =
      (Decode.mask Decode.u32 Int64.of_int permission_mask_of_int64) buf
    in
    Decode.pad buf 20;
    ignore length;
    permissions

  type bad_clock_error = unit [@@deriving sexp]

  let decode_bad_clock_error _ : bad_clock_error = Decode.pad 32

  type bad_h_timings_error = unit [@@deriving sexp]

  let decode_bad_h_timings_error _ : bad_h_timings_error = Decode.pad 32

  type bad_v_timings_error = unit [@@deriving sexp]

  let decode_bad_v_timings_error _ : bad_v_timings_error = Decode.pad 32

  type mode_unsuitable_error = unit [@@deriving sexp]

  let decode_mode_unsuitable_error _ : mode_unsuitable_error = Decode.pad 32

  type extension_disabled_error = unit [@@deriving sexp]

  let decode_extension_disabled_error _ : extension_disabled_error =
    Decode.pad 32

  type client_not_local_error = unit [@@deriving sexp]

  let decode_client_not_local_error _ : client_not_local_error = Decode.pad 32

  type zoom_locked_error = unit [@@deriving sexp]

  let decode_zoom_locked_error _ : zoom_locked_error = Decode.pad 32
end

module Xinerama = struct
  type screen_info = { x_org : i16; y_org : i16; width : u16; height : u16 }
  [@@deriving sexp]

  let decode_screen_info buf : screen_info =
    let x_org = Decode.i16 buf in
    let y_org = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    { x_org; y_org; width; height }

  type query_version_reply = { major : u16; minor : u16 } [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major = Decode.u16 buf in
    let minor = Decode.u16 buf in
    ignore length;
    { major; minor }

  type get_state_reply = { state : byte; window : Xproto.window }
  [@@deriving sexp]

  let decode_get_state_reply buf : get_state_reply =
    Decode.pad buf 1;
    let state = Decode.byte buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let window = Xproto.decode_window buf in
    ignore length;
    { state; window }

  type get_screen_count_reply = { screen_count : byte; window : Xproto.window }
  [@@deriving sexp]

  let decode_get_screen_count_reply buf : get_screen_count_reply =
    Decode.pad buf 1;
    let screen_count = Decode.byte buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let window = Xproto.decode_window buf in
    ignore length;
    { screen_count; window }

  type get_screen_size_reply = {
    width : u32;
    height : u32;
    window : Xproto.window;
    screen : u32;
  }
  [@@deriving sexp]

  let decode_get_screen_size_reply buf : get_screen_size_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let width = Decode.u32 buf in
    let height = Decode.u32 buf in
    let window = Xproto.decode_window buf in
    let screen = Decode.u32 buf in
    ignore length;
    { width; height; window; screen }

  type is_active_reply = u32 [@@deriving sexp]

  let decode_is_active_reply buf : is_active_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let state = Decode.u32 buf in
    ignore length;
    state

  type query_screens_reply = screen_info list [@@deriving sexp]

  let decode_query_screens_reply buf : query_screens_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let number = Decode.u32 buf in
    Decode.pad buf 20;
    let screen_info = (Decode.list ~item:decode_screen_info) ~len:number buf in
    ignore length;
    screen_info
end

module Xinput = struct
  type event_class = u32 [@@deriving sexp]

  let decode_event_class = Decode.u32

  type key_code = u8 [@@deriving sexp]

  let decode_key_code = Decode.u8

  type device_id = u16 [@@deriving sexp]

  let decode_device_id = Decode.u16

  type fp1616 = i32 [@@deriving sexp]

  let decode_fp1616 = Decode.i32

  type fp3232 = { integral : i32; frac : u32 } [@@deriving sexp]

  let decode_fp3232 buf : fp3232 =
    let integral = Decode.i32 buf in
    let frac = Decode.u32 buf in
    { integral; frac }

  type get_extension_version_reply = {
    xi_reply_type : u8;
    server_major : u16;
    server_minor : u16;
    present : bool;
  }
  [@@deriving sexp]

  let decode_get_extension_version_reply buf : get_extension_version_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let server_major = Decode.u16 buf in
    let server_minor = Decode.u16 buf in
    let present = Decode.bool buf in
    Decode.pad buf 19;
    ignore length;
    { xi_reply_type; server_major; server_minor; present }

  type device_use_enum =
    [ `Is_x_pointer
    | `Is_x_keyboard
    | `Is_x_extension_device
    | `Is_x_extension_keyboard
    | `Is_x_extension_pointer ]
  [@@deriving sexp]

  let device_use_enum_of_int n : [ device_use_enum | int custom ] =
    match n with
    | 0 -> `Is_x_pointer
    | 1 -> `Is_x_keyboard
    | 2 -> `Is_x_extension_device
    | 3 -> `Is_x_extension_keyboard
    | 4 -> `Is_x_extension_pointer
    | _ -> `Custom n

  type input_class_enum =
    [ `Key | `Button | `Valuator | `Feedback | `Proximity | `Focus | `Other ]
  [@@deriving sexp]

  let input_class_enum_of_int n : [ input_class_enum | int custom ] =
    match n with
    | 0 -> `Key
    | 1 -> `Button
    | 2 -> `Valuator
    | 3 -> `Feedback
    | 4 -> `Proximity
    | 5 -> `Focus
    | 6 -> `Other
    | _ -> `Custom n

  type valuator_mode_enum = [ `Relative | `Absolute ] [@@deriving sexp]

  let valuator_mode_enum_of_int n : [ valuator_mode_enum | int custom ] =
    match n with 0 -> `Relative | 1 -> `Absolute | _ -> `Custom n

  type device_info = {
    device_type : Xproto.atom;
    device_id : u8;
    num_class_info : u8;
    device_use : device_use_enum;
  }
  [@@deriving sexp]

  let decode_device_info buf : device_info =
    let device_type = Xproto.decode_atom buf in
    let device_id = Decode.u8 buf in
    let num_class_info = Decode.u8 buf in
    let device_use =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:device_use_enum_of_int)
        buf
    in
    Decode.pad buf 1;
    { device_type; device_id; num_class_info; device_use }

  type key_info = {
    class_id : input_class_enum;
    len : u8;
    min_keycode : key_code;
    max_keycode : key_code;
    num_keys : u16;
  }
  [@@deriving sexp]

  let decode_key_info buf : key_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let min_keycode = decode_key_code buf in
    let max_keycode = decode_key_code buf in
    let num_keys = Decode.u16 buf in
    Decode.pad buf 2;
    { class_id; len; min_keycode; max_keycode; num_keys }

  type button_info = {
    class_id : input_class_enum;
    len : u8;
    num_buttons : u16;
  }
  [@@deriving sexp]

  let decode_button_info buf : button_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let num_buttons = Decode.u16 buf in
    { class_id; len; num_buttons }

  type axis_info = { resolution : u32; minimum : i32; maximum : i32 }
  [@@deriving sexp]

  let decode_axis_info buf : axis_info =
    let resolution = Decode.u32 buf in
    let minimum = Decode.i32 buf in
    let maximum = Decode.i32 buf in
    { resolution; minimum; maximum }

  type valuator_info = {
    class_id : input_class_enum;
    len : u8;
    mode : valuator_mode_enum;
    motion_size : u32;
    axes : axis_info list;
  }
  [@@deriving sexp]

  let decode_valuator_info buf : valuator_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let axes_len = Decode.u8 buf in
    let mode =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:valuator_mode_enum_of_int)
        buf
    in
    let motion_size = Decode.u32 buf in
    let axes = (Decode.list ~item:decode_axis_info) ~len:axes_len buf in
    { class_id; len; mode; motion_size; axes }

  type input_class_variant =
    | Key of { min_keycode : key_code; max_keycode : key_code; num_keys : u16 }
    | Button of u16
    | Valuator of {
        mode : valuator_mode_enum;
        motion_size : u32;
        axes : axis_info list;
      }
  [@@deriving sexp]

  let decode_input_class_variant buf ~tag : input_class_variant =
    match tag with
    | 0 ->
        let min_keycode = decode_key_code buf in
        let max_keycode = decode_key_code buf in
        let num_keys = Decode.u16 buf in
        Decode.pad buf 2;
        Key { min_keycode; max_keycode; num_keys }
    | 1 ->
        let num_buttons = Decode.u16 buf in
        Button num_buttons
    | 2 ->
        let axes_len = Decode.u8 buf in
        let mode =
          (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
             ~enum_of_int:valuator_mode_enum_of_int)
            buf
        in
        let motion_size = Decode.u32 buf in
        let axes = (Decode.list ~item:decode_axis_info) ~len:axes_len buf in
        Valuator { mode; motion_size; axes }

  type input_info = { len : u8; info : input_class_variant } [@@deriving sexp]

  let decode_input_info buf : input_info =
    let info_tag = Decode.u8 buf in
    let len = Decode.u8 buf in
    let info = decode_input_class_variant ~tag:info_tag buf in
    { len; info }

  type device_name = string [@@deriving sexp]

  let decode_device_name buf : device_name =
    let len = Decode.u8 buf in
    let string = Decode.string ~len buf in
    string

  type list_input_devices_reply = {
    xi_reply_type : u8;
    devices : device_info list;
    infos : input_info list;
    names : Xproto.str list;
  }
  [@@deriving sexp]

  let decode_list_input_devices_reply buf : list_input_devices_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let devices_len = Decode.u8 buf in
    Decode.pad buf 23;
    let devices = (Decode.list ~item:decode_device_info) ~len:devices_len buf in
    let infos =
      (Decode.list ~item:decode_input_info)
        ~len:
          (sum_of_expr
             (fun list_element_ref -> list_element_ref.num_class_info)
             devices)
        buf
    in
    let names = (Decode.list ~item:Xproto.decode_str) ~len:devices_len buf in
    Decode.align buf 4;
    ignore length;
    { xi_reply_type; devices; infos; names }

  type event_type_base = u8 [@@deriving sexp]

  let decode_event_type_base = Decode.u8

  type input_class_info = {
    class_id : input_class_enum;
    event_type_base : event_type_base;
  }
  [@@deriving sexp]

  let decode_input_class_info buf : input_class_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let event_type_base = decode_event_type_base buf in
    { class_id; event_type_base }

  type open_device_reply = {
    xi_reply_type : u8;
    class_info : input_class_info list;
  }
