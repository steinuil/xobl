    back_y : i16;
    clip_rects : drm_clip_rect list;
    back_clip_rects : drm_clip_rect list;
  }
  [@@deriving sexp]

  type get_device_info_reply = {
    framebuffer_handle_low : u32;
    framebuffer_handle_high : u32;
    framebuffer_origin_offset : u32;
    framebuffer_size : u32;
    framebuffer_stride : u32;
    device_private : u32 list;
  }
  [@@deriving sexp]

  type auth_connection_reply = u32 [@@deriving sexp]
end

module Xf86vidmode = struct
  type syncrange = u32 [@@deriving sexp]

  let decode_syncrange = Decode.u32

  type dotclock = u32 [@@deriving sexp]

  let decode_dotclock = Decode.u32

  type mode_flag_mask =
    [ `Positive_h_sync
    | `Negative_h_sync
    | `Positive_v_sync
    | `Negative_v_sync
    | `Interlace
    | `Composite_sync
    | `Positive_c_sync
    | `Negative_c_sync
    | `H_skew
    | `Broadcast
    | `Pixmux
    | `Double_clock
    | `Half_clock ]
    list
  [@@deriving sexp]

  type clock_flag_mask = [ `Programable ] list [@@deriving sexp]
  type permission_mask = [ `Read | `Write ] list [@@deriving sexp]

  type mode_info = {
    dotclock : dotclock;
    hdisplay : u16;
    hsyncstart : u16;
    hsyncend : u16;
    htotal : u16;
    hskew : u32;
    vdisplay : u16;
    vsyncstart : u16;
    vsyncend : u16;
    vtotal : u16;
    flags : mode_flag_mask;
    privsize : u32;
  }
  [@@deriving sexp]

  let decode_mode_info buf : mode_info =
    let dotclock = decode_dotclock buf in
    let hdisplay = Decode.u16 buf in
    let hsyncstart = Decode.u16 buf in
    let hsyncend = Decode.u16 buf in
    let htotal = Decode.u16 buf in
    let hskew = Decode.u32 buf in
    let vdisplay = Decode.u16 buf in
    let vsyncstart = Decode.u16 buf in
    let vsyncend = Decode.u16 buf in
    let vtotal = Decode.u16 buf in
    Decode.pad buf 4;
    let flags =
      (Decode.mask Decode.u32 Int64.of_int mode_flag_mask_of_int64) buf
    in
    Decode.pad buf 12;
    let privsize = Decode.u32 buf in
    ()

  type query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  type get_mode_line_reply = {
    dotclock : dotclock;
    hdisplay : u16;
    hsyncstart : u16;
    hsyncend : u16;
    htotal : u16;
    hskew : u16;
    vdisplay : u16;
    vsyncstart : u16;
    vsyncend : u16;
    vtotal : u16;
    flags : mode_flag_mask;
    private_ : u8 list;
  }
  [@@deriving sexp]

  type get_monitor_reply = {
    hsync : syncrange list;
    vsync : syncrange list;
    vendor : string;
    alignment_pad : string;
    model : string;
  }
  [@@deriving sexp]

  type get_all_mode_lines_reply = mode_info list [@@deriving sexp]
  type validate_mode_line_reply = u32 [@@deriving sexp]
  type get_view_port_reply = { x : u32; y : u32 } [@@deriving sexp]

  type get_dot_clocks_reply = {
    flags : clock_flag_mask;
    clocks : u32;
    maxclocks : u32;
    clock : u32 list;
  }
  [@@deriving sexp]

  type get_gamma_reply = { red : u32; green : u32; blue : u32 }
  [@@deriving sexp]

  type get_gamma_ramp_reply = {
    size : u16;
    red : u16 list;
    green : u16 list;
    blue : u16 list;
  }
  [@@deriving sexp]

  type get_gamma_ramp_size_reply = u16 [@@deriving sexp]
  type get_permissions_reply = permission_mask [@@deriving sexp]
  type bad_clock_error = unit [@@deriving sexp]
  type bad_h_timings_error = unit [@@deriving sexp]
  type bad_v_timings_error = unit [@@deriving sexp]
  type mode_unsuitable_error = unit [@@deriving sexp]
  type extension_disabled_error = unit [@@deriving sexp]
  type client_not_local_error = unit [@@deriving sexp]
  type zoom_locked_error = unit [@@deriving sexp]
end

module Xinerama = struct
  type screen_info = { x_org : i16; y_org : i16; width : u16; height : u16 }
  [@@deriving sexp]

  let decode_screen_info buf : screen_info =
    let x_org = Decode.i16 buf in
    let y_org = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    ()

  type query_version_reply = { major : u16; minor : u16 } [@@deriving sexp]

  type get_state_reply = { state : byte; window : Xproto.window }
  [@@deriving sexp]

  type get_screen_count_reply = { screen_count : byte; window : Xproto.window }
  [@@deriving sexp]

  type get_screen_size_reply = {
    width : u32;
    height : u32;
    window : Xproto.window;
    screen : u32;
  }
  [@@deriving sexp]

  type is_active_reply = u32 [@@deriving sexp]
  type query_screens_reply = screen_info list [@@deriving sexp]
end

module Xinput = struct
  type event_class = u32 [@@deriving sexp]

  let decode_event_class = Decode.u32

  type key_code = u8 [@@deriving sexp]

  let decode_key_code = Decode.u8

  type device_id = u16 [@@deriving sexp]

  let decode_device_id = Decode.u16

  type fp1616 = i32 [@@deriving sexp]

  let decode_fp1616 = Decode.i32

  type fp3232 = { integral : i32; frac : u32 } [@@deriving sexp]

  let decode_fp3232 buf : fp3232 =
    let integral = Decode.i32 buf in
    let frac = Decode.u32 buf in
    ()

  type get_extension_version_reply = {
    xi_reply_type : u8;
    server_major : u16;
    server_minor : u16;
    present : bool;
  }
  [@@deriving sexp]

  type device_use_enum =
    [ `Is_x_pointer
    | `Is_x_keyboard
    | `Is_x_extension_device
    | `Is_x_extension_keyboard
    | `Is_x_extension_pointer ]
  [@@deriving sexp]

  type input_class_enum =
    [ `Key | `Button | `Valuator | `Feedback | `Proximity | `Focus | `Other ]
  [@@deriving sexp]

  type valuator_mode_enum = [ `Relative | `Absolute ] [@@deriving sexp]

  type device_info = {
    device_type : Xproto.atom;
    device_id : u8;
    num_class_info : u8;
    device_use : device_use_enum;
  }
  [@@deriving sexp]

  let decode_device_info buf : device_info =
    let device_type = Xproto.decode_atom buf in
    let device_id = Decode.u8 buf in
    let num_class_info = Decode.u8 buf in
    let device_use =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:device_use_enum_of_int)
        buf
    in
    Decode.pad buf 1;
    ()

  type key_info = {
    class_id : input_class_enum;
    len : u8;
    min_keycode : key_code;
    max_keycode : key_code;
    num_keys : u16;
  }
  [@@deriving sexp]

  let decode_key_info buf : key_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let min_keycode = decode_key_code buf in
    let max_keycode = decode_key_code buf in
    let num_keys = Decode.u16 buf in
    Decode.pad buf 2;
    ()

  type button_info = {
    class_id : input_class_enum;
    len : u8;
    num_buttons : u16;
  }
  [@@deriving sexp]

  let decode_button_info buf : button_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let num_buttons = Decode.u16 buf in
    ()

  type axis_info = { resolution : u32; minimum : i32; maximum : i32 }
  [@@deriving sexp]

  let decode_axis_info buf : axis_info =
    let resolution = Decode.u32 buf in
    let minimum = Decode.i32 buf in
    let maximum = Decode.i32 buf in
    ()

  type valuator_info = {
    class_id : input_class_enum;
    len : u8;
    mode : valuator_mode_enum;
    motion_size : u32;
    axes : axis_info list;
  }
  [@@deriving sexp]

  let decode_valuator_info buf : valuator_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let axes_len = Decode.u8 buf in
    let mode =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:valuator_mode_enum_of_int)
        buf
    in
    let motion_size = Decode.u32 buf in
    let axes = (Decode.list ~item:decode_axis_info) ~len:axes_len buf in
    ()

  type input_class_variant =
    | Key of { min_keycode : key_code; max_keycode : key_code; num_keys : u16 }
    | Button of u16
    | Valuator of {
        mode : valuator_mode_enum;
        motion_size : u32;
        axes : axis_info list;
      }
  [@@deriving sexp]

  type input_info = { len : u8; info : input_class_variant } [@@deriving sexp]

  let decode_input_info buf : input_info =
    let info_tag = Decode.u8 buf in
    let len = Decode.u8 buf in
    ()

  type device_name = string [@@deriving sexp]

  let decode_device_name buf : device_name =
    let len = Decode.u8 buf in
    let string = Decode.string ~len buf in
    ()

  type list_input_devices_reply = {
    xi_reply_type : u8;
    devices : device_info list;
    infos : input_info list;
    names : Xproto.str list;
  }
  [@@deriving sexp]

  type event_type_base = u8 [@@deriving sexp]

  let decode_event_type_base = Decode.u8

  type input_class_info = {
    class_id : input_class_enum;
    event_type_base : event_type_base;
  }
  [@@deriving sexp]

  let decode_input_class_info buf : input_class_info =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let event_type_base = decode_event_type_base buf in
    ()

  type open_device_reply = {
    xi_reply_type : u8;
    class_info : input_class_info list;
  }
  [@@deriving sexp]

  type set_device_mode_reply = {
    xi_reply_type : u8;
    status : Xproto.grab_status_enum;
  }
  [@@deriving sexp]

  type get_selected_extension_events_reply = {
    xi_reply_type : u8;
    this_classes : event_class list;
    all_classes : event_class list;
  }
  [@@deriving sexp]

  type propagate_mode_enum = [ `Add_to_list | `Delete_from_list ]
  [@@deriving sexp]

  type get_device_dont_propagate_list_reply = {
    xi_reply_type : u8;
    classes : event_class list;
  }
  [@@deriving sexp]

  type device_time_coord = { time : Xproto.timestamp; axisvalues : i32 list }
  [@@deriving sexp]

  let decode_device_time_coord buf ext_num_axes : device_time_coord =
    let time = Xproto.decode_timestamp buf in
    let axisvalues = (Decode.list ~item:Decode.i32) ~len:ext_num_axes buf in
    ()

  type get_device_motion_events_reply = {
    xi_reply_type : u8;
    num_axes : u8;
    device_mode : valuator_mode_enum;
    events : device_time_coord list;
  }
  [@@deriving sexp]

  type change_keyboard_device_reply = {
    xi_reply_type : u8;
    status : Xproto.grab_status_enum;
  }
  [@@deriving sexp]

  type change_pointer_device_reply = {
    xi_reply_type : u8;
    status : Xproto.grab_status_enum;
  }
  [@@deriving sexp]

  type grab_device_reply = {
    xi_reply_type : u8;
    status : Xproto.grab_status_enum;
  }
  [@@deriving sexp]

  type modifier_device_enum = [ `Use_x_keyboard ] [@@deriving sexp]

  type device_input_mode_enum =
    [ `Async_this_device
    | `Sync_this_device
    | `Replay_this_device
    | `Async_other_devices
    | `Async_all
    | `Sync_all ]
  [@@deriving sexp]

  type get_device_focus_reply = {
    xi_reply_type : u8;
    focus : Xproto.input_focus_enum alt_enum;
    time : Xproto.timestamp;
    revert_to : Xproto.input_focus_enum;
  }
  [@@deriving sexp]

  type feedback_class_enum =
    [ `Keyboard | `Pointer | `String | `Integer | `Led | `Bell ]
  [@@deriving sexp]

  type kbd_feedback_state = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    pitch : u16;
    duration : u16;
    led_mask : u32;
    led_values : u32;
    global_auto_repeat : bool;
    click : u8;
    percent : u8;
    auto_repeats : u8 list;
  }
  [@@deriving sexp]

  let decode_kbd_feedback_state buf : kbd_feedback_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    let pitch = Decode.u16 buf in
    let duration = Decode.u16 buf in
    let led_mask = Decode.u32 buf in
    let led_values = Decode.u32 buf in
    let global_auto_repeat = Decode.bool buf in
    let click = Decode.u8 buf in
    let percent = Decode.u8 buf in
    Decode.pad buf 1;
    let auto_repeats = (Decode.list ~item:Decode.u8) ~len:32 buf in
    ()

  type ptr_feedback_state = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    accel_num : u16;
    accel_denom : u16;
    threshold : u16;
  }
  [@@deriving sexp]

  let decode_ptr_feedback_state buf : ptr_feedback_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    Decode.pad buf 2;
    let accel_num = Decode.u16 buf in
    let accel_denom = Decode.u16 buf in
    let threshold = Decode.u16 buf in
    ()

  type integer_feedback_state = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    resolution : u32;
    min_value : i32;
    max_value : i32;
  }
  [@@deriving sexp]

  let decode_integer_feedback_state buf : integer_feedback_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    let resolution = Decode.u32 buf in
    let min_value = Decode.i32 buf in
    let max_value = Decode.i32 buf in
    ()

  type string_feedback_state = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    max_symbols : u16;
    keysyms : Xproto.keysym list;
  }
  [@@deriving sexp]

  let decode_string_feedback_state buf : string_feedback_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    let max_symbols = Decode.u16 buf in
    let num_keysyms = Decode.u16 buf in
    let keysyms =
      (Decode.list ~item:Xproto.decode_keysym) ~len:num_keysyms buf
    in
    ()

  type bell_feedback_state = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    percent : u8;
    pitch : u16;
    duration : u16;
  }
  [@@deriving sexp]

  let decode_bell_feedback_state buf : bell_feedback_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    let percent = Decode.u8 buf in
    Decode.pad buf 3;
    let pitch = Decode.u16 buf in
    let duration = Decode.u16 buf in
    ()

  type led_feedback_state = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    led_mask : u32;
    led_values : u32;
  }
  [@@deriving sexp]

  let decode_led_feedback_state buf : led_feedback_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    let led_mask = Decode.u32 buf in
    let led_values = Decode.u32 buf in
    ()

  type feedback_class_variant =
    | Keyboard of {
        pitch : u16;
        duration : u16;
        led_mask : u32;
        led_values : u32;
        global_auto_repeat : bool;
        click : u8;
        percent : u8;
        auto_repeats : u8 list;
      }
    | Pointer of { accel_num : u16; accel_denom : u16; threshold : u16 }
    | String of { max_symbols : u16; keysyms : Xproto.keysym list }
    | Integer of { resolution : u32; min_value : i32; max_value : i32 }
    | Led of { led_mask : u32; led_values : u32 }
    | Bell of { percent : u8; pitch : u16; duration : u16 }
  [@@deriving sexp]

  type feedback_state = {
    feedback_id : u8;
    len : u16;
    data : feedback_class_variant;
  }
  [@@deriving sexp]

  let decode_feedback_state buf : feedback_state =
    let data_tag = Decode.u8 buf in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    ()

  type get_feedback_control_reply = {
    xi_reply_type : u8;
    feedbacks : feedback_state list;
  }
  [@@deriving sexp]

  type kbd_feedback_ctl = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    key : key_code;
    auto_repeat_mode : u8;
    key_click_percent : i8;
    bell_percent : i8;
    bell_pitch : i16;
    bell_duration : i16;
    led_mask : u32;
    led_values : u32;
  }
  [@@deriving sexp]

  let decode_kbd_feedback_ctl buf : kbd_feedback_ctl =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    let key = decode_key_code buf in
    let auto_repeat_mode = Decode.u8 buf in
    let key_click_percent = Decode.i8 buf in
    let bell_percent = Decode.i8 buf in
    let bell_pitch = Decode.i16 buf in
    let bell_duration = Decode.i16 buf in
    let led_mask = Decode.u32 buf in
    let led_values = Decode.u32 buf in
    ()

  type ptr_feedback_ctl = {
