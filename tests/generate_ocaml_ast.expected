    | 1 -> `Include_inferiors
    | _ -> `Custom n

  type arc_mode_enum = [ `Chord | `Pie_slice ] [@@deriving sexp]

  let arc_mode_enum_of_int n : [ arc_mode_enum | int custom ] =
    match n with 0 -> `Chord | 1 -> `Pie_slice | _ -> `Custom n

  type font_enum = [ `None ] [@@deriving sexp]

  let font_enum_of_int n : [ font_enum | int custom ] =
    match n with 0 -> `None | _ -> `Custom n

  type clip_ordering_enum = [ `Unsorted | `Y_sorted | `Yx_sorted | `Yx_banded ]
  [@@deriving sexp]

  let clip_ordering_enum_of_int n : [ clip_ordering_enum | int custom ] =
    match n with
    | 0 -> `Unsorted
    | 1 -> `Y_sorted
    | 2 -> `Yx_sorted
    | 3 -> `Yx_banded
    | _ -> `Custom n

  type coord_mode_enum = [ `Origin | `Previous ] [@@deriving sexp]

  let coord_mode_enum_of_int n : [ coord_mode_enum | int custom ] =
    match n with 0 -> `Origin | 1 -> `Previous | _ -> `Custom n

  type segment = { x1 : i16; y1 : i16; x2 : i16; y2 : i16 } [@@deriving sexp]

  let decode_segment buf : segment =
    let x1 = Decode.i16 buf in
    let y1 = Decode.i16 buf in
    let x2 = Decode.i16 buf in
    let y2 = Decode.i16 buf in
    { x1; y1; x2; y2 }

  type poly_shape_enum = [ `Complex | `Nonconvex | `Convex ] [@@deriving sexp]

  let poly_shape_enum_of_int n : [ poly_shape_enum | int custom ] =
    match n with
    | 0 -> `Complex
    | 1 -> `Nonconvex
    | 2 -> `Convex
    | _ -> `Custom n

  type image_format_enum = [ `Xy_bitmap | `Xy_pixmap | `Z_pixmap ]
  [@@deriving sexp]

  let image_format_enum_of_int n : [ image_format_enum | int custom ] =
    match n with
    | 0 -> `Xy_bitmap
    | 1 -> `Xy_pixmap
    | 2 -> `Z_pixmap
    | _ -> `Custom n

  type get_image_reply = { depth : u8; visual : visualid; data : byte list }
  [@@deriving sexp]

  let decode_get_image_reply buf : get_image_reply =
    Decode.pad buf 1;
    let depth = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let visual = decode_visualid buf in
    Decode.pad buf 20;
    let data = (Decode.list ~item:Decode.byte) ~len:(length * 4) buf in
    ignore length;
    { depth; visual; data }

  type colormap_alloc_enum = [ `None | `All ] [@@deriving sexp]

  let colormap_alloc_enum_of_int n : [ colormap_alloc_enum | int custom ] =
    match n with 0 -> `None | 1 -> `All | _ -> `Custom n

  type list_installed_colormaps_reply = colormap list [@@deriving sexp]

  let decode_list_installed_colormaps_reply buf : list_installed_colormaps_reply
      =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let cmaps_len = Decode.u16 buf in
    Decode.pad buf 22;
    let cmaps = (Decode.list ~item:decode_colormap) ~len:cmaps_len buf in
    ignore length;
    cmaps

  type alloc_color_reply = { red : u16; green : u16; blue : u16; pixel : u32 }
  [@@deriving sexp]

  let decode_alloc_color_reply buf : alloc_color_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    Decode.pad buf 2;
    let pixel = Decode.u32 buf in
    ignore length;
    { red; green; blue; pixel }

  type alloc_named_color_reply = {
    pixel : u32;
    exact_red : u16;
    exact_green : u16;
    exact_blue : u16;
    visual_red : u16;
    visual_green : u16;
    visual_blue : u16;
  }
  [@@deriving sexp]

  let decode_alloc_named_color_reply buf : alloc_named_color_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let pixel = Decode.u32 buf in
    let exact_red = Decode.u16 buf in
    let exact_green = Decode.u16 buf in
    let exact_blue = Decode.u16 buf in
    let visual_red = Decode.u16 buf in
    let visual_green = Decode.u16 buf in
    let visual_blue = Decode.u16 buf in
    ignore length;
    {
      pixel;
      exact_red;
      exact_green;
      exact_blue;
      visual_red;
      visual_green;
      visual_blue;
    }

  type alloc_color_cells_reply = { pixels : u32 list; masks : u32 list }
  [@@deriving sexp]

  let decode_alloc_color_cells_reply buf : alloc_color_cells_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let pixels_len = Decode.u16 buf in
    let masks_len = Decode.u16 buf in
    Decode.pad buf 20;
    let pixels = (Decode.list ~item:Decode.u32) ~len:pixels_len buf in
    let masks = (Decode.list ~item:Decode.u32) ~len:masks_len buf in
    ignore length;
    { pixels; masks }

  type alloc_color_planes_reply = {
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
    pixels : u32 list;
  }
  [@@deriving sexp]

  let decode_alloc_color_planes_reply buf : alloc_color_planes_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let pixels_len = Decode.u16 buf in
    Decode.pad buf 2;
    let red_mask = Decode.u32 buf in
    let green_mask = Decode.u32 buf in
    let blue_mask = Decode.u32 buf in
    Decode.pad buf 8;
    let pixels = (Decode.list ~item:Decode.u32) ~len:pixels_len buf in
    ignore length;
    { red_mask; green_mask; blue_mask; pixels }

  type color_flag_mask = [ `Red | `Green | `Blue ] list [@@deriving sexp]

  type coloritem = {
    pixel : u32;
    red : u16;
    green : u16;
    blue : u16;
    flags : color_flag_mask;
  }
  [@@deriving sexp]

  let decode_coloritem buf : coloritem =
    let pixel = Decode.u32 buf in
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    let flags =
      (Decode.mask Decode.byte char_to_int64 color_flag_mask_of_int64) buf
    in
    Decode.pad buf 1;
    { pixel; red; green; blue; flags }

  type rgb = { red : u16; green : u16; blue : u16 } [@@deriving sexp]

  let decode_rgb buf : rgb =
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    Decode.pad buf 2;
    { red; green; blue }

  type query_colors_reply = rgb list [@@deriving sexp]

  let decode_query_colors_reply buf : query_colors_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let colors_len = Decode.u16 buf in
    Decode.pad buf 22;
    let colors = (Decode.list ~item:decode_rgb) ~len:colors_len buf in
    ignore length;
    colors

  type lookup_color_reply = {
    exact_red : u16;
    exact_green : u16;
    exact_blue : u16;
    visual_red : u16;
    visual_green : u16;
    visual_blue : u16;
  }
  [@@deriving sexp]

  let decode_lookup_color_reply buf : lookup_color_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let exact_red = Decode.u16 buf in
    let exact_green = Decode.u16 buf in
    let exact_blue = Decode.u16 buf in
    let visual_red = Decode.u16 buf in
    let visual_green = Decode.u16 buf in
    let visual_blue = Decode.u16 buf in
    ignore length;
    {
      exact_red;
      exact_green;
      exact_blue;
      visual_red;
      visual_green;
      visual_blue;
    }

  type query_shape_of_enum =
    [ `Largest_cursor | `Fastest_tile | `Fastest_stipple ]
  [@@deriving sexp]

  let query_shape_of_enum_of_int n : [ query_shape_of_enum | int custom ] =
    match n with
    | 0 -> `Largest_cursor
    | 1 -> `Fastest_tile
    | 2 -> `Fastest_stipple
    | _ -> `Custom n

  type query_best_size_reply = { width : u16; height : u16 } [@@deriving sexp]

  let decode_query_best_size_reply buf : query_best_size_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    ignore length;
    { width; height }

  type query_extension_reply = {
    present : bool;
    major_opcode : u8;
    first_event : u8;
    first_error : u8;
  }
  [@@deriving sexp]

  let decode_query_extension_reply buf : query_extension_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let present = Decode.bool buf in
    let major_opcode = Decode.u8 buf in
    let first_event = Decode.u8 buf in
    let first_error = Decode.u8 buf in
    ignore length;
    { present; major_opcode; first_event; first_error }

  type list_extensions_reply = str list [@@deriving sexp]

  let decode_list_extensions_reply buf : list_extensions_reply =
    Decode.pad buf 1;
    let names_len = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    Decode.pad buf 24;
    let names = (Decode.list ~item:decode_str) ~len:names_len buf in
    ignore length;
    names

  type get_keyboard_mapping_reply = {
    keysyms_per_keycode : byte;
    keysyms : keysym list;
  }
  [@@deriving sexp]

  let decode_get_keyboard_mapping_reply buf : get_keyboard_mapping_reply =
    Decode.pad buf 1;
    let keysyms_per_keycode = Decode.byte buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    Decode.pad buf 24;
    let keysyms = (Decode.list ~item:decode_keysym) ~len:length buf in
    ignore length;
    { keysyms_per_keycode; keysyms }

  type kb_mask =
    [ `Key_click_percent
    | `Bell_percent
    | `Bell_pitch
    | `Bell_duration
    | `Led
    | `Led_mode
    | `Key
    | `Auto_repeat_mode ]
    list
  [@@deriving sexp]

  type led_mode_enum = [ `Off | `On ] [@@deriving sexp]

  let led_mode_enum_of_int n : [ led_mode_enum | int custom ] =
    match n with 0 -> `Off | 1 -> `On | _ -> `Custom n

  type auto_repeat_mode_enum = [ `Off | `On | `Default ] [@@deriving sexp]

  let auto_repeat_mode_enum_of_int n : [ auto_repeat_mode_enum | int custom ] =
    match n with 0 -> `Off | 1 -> `On | 2 -> `Default | _ -> `Custom n

  type get_keyboard_control_reply = {
    global_auto_repeat : auto_repeat_mode_enum;
    led_mask : u32;
    key_click_percent : u8;
    bell_percent : u8;
    bell_pitch : u16;
    bell_duration : u16;
    auto_repeats : u8 list;
  }
  [@@deriving sexp]

  let decode_get_keyboard_control_reply buf : get_keyboard_control_reply =
    Decode.pad buf 1;
    let global_auto_repeat =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:auto_repeat_mode_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let led_mask = Decode.u32 buf in
    let key_click_percent = Decode.u8 buf in
    let bell_percent = Decode.u8 buf in
    let bell_pitch = Decode.u16 buf in
    let bell_duration = Decode.u16 buf in
    Decode.pad buf 2;
    let auto_repeats = (Decode.list ~item:Decode.u8) ~len:32 buf in
    ignore length;
    {
      global_auto_repeat;
      led_mask;
      key_click_percent;
      bell_percent;
      bell_pitch;
      bell_duration;
      auto_repeats;
    }

  type get_pointer_control_reply = {
    acceleration_numerator : u16;
    acceleration_denominator : u16;
    threshold : u16;
  }
  [@@deriving sexp]

  let decode_get_pointer_control_reply buf : get_pointer_control_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let acceleration_numerator = Decode.u16 buf in
    let acceleration_denominator = Decode.u16 buf in
    let threshold = Decode.u16 buf in
    Decode.pad buf 18;
    ignore length;
    { acceleration_numerator; acceleration_denominator; threshold }

  type blanking_enum = [ `Not_preferred | `Preferred | `Default ]
  [@@deriving sexp]

  let blanking_enum_of_int n : [ blanking_enum | int custom ] =
    match n with
    | 0 -> `Not_preferred
    | 1 -> `Preferred
    | 2 -> `Default
    | _ -> `Custom n

  type exposures_enum = [ `Not_allowed | `Allowed | `Default ] [@@deriving sexp]

  let exposures_enum_of_int n : [ exposures_enum | int custom ] =
    match n with
    | 0 -> `Not_allowed
    | 1 -> `Allowed
    | 2 -> `Default
    | _ -> `Custom n

  type get_screen_saver_reply = {
    timeout : u16;
    interval : u16;
    prefer_blanking : blanking_enum;
    allow_exposures : exposures_enum;
  }
  [@@deriving sexp]

  let decode_get_screen_saver_reply buf : get_screen_saver_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let timeout = Decode.u16 buf in
    let interval = Decode.u16 buf in
    let prefer_blanking =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:blanking_enum_of_int)
        buf
    in
    let allow_exposures =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:exposures_enum_of_int)
        buf
    in
    Decode.pad buf 18;
    ignore length;
    { timeout; interval; prefer_blanking; allow_exposures }

  type host_mode_enum = [ `Insert | `Delete ] [@@deriving sexp]

  let host_mode_enum_of_int n : [ host_mode_enum | int custom ] =
    match n with 0 -> `Insert | 1 -> `Delete | _ -> `Custom n

  type family_enum =
    [ `Internet | `Decnet | `Chaos | `Server_interpreted | `Internet6 ]
  [@@deriving sexp]

  let family_enum_of_int n : [ family_enum | int custom ] =
    match n with
    | 0 -> `Internet
    | 1 -> `Decnet
    | 2 -> `Chaos
    | 5 -> `Server_interpreted
    | 6 -> `Internet6
    | _ -> `Custom n

  type host = { family : family_enum; address : byte list } [@@deriving sexp]

  let decode_host buf : host =
    let family =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:family_enum_of_int)
        buf
    in
    Decode.pad buf 1;
    let address_len = Decode.u16 buf in
    let address = (Decode.list ~item:Decode.byte) ~len:address_len buf in
    Decode.align buf 4;
    { family; address }

  type access_control_enum = [ `Disable | `Enable ] [@@deriving sexp]

  let access_control_enum_of_int n : [ access_control_enum | int custom ] =
    match n with 0 -> `Disable | 1 -> `Enable | _ -> `Custom n

  type list_hosts_reply = { mode : access_control_enum; hosts : host list }
  [@@deriving sexp]

  let decode_list_hosts_reply buf : list_hosts_reply =
    Decode.pad buf 1;
    let mode =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:access_control_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let hosts_len = Decode.u16 buf in
    Decode.pad buf 22;
    let hosts = (Decode.list ~item:decode_host) ~len:hosts_len buf in
    ignore length;
    { mode; hosts }

  type close_down_enum = [ `Destroy_all | `Retain_permanent | `Retain_temporary ]
  [@@deriving sexp]

  let close_down_enum_of_int n : [ close_down_enum | int custom ] =
    match n with
    | 0 -> `Destroy_all
    | 1 -> `Retain_permanent
    | 2 -> `Retain_temporary
    | _ -> `Custom n

  type kill_enum = [ `All_temporary ] [@@deriving sexp]

  let kill_enum_of_int n : [ kill_enum | int custom ] =
    match n with 0 -> `All_temporary | _ -> `Custom n

  type screen_saver_enum = [ `Reset | `Active ] [@@deriving sexp]

  let screen_saver_enum_of_int n : [ screen_saver_enum | int custom ] =
    match n with 0 -> `Reset | 1 -> `Active | _ -> `Custom n

  type mapping_status_enum = [ `Success | `Busy | `Failure ] [@@deriving sexp]

  let mapping_status_enum_of_int n : [ mapping_status_enum | int custom ] =
    match n with 0 -> `Success | 1 -> `Busy | 2 -> `Failure | _ -> `Custom n

  type set_pointer_mapping_reply = mapping_status_enum [@@deriving sexp]

  let decode_set_pointer_mapping_reply buf : set_pointer_mapping_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:mapping_status_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    ignore length;
    status

  type get_pointer_mapping_reply = u8 list [@@deriving sexp]

  let decode_get_pointer_mapping_reply buf : get_pointer_mapping_reply =
    Decode.pad buf 1;
    let map_len = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    Decode.pad buf 24;
    let map = (Decode.list ~item:Decode.u8) ~len:map_len buf in
    ignore length;
    map

  type map_index_enum =
    [ `Shift | `Lock | `Control | `D1 | `D2 | `D3 | `D4 | `D5 ]
  [@@deriving sexp]

  let map_index_enum_of_int n : [ map_index_enum | int custom ] =
    match n with
    | 0 -> `Shift
    | 1 -> `Lock
    | 2 -> `Control
    | 3 -> `D1
    | 4 -> `D2
    | 5 -> `D3
    | 6 -> `D4
    | 7 -> `D5
    | _ -> `Custom n

  type set_modifier_mapping_reply = mapping_status_enum [@@deriving sexp]

  let decode_set_modifier_mapping_reply buf : set_modifier_mapping_reply =
    Decode.pad buf 1;
    let status =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:mapping_status_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    ignore length;
    status

  type get_modifier_mapping_reply = keycode list [@@deriving sexp]

  let decode_get_modifier_mapping_reply buf : get_modifier_mapping_reply =
    Decode.pad buf 1;
    let keycodes_per_modifier = Decode.u8 buf in
    let keycodes_per_modifier = keycodes_per_modifier / 8 in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    Decode.pad buf 24;
    let keycodes =
      (Decode.list ~item:decode_keycode) ~len:keycodes_per_modifier buf
    in
    ignore length;
    keycodes
end

module Render = struct
  type pict_type_enum = [ `Indexed | `Direct ] [@@deriving sexp]

