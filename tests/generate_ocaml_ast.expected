module Bigreq = struct
  type enable_reply = u32 [@@deriving sexp]

  let decode_enable_reply buf : enable_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let maximum_request_length = Decode.u32 buf in
    ignore length;
    maximum_request_length
end

module Xproto = struct
  type window = xid [@@deriving sexp]

  let decode_window = Decode.xid

  type pixmap = xid [@@deriving sexp]

  let decode_pixmap = Decode.xid

  type cursor = xid [@@deriving sexp]

  let decode_cursor = Decode.xid

  type font = xid [@@deriving sexp]

  let decode_font = Decode.xid

  type gcontext = xid [@@deriving sexp]

  let decode_gcontext = Decode.xid

  type colormap = xid [@@deriving sexp]

  let decode_colormap = Decode.xid

  type atom = xid [@@deriving sexp]

  let decode_atom = Decode.xid

  type drawable = xid [@@deriving sexp]

  let decode_drawable = Decode.xid

  type fontable = xid [@@deriving sexp]

  let decode_fontable = Decode.xid

  type bool32 = u32 [@@deriving sexp]

  let decode_bool32 = Decode.u32

  type visualid = u32 [@@deriving sexp]

  let decode_visualid = Decode.u32

  type timestamp = u32 [@@deriving sexp]

  let decode_timestamp = Decode.u32

  type keysym = u32 [@@deriving sexp]

  let decode_keysym = Decode.u32

  type keycode = u8 [@@deriving sexp]

  let decode_keycode = Decode.u8

  type keycode32 = u32 [@@deriving sexp]

  let decode_keycode32 = Decode.u32

  type button = u8 [@@deriving sexp]

  let decode_button = Decode.u8

  type point = { x : i16; y : i16 } [@@deriving sexp]

  let decode_point buf : point =
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    { x; y }

  type rectangle = { x : i16; y : i16; width : u16; height : u16 }
  [@@deriving sexp]

  let decode_rectangle buf : rectangle =
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    { x; y; width; height }

  type arc = {
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    angle1 : i16;
    angle2 : i16;
  }
  [@@deriving sexp]

  let decode_arc buf : arc =
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let angle1 = Decode.i16 buf in
    let angle2 = Decode.i16 buf in
    { x; y; width; height; angle1; angle2 }

  type format = { depth : u8; bits_per_pixel : u8; scanline_pad : u8 }
  [@@deriving sexp]

  let decode_format buf : format =
    let depth = Decode.u8 buf in
    let bits_per_pixel = Decode.u8 buf in
    let scanline_pad = Decode.u8 buf in
    Decode.pad buf 5;
    { depth; bits_per_pixel; scanline_pad }

  type visual_class_enum =
    [ `Static_gray
    | `Gray_scale
    | `Static_color
    | `Pseudo_color
    | `True_color
    | `Direct_color ]
  [@@deriving sexp]

  let visual_class_enum_of_int n : [ visual_class_enum | int custom ] =
    match n with
    | 0 -> `Static_gray
    | 1 -> `Gray_scale
    | 2 -> `Static_color
    | 3 -> `Pseudo_color
    | 4 -> `True_color
    | 5 -> `Direct_color
    | _ -> `Custom n

  type visualtype = {
    visual_id : visualid;
    class_ : visual_class_enum;
    bits_per_rgb_value : u8;
    colormap_entries : u16;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
  }
  [@@deriving sexp]

  let decode_visualtype buf : visualtype =
    let visual_id = decode_visualid buf in
    let class_ =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:visual_class_enum_of_int)
        buf
    in
    let bits_per_rgb_value = Decode.u8 buf in
    let colormap_entries = Decode.u16 buf in
    let red_mask = Decode.u32 buf in
    let green_mask = Decode.u32 buf in
    let blue_mask = Decode.u32 buf in
    Decode.pad buf 4;
    {
      visual_id;
      class_;
      bits_per_rgb_value;
      colormap_entries;
      red_mask;
      green_mask;
      blue_mask;
    }

  type depth = { depth : u8; visuals : visualtype list } [@@deriving sexp]

  let decode_depth buf : depth =
    let depth = Decode.u8 buf in
    Decode.pad buf 1;
    let visuals_len = Decode.u16 buf in
    Decode.pad buf 4;
    let visuals = (Decode.list ~item:decode_visualtype) ~len:visuals_len buf in
    { depth; visuals }

  type event_mask =
    [ `Key_press
    | `Key_release
    | `Button_press
    | `Button_release
    | `Enter_window
    | `Leave_window
    | `Pointer_motion
    | `Pointer_motion_hint
    | `Button1_motion
    | `Button2_motion
    | `Button3_motion
    | `Button4_motion
    | `Button5_motion
    | `Button_motion
    | `Keymap_state
    | `Exposure
    | `Visibility_change
    | `Structure_notify
    | `Resize_redirect
    | `Substructure_notify
    | `Substructure_redirect
    | `Focus_change
    | `Property_change
    | `Color_map_change
    | `Owner_grab_button ]
    list
  [@@deriving sexp]

  type backing_store_enum = [ `Not_useful | `When_mapped | `Always ]
  [@@deriving sexp]

  let backing_store_enum_of_int n : [ backing_store_enum | int custom ] =
    match n with
    | 0 -> `Not_useful
    | 1 -> `When_mapped
    | 2 -> `Always
    | _ -> `Custom n

  type screen = {
    root : window;
    default_colormap : colormap;
    white_pixel : u32;
    black_pixel : u32;
    current_input_masks : event_mask;
    width_in_pixels : u16;
    height_in_pixels : u16;
    width_in_millimeters : u16;
    height_in_millimeters : u16;
    min_installed_maps : u16;
    max_installed_maps : u16;
    root_visual : visualid;
    backing_stores : backing_store_enum;
    save_unders : bool;
    root_depth : u8;
    allowed_depths : depth list;
  }
  [@@deriving sexp]

  let decode_screen buf : screen =
    let root = decode_window buf in
    let default_colormap = decode_colormap buf in
    let white_pixel = Decode.u32 buf in
    let black_pixel = Decode.u32 buf in
    let current_input_masks =
      (Decode.mask Decode.u32 Int64.of_int event_mask_mask_of_int64) buf
    in
    let width_in_pixels = Decode.u16 buf in
    let height_in_pixels = Decode.u16 buf in
    let width_in_millimeters = Decode.u16 buf in
    let height_in_millimeters = Decode.u16 buf in
    let min_installed_maps = Decode.u16 buf in
    let max_installed_maps = Decode.u16 buf in
    let root_visual = decode_visualid buf in
    let backing_stores =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:backing_store_enum_of_int)
        buf
    in
    let save_unders = Decode.bool buf in
    let root_depth = Decode.u8 buf in
    let allowed_depths_len = Decode.u8 buf in
    let allowed_depths =
      (Decode.list ~item:decode_depth) ~len:allowed_depths_len buf
    in
    {
      root;
      default_colormap;
      white_pixel;
      black_pixel;
      current_input_masks;
      width_in_pixels;
      height_in_pixels;
      width_in_millimeters;
      height_in_millimeters;
      min_installed_maps;
      max_installed_maps;
      root_visual;
      backing_stores;
      save_unders;
      root_depth;
      allowed_depths;
    }

  type setup_request = {
    byte_order : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    authorization_protocol_name : string;
    authorization_protocol_data : string;
  }
  [@@deriving sexp]

  let decode_setup_request buf : setup_request =
    let byte_order = Decode.u8 buf in
    Decode.pad buf 1;
    let protocol_major_version = Decode.u16 buf in
    let protocol_minor_version = Decode.u16 buf in
    let authorization_protocol_name_len = Decode.u16 buf in
    let authorization_protocol_data_len = Decode.u16 buf in
    Decode.pad buf 2;
    let authorization_protocol_name =
      Decode.string ~len:authorization_protocol_name_len buf
    in
    Decode.align buf 4;
    let authorization_protocol_data =
      Decode.string ~len:authorization_protocol_data_len buf
    in
    Decode.align buf 4;
    {
      byte_order;
      protocol_major_version;
      protocol_minor_version;
      authorization_protocol_name;
      authorization_protocol_data;
    }

  type setup_failed = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    reason : string;
  }
  [@@deriving sexp]

  let decode_setup_failed buf : setup_failed =
    let status = Decode.u8 buf in
    let reason_len = Decode.u8 buf in
    let protocol_major_version = Decode.u16 buf in
    let protocol_minor_version = Decode.u16 buf in
    let length = Decode.u16 buf in
    let reason = Decode.string ~len:reason_len buf in
    { status; protocol_major_version; protocol_minor_version; length; reason }

  type setup_authenticate = { status : u8; reason : string } [@@deriving sexp]

  let decode_setup_authenticate buf : setup_authenticate =
    let status = Decode.u8 buf in
    Decode.pad buf 5;
    let length = Decode.u16 buf in
    let length = length / 4 in
    let reason = Decode.string ~len:length buf in
    { status; reason }

  type image_order_enum = [ `Lsb_first | `Msb_first ] [@@deriving sexp]

  let image_order_enum_of_int n : [ image_order_enum | int custom ] =
    match n with 0 -> `Lsb_first | 1 -> `Msb_first | _ -> `Custom n

  type setup = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    release_number : u32;
    resource_id_base : u32;
    resource_id_mask : u32;
    motion_buffer_size : u32;
    maximum_request_length : u16;
    image_byte_order : image_order_enum;
    bitmap_format_bit_order : image_order_enum;
    bitmap_format_scanline_unit : u8;
    bitmap_format_scanline_pad : u8;
    min_keycode : keycode;
    max_keycode : keycode;
    vendor : string;
    pixmap_formats : format list;
    roots : screen list;
  }
  [@@deriving sexp]

  let decode_setup buf : setup =
    let status = Decode.u8 buf in
    Decode.pad buf 1;
    let protocol_major_version = Decode.u16 buf in
    let protocol_minor_version = Decode.u16 buf in
    let length = Decode.u16 buf in
    let release_number = Decode.u32 buf in
    let resource_id_base = Decode.u32 buf in
    let resource_id_mask = Decode.u32 buf in
    let motion_buffer_size = Decode.u32 buf in
    let vendor_len = Decode.u16 buf in
    let maximum_request_length = Decode.u16 buf in
    let roots_len = Decode.u8 buf in
    let pixmap_formats_len = Decode.u8 buf in
    let image_byte_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_order_enum_of_int)
        buf
    in
    let bitmap_format_bit_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_order_enum_of_int)
        buf
    in
    let bitmap_format_scanline_unit = Decode.u8 buf in
    let bitmap_format_scanline_pad = Decode.u8 buf in
    let min_keycode = decode_keycode buf in
    let max_keycode = decode_keycode buf in
    Decode.pad buf 4;
    let vendor = Decode.string ~len:vendor_len buf in
    Decode.align buf 4;
    let pixmap_formats =
      (Decode.list ~item:decode_format) ~len:pixmap_formats_len buf
    in
    let roots = (Decode.list ~item:decode_screen) ~len:roots_len buf in
    {
      status;
      protocol_major_version;
      protocol_minor_version;
      length;
      release_number;
      resource_id_base;
      resource_id_mask;
      motion_buffer_size;
      maximum_request_length;
      image_byte_order;
      bitmap_format_bit_order;
      bitmap_format_scanline_unit;
      bitmap_format_scanline_pad;
      min_keycode;
      max_keycode;
      vendor;
      pixmap_formats;
      roots;
    }

  type mod_mask =
    [ `Shift | `Lock | `Control | `D1 | `D2 | `D3 | `D4 | `D5 | `Any ] list
  [@@deriving sexp]

  type key_but_mask =
    [ `Shift
    | `Lock
    | `Control
    | `Mod1
    | `Mod2
    | `Mod3
    | `Mod4
    | `Mod5
    | `Button1
    | `Button2
    | `Button3
    | `Button4
    | `Button5 ]
    list
  [@@deriving sexp]

  type window_enum = [ `None ] [@@deriving sexp]

  let window_enum_of_int n : [ window_enum | int custom ] =
    match n with 0 -> `None | _ -> `Custom n

  type key_press_event = {
    detail : keycode;
    time : timestamp;
    root : window;
    event : window;
    child : [ window_enum | window custom ];
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    same_screen : bool;
  }
  [@@deriving sexp]

  let decode_key_press_event buf : key_press_event =
    Decode.pad buf 1;
    let detail = decode_keycode buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let time = decode_timestamp buf in
    let root = decode_window buf in
    let event = decode_window buf in
    let child =
      (Decode.alt_enum decode_window identity window_enum_of_int) buf
    in
    let root_x = Decode.i16 buf in
    let root_y = Decode.i16 buf in
    let event_x = Decode.i16 buf in
    let event_y = Decode.i16 buf in
    let state =
      (Decode.mask Decode.u16 Int64.of_int key_but_mask_mask_of_int64) buf
    in
    let same_screen = Decode.bool buf in
    Decode.pad buf 1;
    ignore length;
    {
      detail;
      time;
      root;
      event;
      child;
      root_x;
      root_y;
      event_x;
      event_y;
      state;
      same_screen;
    }

  type key_release_event = key_press_event [@@deriving sexp]

  let decode_key_release_event = decode_key_press_event

  type button_mask = [ `D1 | `D2 | `D3 | `D4 | `D5 | `Any ] list
  [@@deriving sexp]

  type button_press_event = {
    detail : button;
    time : timestamp;
    root : window;
    event : window;
    child : [ window_enum | window custom ];
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    same_screen : bool;
  }
  [@@deriving sexp]

  let decode_button_press_event buf : button_press_event =
    Decode.pad buf 1;
    let detail = decode_button buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let time = decode_timestamp buf in
    let root = decode_window buf in
    let event = decode_window buf in
    let child =
      (Decode.alt_enum decode_window identity window_enum_of_int) buf
    in
    let root_x = Decode.i16 buf in
    let root_y = Decode.i16 buf in
    let event_x = Decode.i16 buf in
    let event_y = Decode.i16 buf in
    let state =
      (Decode.mask Decode.u16 Int64.of_int key_but_mask_mask_of_int64) buf
    in
    let same_screen = Decode.bool buf in
    Decode.pad buf 1;
    ignore length;
    {
      detail;
      time;
      root;
      event;
      child;
      root_x;
      root_y;
      event_x;
      event_y;
      state;
      same_screen;
    }

  type button_release_event = button_press_event [@@deriving sexp]

  let decode_button_release_event = decode_button_press_event

  type motion_enum = [ `Normal | `Hint ] [@@deriving sexp]

  let motion_enum_of_int n : [ motion_enum | int custom ] =
    match n with 0 -> `Normal | 1 -> `Hint | _ -> `Custom n

  type motion_notify_event = {
    detail : motion_enum;
    time : timestamp;
    root : window;
    event : window;
    child : [ window_enum | window custom ];
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    same_screen : bool;
  }
  [@@deriving sexp]

  let decode_motion_notify_event buf : motion_notify_event =
    Decode.pad buf 1;
    let detail =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:motion_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let time = decode_timestamp buf in
    let root = decode_window buf in
    let event = decode_window buf in
    let child =
      (Decode.alt_enum decode_window identity window_enum_of_int) buf
    in
    let root_x = Decode.i16 buf in
    let root_y = Decode.i16 buf in
    let event_x = Decode.i16 buf in
    let event_y = Decode.i16 buf in
    let state =
      (Decode.mask Decode.u16 Int64.of_int key_but_mask_mask_of_int64) buf
    in
    let same_screen = Decode.bool buf in
    Decode.pad buf 1;
    ignore length;
    {
      detail;
      time;
      root;
      event;
      child;
      root_x;
      root_y;
      event_x;
      event_y;
      state;
      same_screen;
    }

  type notify_detail_enum =
    [ `Ancestor
    | `Virtual
    | `Inferior
    | `Nonlinear
    | `Nonlinear_virtual
    | `Pointer
    | `Pointer_root
    | `None ]
  [@@deriving sexp]

  let notify_detail_enum_of_int n : [ notify_detail_enum | int custom ] =
    match n with
    | 0 -> `Ancestor
    | 1 -> `Virtual
    | 2 -> `Inferior
    | 3 -> `Nonlinear
    | 4 -> `Nonlinear_virtual
    | 5 -> `Pointer
    | 6 -> `Pointer_root
    | 7 -> `None
    | _ -> `Custom n

  type notify_mode_enum = [ `Normal | `Grab | `Ungrab | `While_grabbed ]
  [@@deriving sexp]

  let notify_mode_enum_of_int n : [ notify_mode_enum | int custom ] =
    match n with
    | 0 -> `Normal
    | 1 -> `Grab
    | 2 -> `Ungrab
    | 3 -> `While_grabbed
    | _ -> `Custom n

  type enter_notify_event = {
    detail : notify_detail_enum;
    time : timestamp;
    root : window;
    event : window;
    child : [ window_enum | window custom ];
    root_x : i16;
    root_y : i16;
    event_x : i16;
    event_y : i16;
    state : key_but_mask;
    mode : notify_mode_enum;
    same_screen_focus : byte;
  }
  [@@deriving sexp]

  let decode_enter_notify_event buf : enter_notify_event =
    Decode.pad buf 1;
    let detail =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:notify_detail_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let time = decode_timestamp buf in
    let root = decode_window buf in
    let event = decode_window buf in
    let child =
      (Decode.alt_enum decode_window identity window_enum_of_int) buf
    in
    let root_x = Decode.i16 buf in
    let root_y = Decode.i16 buf in
    let event_x = Decode.i16 buf in
    let event_y = Decode.i16 buf in
    let state =
      (Decode.mask Decode.u16 Int64.of_int key_but_mask_mask_of_int64) buf
    in
    let mode =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:notify_mode_enum_of_int)
        buf
    in
    let same_screen_focus = Decode.byte buf in
    ignore length;
    {
      detail;
      time;
      root;
      event;
      child;
      root_x;
      root_y;
      event_x;
      event_y;
      state;
      mode;
      same_screen_focus;
    }

  type leave_notify_event = enter_notify_event [@@deriving sexp]

  let decode_leave_notify_event = decode_enter_notify_event

  type focus_in_event = {
    detail : notify_detail_enum;
    event : window;
    mode : notify_mode_enum;
  }
  [@@deriving sexp]

  let decode_focus_in_event buf : focus_in_event =
    Decode.pad buf 1;
    let detail =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:notify_detail_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let event = decode_window buf in
    let mode =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:notify_mode_enum_of_int)
        buf
    in
    Decode.pad buf 3;
    ignore length;
    { detail; event; mode }

  type focus_out_event = focus_in_event [@@deriving sexp]

  let decode_focus_out_event = decode_focus_in_event

  type keymap_notify_event = u8 list [@@deriving sexp]

  let decode_keymap_notify_event buf : keymap_notify_event =
    Decode.pad buf 1;
    let keys = (Decode.list ~item:Decode.u8) ~len:31 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    ignore length;
    keys

  type expose_event = {
    window : window;
    x : u16;
    y : u16;
    width : u16;
    height : u16;
    count : u16;
  }
  [@@deriving sexp]

  let decode_expose_event buf : expose_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let window = decode_window buf in
    let x = Decode.u16 buf in
    let y = Decode.u16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let count = Decode.u16 buf in
    Decode.pad buf 2;
    ignore length;
    { window; x; y; width; height; count }

  type graphics_exposure_event = {
    drawable : drawable;
    x : u16;
    y : u16;
    width : u16;
    height : u16;
    minor_opcode : u16;
    count : u16;
    major_opcode : u8;
  }
  [@@deriving sexp]

  let decode_graphics_exposure_event buf : graphics_exposure_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let drawable = decode_drawable buf in
    let x = Decode.u16 buf in
    let y = Decode.u16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let minor_opcode = Decode.u16 buf in
    let count = Decode.u16 buf in
    let major_opcode = Decode.u8 buf in
    Decode.pad buf 3;
    ignore length;
    { drawable; x; y; width; height; minor_opcode; count; major_opcode }

  type no_exposure_event = {
    drawable : drawable;
    minor_opcode : u16;
    major_opcode : u8;
  }
  [@@deriving sexp]

  let decode_no_exposure_event buf : no_exposure_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let drawable = decode_drawable buf in
    let minor_opcode = Decode.u16 buf in
