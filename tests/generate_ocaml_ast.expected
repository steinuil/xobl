  type client_message_data_format_enum = [ `Data8 | `Data16 | `Data32 ]
  [@@deriving sexp]

  let client_message_data_format_enum_of_int n :
      [ client_message_data_format_enum | int custom ] =
    match n with 8 -> `Data8 | 16 -> `Data16 | 32 -> `Data32 | _ -> `Custom n

  type client_message_data_format_variant =
    | Data8 of u8 list
    | Data16 of u16 list
    | Data32 of u32 list
  [@@deriving sexp]

  let decode_client_message_data_format_variant buf ~tag :
      client_message_data_format_variant =
    match tag with
    | 8 ->
        let data8 = (Decode.list ~item:Decode.u8) ~len:20 buf in
        Data8 data8
    | 16 ->
        let data16 = (Decode.list ~item:Decode.u16) ~len:10 buf in
        Data16 data16
    | 32 ->
        let data32 = (Decode.list ~item:Decode.u32) ~len:5 buf in
        Data32 data32

  type client_message_event = {
    window : window;
    type_ : atom;
    data : client_message_data_format_variant;
  }
  [@@deriving sexp]

  let decode_client_message_event buf : client_message_event =
    Decode.pad buf 1;
    let data_tag = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let window = decode_window buf in
    let type_ = decode_atom buf in
    let data = decode_client_message_data_format_variant ~tag:data_tag buf in
    ignore length;
    { window; type_; data }

