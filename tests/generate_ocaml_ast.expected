end

module Xf86dri = struct
  type drm_clip_rect = { x1 : i16; y1 : i16; x2 : i16; x3 : i16 }
  [@@deriving sexp]

  let decode_drm_clip_rect buf : drm_clip_rect =
    let x1 = Decode.i16 buf in
    let y1 = Decode.i16 buf in
    let x2 = Decode.i16 buf in
    let x3 = Decode.i16 buf in
    ()

  type query_version_reply = {
    dri_major_version : u16;
    dri_minor_version : u16;
    dri_minor_patch : u32;
  }
  [@@deriving sexp]

  type query_direct_rendering_capable_reply = bool [@@deriving sexp]

  type open_connection_reply = {
    sarea_handle_low : u32;
    sarea_handle_high : u32;
    bus_id : string;
  }
  [@@deriving sexp]

  type get_client_driver_name_reply = {
