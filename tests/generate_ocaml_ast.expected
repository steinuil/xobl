    minor_version : u16;
    uid : u16;
    gid : u16;
    pixmap_format : u8;
  }
  [@@deriving sexp]

  type get_image_reply = { depth : u8; visual : Xproto.visualid; size : u32 }
  [@@deriving sexp]

  type create_segment_reply = { nfd : u8; shm_fd : file_descr }
  [@@deriving sexp]
end

module Xc_misc = struct
