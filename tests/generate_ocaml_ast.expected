    let new_mode = Decode.u32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.u32) ~len:n buf in
    ignore length;
    { ret_val; new_mode; data }

  type rm_enum = [ `Gl_render | `Gl_feedback | `Gl_select ] [@@deriving sexp]

  let rm_enum_of_int n : [ rm_enum | int custom ] =
    match n with
    | 7168 -> `Gl_render
    | 7169 -> `Gl_feedback
    | 7170 -> `Gl_select
    | _ -> `Custom n

