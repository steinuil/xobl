    | 18 -> `Disjoint_dst
    | 19 -> `Disjoint_over
    | 20 -> `Disjoint_over_reverse
    | 21 -> `Disjoint_in
    | 22 -> `Disjoint_in_reverse
    | 23 -> `Disjoint_out
    | 24 -> `Disjoint_out_reverse
    | 25 -> `Disjoint_atop
    | 26 -> `Disjoint_atop_reverse
    | 27 -> `Disjoint_xor
    | 32 -> `Conjoint_clear
    | 33 -> `Conjoint_src
    | 34 -> `Conjoint_dst
    | 35 -> `Conjoint_over
    | 36 -> `Conjoint_over_reverse
    | 37 -> `Conjoint_in
    | 38 -> `Conjoint_in_reverse
    | 39 -> `Conjoint_out
    | 40 -> `Conjoint_out_reverse
    | 41 -> `Conjoint_atop
    | 42 -> `Conjoint_atop_reverse
