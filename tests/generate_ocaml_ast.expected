    len : u16;
    sourceid : device_id;
    data : device_class_type_variant;
  }
  [@@deriving sexp]

  let decode_device_class buf : device_class =
    let data_tag = Decode.u16 buf in
    let len = Decode.u16 buf in
    let sourceid = decode_device_id buf in
    let data = decode_device_class_type_variant ~tag:data_tag buf in
    { len; sourceid; data }

  type xi_device_info = {
    deviceid : [ device_enum | device_id custom ];
    type_ : device_type_enum;
    attachment : [ device_enum | device_id custom ];
    enabled : bool;
    name : string;
    classes : device_class list;
  }
  [@@deriving sexp]

  let decode_xi_device_info buf : xi_device_info =
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_type_enum_of_int)
        buf
    in
    let attachment =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let num_classes = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    let enabled = Decode.bool buf in
    Decode.pad buf 1;
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    let classes =
      (Decode.list ~item:decode_device_class) ~len:num_classes buf
    in
    { deviceid; type_; attachment; enabled; name; classes }

