module Damage = struct
  type damage = xid [@@deriving sexp]

  let decode_damage = Decode.xid

  type report_level_enum =
    [ `Raw_rectangles | `Delta_rectangles | `Bounding_box | `Non_empty ]
  [@@deriving sexp]

  let report_level_enum_of_int n : [ report_level_enum | int custom ] =
    match n with
    | 0 -> `Raw_rectangles
    | 1 -> `Delta_rectangles
    | 2 -> `Bounding_box
    | 3 -> `Non_empty
    | _ -> `Custom n

  type bad_damage_error = unit [@@deriving sexp]

  let decode_bad_damage_error _ : bad_damage_error = Decode.pad 32

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    { major_version; minor_version }

  type notify_event = {
    level : report_level_enum;
    drawable : Xproto.drawable;
    damage : damage;
    timestamp : Xproto.timestamp;
    area : Xproto.rectangle;
    geometry : Xproto.rectangle;
  }
  [@@deriving sexp]

  let decode_notify_event buf : notify_event =
    Decode.pad buf 1;
    let level =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:report_level_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let drawable = Xproto.decode_drawable buf in
    let damage = decode_damage buf in
    let timestamp = Xproto.decode_timestamp buf in
    let area = Xproto.decode_rectangle buf in
    let geometry = Xproto.decode_rectangle buf in
    ignore length;
    { level; drawable; damage; timestamp; area; geometry }
end

module Dpms = struct
  type get_version_reply = {
    server_major_version : u16;
    server_minor_version : u16;
  }
  [@@deriving sexp]

  let decode_get_version_reply buf : get_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let server_major_version = Decode.u16 buf in
    let server_minor_version = Decode.u16 buf in
    ignore length;
    { server_major_version; server_minor_version }

  type capable_reply = bool [@@deriving sexp]

  let decode_capable_reply buf : capable_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let capable = Decode.bool buf in
    Decode.pad buf 23;
    ignore length;
    capable

  type get_timeouts_reply = {
    standby_timeout : u16;
    suspend_timeout : u16;
    off_timeout : u16;
  }
  [@@deriving sexp]

  let decode_get_timeouts_reply buf : get_timeouts_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let standby_timeout = Decode.u16 buf in
    let suspend_timeout = Decode.u16 buf in
    let off_timeout = Decode.u16 buf in
    Decode.pad buf 18;
    ignore length;
    { standby_timeout; suspend_timeout; off_timeout }

  type dpms_mode_enum = [ `On | `Standby | `Suspend | `Off ] [@@deriving sexp]

  let dpms_mode_enum_of_int n : [ dpms_mode_enum | int custom ] =
    match n with
    | 0 -> `On
    | 1 -> `Standby
    | 2 -> `Suspend
    | 3 -> `Off
    | _ -> `Custom n

  type info_reply = { power_level : dpms_mode_enum; state : bool }
  [@@deriving sexp]

  let decode_info_reply buf : info_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let power_level =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:dpms_mode_enum_of_int)
        buf
    in
    let state = Decode.bool buf in
    Decode.pad buf 21;
    ignore length;
    { power_level; state }
end

module Dri2 = struct
  type attachment_enum =
    [ `Buffer_front_left
    | `Buffer_back_left
    | `Buffer_front_right
    | `Buffer_back_right
    | `Buffer_depth
    | `Buffer_stencil
    | `Buffer_accum
    | `Buffer_fake_front_left
    | `Buffer_fake_front_right
    | `Buffer_depth_stencil
    | `Buffer_hiz ]
  [@@deriving sexp]

  let attachment_enum_of_int n : [ attachment_enum | int custom ] =
    match n with
    | 0 -> `Buffer_front_left
    | 1 -> `Buffer_back_left
    | 2 -> `Buffer_front_right
    | 3 -> `Buffer_back_right
    | 4 -> `Buffer_depth
    | 5 -> `Buffer_stencil
    | 6 -> `Buffer_accum
    | 7 -> `Buffer_fake_front_left
    | 8 -> `Buffer_fake_front_right
    | 9 -> `Buffer_depth_stencil
    | 10 -> `Buffer_hiz
    | _ -> `Custom n

  type driver_type_enum = [ `Dri | `Vdpau ] [@@deriving sexp]

  let driver_type_enum_of_int n : [ driver_type_enum | int custom ] =
    match n with 0 -> `Dri | 1 -> `Vdpau | _ -> `Custom n

  type event_type_enum = [ `Exchange_complete | `Blit_complete | `Flip_complete ]
  [@@deriving sexp]

  let event_type_enum_of_int n : [ event_type_enum | int custom ] =
    match n with
    | 1 -> `Exchange_complete
    | 2 -> `Blit_complete
    | 3 -> `Flip_complete
    | _ -> `Custom n

  type dri2_buffer = {
    attachment : attachment_enum;
    name : u32;
    pitch : u32;
    cpp : u32;
    flags : u32;
  }
  [@@deriving sexp]

  let decode_dri2_buffer buf : dri2_buffer =
    let attachment =
      (Decode.enum ~decode:Decode.u32 ~int_of_t:identity
         ~enum_of_int:attachment_enum_of_int)
        buf
    in
    let name = Decode.u32 buf in
    let pitch = Decode.u32 buf in
    let cpp = Decode.u32 buf in
    let flags = Decode.u32 buf in
    { attachment; name; pitch; cpp; flags }

  type attach_format = { attachment : attachment_enum; format : u32 }
  [@@deriving sexp]

  let decode_attach_format buf : attach_format =
    let attachment =
      (Decode.enum ~decode:Decode.u32 ~int_of_t:identity
         ~enum_of_int:attachment_enum_of_int)
        buf
    in
    let format = Decode.u32 buf in
    { attachment; format }

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    ignore length;
    { major_version; minor_version }

  type connect_reply = {
    driver_name : string;
    alignment_pad : string;
    device_name : string;
  }
  [@@deriving sexp]

  let decode_connect_reply buf : connect_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let driver_name_length = Decode.u32 buf in
    let device_name_length = Decode.u32 buf in
    Decode.pad buf 16;
    let driver_name = Decode.string ~len:driver_name_length buf in
    let alignment_pad =
      Decode.string
        ~len:(((driver_name_length + 3) land lnot 3) - driver_name_length)
        buf
    in
    let device_name = Decode.string ~len:device_name_length buf in
    ignore length;
    { driver_name; alignment_pad; device_name }

  type authenticate_reply = u32 [@@deriving sexp]

  let decode_authenticate_reply buf : authenticate_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let authenticated = Decode.u32 buf in
    ignore length;
    authenticated

  type get_buffers_reply = {
    width : u32;
    height : u32;
    buffers : dri2_buffer list;
  }
  [@@deriving sexp]

  let decode_get_buffers_reply buf : get_buffers_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let width = Decode.u32 buf in
    let height = Decode.u32 buf in
    let count = Decode.u32 buf in
    Decode.pad buf 12;
    let buffers = (Decode.list ~item:decode_dri2_buffer) ~len:count buf in
    ignore length;
    { width; height; buffers }

  type copy_region_reply = unit [@@deriving sexp]

  let decode_copy_region_reply _ : copy_region_reply = Decode.pad 32

  type get_buffers_with_format_reply = {
    width : u32;
    height : u32;
    buffers : dri2_buffer list;
  }
  [@@deriving sexp]

  let decode_get_buffers_with_format_reply buf : get_buffers_with_format_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let width = Decode.u32 buf in
    let height = Decode.u32 buf in
    let count = Decode.u32 buf in
    Decode.pad buf 12;
    let buffers = (Decode.list ~item:decode_dri2_buffer) ~len:count buf in
    ignore length;
    { width; height; buffers }

  type swap_buffers_reply = { swap_hi : u32; swap_lo : u32 } [@@deriving sexp]

  let decode_swap_buffers_reply buf : swap_buffers_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let swap_hi = Decode.u32 buf in
    let swap_lo = Decode.u32 buf in
    ignore length;
    { swap_hi; swap_lo }

  type get_msc_reply = {
    ust_hi : u32;
    ust_lo : u32;
    msc_hi : u32;
    msc_lo : u32;
    sbc_hi : u32;
    sbc_lo : u32;
  }
  [@@deriving sexp]

  let decode_get_msc_reply buf : get_msc_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let ust_hi = Decode.u32 buf in
    let ust_lo = Decode.u32 buf in
    let msc_hi = Decode.u32 buf in
    let msc_lo = Decode.u32 buf in
    let sbc_hi = Decode.u32 buf in
    let sbc_lo = Decode.u32 buf in
    ignore length;
    { ust_hi; ust_lo; msc_hi; msc_lo; sbc_hi; sbc_lo }

  type wait_msc_reply = {
    ust_hi : u32;
    ust_lo : u32;
    msc_hi : u32;
    msc_lo : u32;
    sbc_hi : u32;
    sbc_lo : u32;
  }
  [@@deriving sexp]

  let decode_wait_msc_reply buf : wait_msc_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let ust_hi = Decode.u32 buf in
    let ust_lo = Decode.u32 buf in
    let msc_hi = Decode.u32 buf in
    let msc_lo = Decode.u32 buf in
    let sbc_hi = Decode.u32 buf in
    let sbc_lo = Decode.u32 buf in
    ignore length;
    { ust_hi; ust_lo; msc_hi; msc_lo; sbc_hi; sbc_lo }

  type wait_sbc_reply = {
    ust_hi : u32;
    ust_lo : u32;
    msc_hi : u32;
    msc_lo : u32;
    sbc_hi : u32;
    sbc_lo : u32;
  }
  [@@deriving sexp]

  let decode_wait_sbc_reply buf : wait_sbc_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let ust_hi = Decode.u32 buf in
    let ust_lo = Decode.u32 buf in
    let msc_hi = Decode.u32 buf in
    let msc_lo = Decode.u32 buf in
    let sbc_hi = Decode.u32 buf in
    let sbc_lo = Decode.u32 buf in
    ignore length;
    { ust_hi; ust_lo; msc_hi; msc_lo; sbc_hi; sbc_lo }

  type get_param_reply = {
    is_param_recognized : bool;
    value_hi : u32;
    value_lo : u32;
  }
  [@@deriving sexp]

  let decode_get_param_reply buf : get_param_reply =
    Decode.pad buf 1;
    let is_param_recognized = Decode.bool buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let value_hi = Decode.u32 buf in
    let value_lo = Decode.u32 buf in
    ignore length;
    { is_param_recognized; value_hi; value_lo }

  type buffer_swap_complete_event = {
    event_type : event_type_enum;
    drawable : Xproto.drawable;
    ust_hi : u32;
    ust_lo : u32;
    msc_hi : u32;
    msc_lo : u32;
    sbc : u32;
  }
  [@@deriving sexp]

  let decode_buffer_swap_complete_event buf : buffer_swap_complete_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let event_type =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:event_type_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let drawable = Xproto.decode_drawable buf in
    let ust_hi = Decode.u32 buf in
    let ust_lo = Decode.u32 buf in
    let msc_hi = Decode.u32 buf in
    let msc_lo = Decode.u32 buf in
    let sbc = Decode.u32 buf in
    ignore length;
    { event_type; drawable; ust_hi; ust_lo; msc_hi; msc_lo; sbc }

  type invalidate_buffers_event = Xproto.drawable [@@deriving sexp]

  let decode_invalidate_buffers_event buf : invalidate_buffers_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let drawable = Xproto.decode_drawable buf in
    ignore length;
    drawable
end

module Dri3 = struct
  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    ignore length;
    { major_version; minor_version }

  type open_reply = { nfd : u8; device_fd : file_descr } [@@deriving sexp]

  let decode_open_reply buf : open_reply =
    Decode.pad buf 1;
    let nfd = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let device_fd = Decode.file_descr buf in
    Decode.pad buf 24;
    ignore length;
    { nfd; device_fd }

  type buffer_from_pixmap_reply = {
    nfd : u8;
    size : u32;
    width : u16;
    height : u16;
    stride : u16;
    depth : u8;
    bpp : u8;
    pixmap_fd : file_descr;
  }
  [@@deriving sexp]

  let decode_buffer_from_pixmap_reply buf : buffer_from_pixmap_reply =
    Decode.pad buf 1;
    let nfd = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let size = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let stride = Decode.u16 buf in
    let depth = Decode.u8 buf in
    let bpp = Decode.u8 buf in
    let pixmap_fd = Decode.file_descr buf in
    Decode.pad buf 12;
    ignore length;
    { nfd; size; width; height; stride; depth; bpp; pixmap_fd }

  type fd_from_fence_reply = { nfd : u8; fence_fd : file_descr }
  [@@deriving sexp]

  let decode_fd_from_fence_reply buf : fd_from_fence_reply =
    Decode.pad buf 1;
    let nfd = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let fence_fd = Decode.file_descr buf in
    Decode.pad buf 24;
    ignore length;
    { nfd; fence_fd }

  type get_supported_modifiers_reply = {
    window_modifiers : u64 list;
    screen_modifiers : u64 list;
  }
  [@@deriving sexp]

  let decode_get_supported_modifiers_reply buf : get_supported_modifiers_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_window_modifiers = Decode.u32 buf in
    let num_screen_modifiers = Decode.u32 buf in
    Decode.pad buf 16;
    let window_modifiers =
      (Decode.list ~item:Decode.u64) ~len:num_window_modifiers buf
    in
    let screen_modifiers =
      (Decode.list ~item:Decode.u64) ~len:num_screen_modifiers buf
    in
    ignore length;
    { window_modifiers; screen_modifiers }

  type buffers_from_pixmap_reply = {
    width : u16;
    height : u16;
    modifier : u64;
    depth : u8;
    bpp : u8;
    strides : u32 list;
    offsets : u32 list;
    buffers : file_descr list;
  }
  [@@deriving sexp]

  let decode_buffers_from_pixmap_reply buf : buffers_from_pixmap_reply =
    Decode.pad buf 1;
    let nfd = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    Decode.pad buf 4;
    let modifier = Decode.u64 buf in
    let depth = Decode.u8 buf in
    let bpp = Decode.u8 buf in
    Decode.pad buf 6;
    let strides = (Decode.list ~item:Decode.u32) ~len:nfd buf in
    let offsets = (Decode.list ~item:Decode.u32) ~len:nfd buf in
    let buffers = (Decode.list ~item:Decode.file_descr) ~len:nfd buf in
    ignore length;
    { width; height; modifier; depth; bpp; strides; offsets; buffers }
end

