  [@@deriving sexp]

  let decode_notify_event buf : notify_event =
    Decode.pad buf 1;
    let detail = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let context = decode_pcontext buf in
    let cancel = Decode.bool buf in
    ignore length;
    { detail; context; cancel }

  type attribut_notify_event = { detail : u8; context : pcontext }
  [@@deriving sexp]

  let decode_attribut_notify_event buf : attribut_notify_event =
    Decode.pad buf 1;
    let detail = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let context = decode_pcontext buf in
    ignore length;
