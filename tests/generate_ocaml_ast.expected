  let decode_get_window_create_context_reply buf :
      get_window_create_context_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let context_len = Decode.u32 buf in
    Decode.pad buf 20;
    let context = Decode.string ~len:context_len buf in
    ignore length;
    context

  type get_window_context_reply = string [@@deriving sexp]

  let decode_get_window_context_reply buf : get_window_context_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let context_len = Decode.u32 buf in
    Decode.pad buf 20;
    let context = Decode.string ~len:context_len buf in
    ignore length;
    context

  type list_item = {
    name : Xproto.atom;
    object_context : string;
    data_context : string;
  }
  [@@deriving sexp]

  let decode_list_item buf : list_item =
    let name = Xproto.decode_atom buf in
    let object_context_len = Decode.u32 buf in
    let data_context_len = Decode.u32 buf in
    let object_context = Decode.string ~len:object_context_len buf in
    Decode.align buf 4;
    let data_context = Decode.string ~len:data_context_len buf in
    Decode.align buf 4;
    { name; object_context; data_context }

  type get_property_create_context_reply = string [@@deriving sexp]

