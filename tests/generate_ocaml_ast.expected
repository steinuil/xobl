  type get_property_reply = {
    format : u8;
    type_ : atom;
    bytes_after : u32;
    value_len : u32;
    value : string;
  }
  [@@deriving sexp]

  let decode_get_property_reply buf : get_property_reply =
    Decode.pad buf 1;
    let format = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let type_ = decode_atom buf in
    let bytes_after = Decode.u32 buf in
    let value_len = Decode.u32 buf in
    Decode.pad buf 12;
    let value = Decode.string ~len:(value_len * (format / 8)) buf in
    ignore length;
    { format; type_; bytes_after; value_len; value }

