module Xprint = struct
  type string8 = char [@@deriving sexp]

  let decode_string8 = Decode.char

  type printer = { name : string; description : string } [@@deriving sexp]

  let decode_printer buf : printer =
    let name_len = Decode.u32 buf in
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    let desc_len = Decode.u32 buf in
    let description = Decode.string ~len:desc_len buf in
    Decode.align buf 4;
    ()

  type pcontext = xid [@@deriving sexp]

  let decode_pcontext = Decode.xid

  type get_doc_enum = [ `Finished | `Second_consumer ] [@@deriving sexp]
  type ev_mask = [ `Print_mask | `Attribute_mask ] list [@@deriving sexp]

  type detail_enum =
    [ `Start_job_notify
    | `End_job_notify
    | `Start_doc_notify
    | `End_doc_notify
    | `Start_page_notify
    | `End_page_notify ]
  [@@deriving sexp]

  type attr_enum =
    [ `Job_attr
    | `Doc_attr
    | `Page_attr
    | `Printer_attr
    | `Server_attr
    | `Medium_attr
    | `Spooler_attr ]
  [@@deriving sexp]

  type print_query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  type print_get_printer_list_reply = printer list [@@deriving sexp]
  type print_get_context_reply = u32 [@@deriving sexp]
  type print_get_screen_of_context_reply = Xproto.window [@@deriving sexp]

  type print_get_document_data_reply = {
    status_code : u32;
    finished_flag : u32;
    data : byte list;
  }
  [@@deriving sexp]

  type print_input_selected_reply = { event_mask : u32; all_events_mask : u32 }
  [@@deriving sexp]

  type print_get_attributes_reply = string [@@deriving sexp]
  type print_get_one_attributes_reply = string [@@deriving sexp]

  type print_get_page_dimensions_reply = {
    width : u16;
    height : u16;
    offset_x : u16;
    offset_y : u16;
    reproducible_width : u16;
    reproducible_height : u16;
  }
  [@@deriving sexp]

  type print_query_screens_reply = Xproto.window list [@@deriving sexp]

  type print_set_image_resolution_reply = {
    status : bool;
    previous_resolutions : u16;
  }
  [@@deriving sexp]

  type print_get_image_resolution_reply = u16 [@@deriving sexp]

  type notify_event = { detail : u8; context : pcontext; cancel : bool }
  [@@deriving sexp]

  type attribut_notify_event = { detail : u8; context : pcontext }
  [@@deriving sexp]

  type bad_context_error = unit [@@deriving sexp]
  type bad_sequence_error = unit [@@deriving sexp]
end

module Xselinux = struct
  type query_version_reply = { server_major : u16; server_minor : u16 }
  [@@deriving sexp]

  type get_device_create_context_reply = string [@@deriving sexp]
  type get_device_context_reply = string [@@deriving sexp]
  type get_window_create_context_reply = string [@@deriving sexp]
  type get_window_context_reply = string [@@deriving sexp]

  type list_item = {
    name : Xproto.atom;
    object_context : string;
    data_context : string;
  }
  [@@deriving sexp]

  let decode_list_item buf : list_item =
    let name = Xproto.decode_atom buf in
    let object_context_len = Decode.u32 buf in
    let data_context_len = Decode.u32 buf in
    let object_context = Decode.string ~len:object_context_len buf in
    Decode.align buf 4;
    let data_context = Decode.string ~len:data_context_len buf in
    Decode.align buf 4;
    ()

  type get_property_create_context_reply = string [@@deriving sexp]
  type get_property_use_context_reply = string [@@deriving sexp]
  type get_property_context_reply = string [@@deriving sexp]
  type get_property_data_context_reply = string [@@deriving sexp]
  type list_properties_reply = list_item list [@@deriving sexp]
  type get_selection_create_context_reply = string [@@deriving sexp]
  type get_selection_use_context_reply = string [@@deriving sexp]
  type get_selection_context_reply = string [@@deriving sexp]
  type get_selection_data_context_reply = string [@@deriving sexp]
  type list_selections_reply = list_item list [@@deriving sexp]
  type get_client_context_reply = string [@@deriving sexp]
end

module Xtest = struct
  type get_version_reply = { major_version : u8; minor_version : u16 }
  [@@deriving sexp]

  type cursor_enum = [ `None | `Current ] [@@deriving sexp]
  type compare_cursor_reply = bool [@@deriving sexp]
end

module Xv = struct
  type port = xid [@@deriving sexp]

  let decode_port = Decode.xid

  type encoding = xid [@@deriving sexp]

  let decode_encoding = Decode.xid

  type type_mask =
    [ `Input_mask | `Output_mask | `Video_mask | `Still_mask | `Image_mask ]
    list
  [@@deriving sexp]

  type image_format_info_type_enum = [ `Rgb | `Yuv ] [@@deriving sexp]
  type image_format_info_format_enum = [ `Packed | `Planar ] [@@deriving sexp]
  type attribute_flag_mask = [ `Gettable | `Settable ] list [@@deriving sexp]

  type video_notify_reason_enum =
    [ `Started | `Stopped | `Busy | `Preempted | `Hard_error ]
  [@@deriving sexp]

  type scanline_order_enum = [ `Top_to_bottom | `Bottom_to_top ]
  [@@deriving sexp]

  type grab_port_status_enum =
    [ `Success
    | `Bad_extension
    | `Already_grabbed
    | `Invalid_time
    | `Bad_reply
    | `Bad_alloc ]
  [@@deriving sexp]

  type rational = { numerator : i32; denominator : i32 } [@@deriving sexp]

  let decode_rational buf : rational =
    let numerator = Decode.i32 buf in
    let denominator = Decode.i32 buf in
    ()

  type format = { visual : Xproto.visualid; depth : u8 } [@@deriving sexp]

  let decode_format buf : format =
    let visual = Xproto.decode_visualid buf in
    let depth = Decode.u8 buf in
    Decode.pad buf 3;
    ()

  type adaptor_info = {
    base_id : port;
    num_ports : u16;
    type_ : type_mask;
    name : string;
    formats : format list;
  }
  [@@deriving sexp]

  let decode_adaptor_info buf : adaptor_info =
    let base_id = decode_port buf in
    let name_size = Decode.u16 buf in
    let num_ports = Decode.u16 buf in
    let num_formats = Decode.u16 buf in
    let type_ = (Decode.mask Decode.u8 Int64.of_int type_mask_of_int64) buf in
    Decode.pad buf 1;
    let name = Decode.string ~len:name_size buf in
    Decode.align buf 4;
    let formats = (Decode.list ~item:decode_format) ~len:num_formats buf in
    ()

  type encoding_info = {
    encoding : encoding;
    width : u16;
    height : u16;
    rate : rational;
    name : string;
  }
  [@@deriving sexp]

  let decode_encoding_info buf : encoding_info =
    let encoding = decode_encoding buf in
    let name_size = Decode.u16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    Decode.pad buf 2;
    let rate = decode_rational buf in
    let name = Decode.string ~len:name_size buf in
    Decode.align buf 4;
    ()

  type image = {
    id : u32;
    width : u16;
    height : u16;
    pitches : u32 list;
    offsets : u32 list;
    data : u8 list;
  }
  [@@deriving sexp]

  let decode_image buf : image =
    let id = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let data_size = Decode.u32 buf in
    let num_planes = Decode.u32 buf in
    let pitches = (Decode.list ~item:Decode.u32) ~len:num_planes buf in
    let offsets = (Decode.list ~item:Decode.u32) ~len:num_planes buf in
    let data = (Decode.list ~item:Decode.u8) ~len:data_size buf in
    ()

  type attribute_info = {
    flags : attribute_flag_mask;
    min : i32;
    max : i32;
    name : string;
  }
  [@@deriving sexp]

  let decode_attribute_info buf : attribute_info =
    let flags =
      (Decode.mask Decode.u32 Int64.of_int attribute_flag_mask_of_int64) buf
    in
    let min = Decode.i32 buf in
    let max = Decode.i32 buf in
    let size = Decode.u32 buf in
    let name = Decode.string ~len:size buf in
    Decode.align buf 4;
    ()

  type image_format_info = {
    id : u32;
    type_ : image_format_info_type_enum;
    byte_order : Xproto.image_order_enum;
    guid : u8 list;
    bpp : u8;
    num_planes : u8;
    depth : u8;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
    format : image_format_info_format_enum;
    y_sample_bits : u32;
    u_sample_bits : u32;
    v_sample_bits : u32;
    vhorz_y_period : u32;
    vhorz_u_period : u32;
    vhorz_v_period : u32;
    vvert_y_period : u32;
    vvert_u_period : u32;
    vvert_v_period : u32;
    vcomp_order : u8 list;
    vscanline_order : scanline_order_enum;
  }
  [@@deriving sexp]

  let decode_image_format_info buf : image_format_info =
    let id = Decode.u32 buf in
    let type_ =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_format_info_type_enum_of_int)
        buf
    in
    let byte_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.image_order_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let guid = (Decode.list ~item:Decode.u8) ~len:16 buf in
    let bpp = Decode.u8 buf in
    let num_planes = Decode.u8 buf in
    Decode.pad buf 2;
    let depth = Decode.u8 buf in
    Decode.pad buf 3;
    let red_mask = Decode.u32 buf in
    let green_mask = Decode.u32 buf in
    let blue_mask = Decode.u32 buf in
    let format =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:image_format_info_format_enum_of_int)
        buf
    in
    Decode.pad buf 3;
    let y_sample_bits = Decode.u32 buf in
    let u_sample_bits = Decode.u32 buf in
    let v_sample_bits = Decode.u32 buf in
    let vhorz_y_period = Decode.u32 buf in
    let vhorz_u_period = Decode.u32 buf in
    let vhorz_v_period = Decode.u32 buf in
    let vvert_y_period = Decode.u32 buf in
    let vvert_u_period = Decode.u32 buf in
    let vvert_v_period = Decode.u32 buf in
    let vcomp_order = (Decode.list ~item:Decode.u8) ~len:32 buf in
    let vscanline_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:scanline_order_enum_of_int)
        buf
    in
    Decode.pad buf 11;
    ()

  type bad_port_error = unit [@@deriving sexp]
  type bad_encoding_error = unit [@@deriving sexp]
  type bad_control_error = unit [@@deriving sexp]

  type video_notify_event = {
    reason : video_notify_reason_enum;
    time : Xproto.timestamp;
    drawable : Xproto.drawable;
    port : port;
  }
  [@@deriving sexp]

  type port_notify_event = {
    time : Xproto.timestamp;
    port : port;
    attribute : Xproto.atom;
    value : i32;
  }
  [@@deriving sexp]

  type query_extension_reply = { major : u16; minor : u16 } [@@deriving sexp]
  type query_adaptors_reply = adaptor_info list [@@deriving sexp]
  type query_encodings_reply = encoding_info list [@@deriving sexp]
  type grab_port_reply = grab_port_status_enum [@@deriving sexp]

  type query_best_size_reply = { actual_width : u16; actual_height : u16 }
  [@@deriving sexp]

  type get_port_attribute_reply = i32 [@@deriving sexp]

  type query_port_attributes_reply = {
    text_size : u32;
    attributes : attribute_info list;
  }
  [@@deriving sexp]

  type list_image_formats_reply = image_format_info list [@@deriving sexp]

  type query_image_attributes_reply = {
    data_size : u32;
    width : u16;
    height : u16;
    pitches : u32 list;
    offsets : u32 list;
  }
  [@@deriving sexp]
end

module Xvmc = struct
  type context = xid [@@deriving sexp]

  let decode_context = Decode.xid

  type surface = xid [@@deriving sexp]

  let decode_surface = Decode.xid

  type subpicture = xid [@@deriving sexp]

  let decode_subpicture = Decode.xid

  type surface_info = {
    id : surface;
    chroma_format : u16;
    pad0 : u16;
    max_width : u16;
    max_height : u16;
    subpicture_max_width : u16;
    subpicture_max_height : u16;
    mc_type : u32;
    flags : u32;
  }
  [@@deriving sexp]

  let decode_surface_info buf : surface_info =
    let id = decode_surface buf in
    let chroma_format = Decode.u16 buf in
    let pad0 = Decode.u16 buf in
    let max_width = Decode.u16 buf in
    let max_height = Decode.u16 buf in
    let subpicture_max_width = Decode.u16 buf in
    let subpicture_max_height = Decode.u16 buf in
    let mc_type = Decode.u32 buf in
    let flags = Decode.u32 buf in
    ()

  type query_version_reply = { major : u32; minor : u32 } [@@deriving sexp]
  type list_surface_types_reply = surface_info list [@@deriving sexp]

  type create_context_reply = {
    width_actual : u16;
    height_actual : u16;
    flags_return : u32;
    priv_data : u32 list;
  }
  [@@deriving sexp]

  type create_surface_reply = u32 list [@@deriving sexp]

  type create_subpicture_reply = {
    width_actual : u16;
    height_actual : u16;
    num_palette_entries : u16;
    entry_bytes : u16;
    component_order : u8 list;
    priv_data : u32 list;
  }
  [@@deriving sexp]

  type list_subpicture_types_reply = Xv.image_format_info list [@@deriving sexp]
end
