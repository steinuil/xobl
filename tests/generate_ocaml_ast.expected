             valuator_mask)
        buf
    in
    let axisvalues_raw =
      (Decode.list ~item:decode_fp3232)
        ~len:
          (sum_of_expr
             (fun list_element_ref -> pop_count list_element_ref)
             valuator_mask)
        buf
    in
    ignore length;
    {
      deviceid;
      time;
      detail;
      sourceid;
      flags;
      valuator_mask;
      axisvalues;
      axisvalues_raw;
    }

