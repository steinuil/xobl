  let decode_query_tree_reply buf : query_tree_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let root = decode_window buf in
    let parent =
      (Decode.alt_enum decode_window identity window_enum_of_int) buf
    in
    let children_len = Decode.u16 buf in
    Decode.pad buf 14;
    let children = (Decode.list ~item:decode_window) ~len:children_len buf in
    ignore length;
    { root; parent; children }

