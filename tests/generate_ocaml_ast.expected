    Decode.pad buf 20;
    ignore length;
    { major_version; minor_version }
end

module Glx = struct
  type pixmap = xid [@@deriving sexp]

  let decode_pixmap = Decode.xid

  type context = xid [@@deriving sexp]

  let decode_context = Decode.xid

  type pbuffer = xid [@@deriving sexp]

  let decode_pbuffer = Decode.xid

  type window = xid [@@deriving sexp]

  let decode_window = Decode.xid

  type fbconfig = xid [@@deriving sexp]

  let decode_fbconfig = Decode.xid

  type drawable = xid [@@deriving sexp]

  let decode_drawable = Decode.xid

  type float32 = float [@@deriving sexp]

  let decode_float32 = Decode.float

  type float64 = double [@@deriving sexp]

  let decode_float64 = Decode.double

  type bool32 = u32 [@@deriving sexp]

  let decode_bool32 = Decode.u32

  type context_tag = u32 [@@deriving sexp]

  let decode_context_tag = Decode.u32

  type generic_error = u32 [@@deriving sexp]

  let decode_generic_error buf : generic_error =
    Decode.pad buf 4;
    let bad_value = Decode.u32 buf in
    Decode.pad buf 24;
    Decode.align buf 32;
    bad_value

  type bad_context_error = generic_error [@@deriving sexp]

  let decode_bad_context_error = decode_generic_error

  type bad_context_state_error = generic_error [@@deriving sexp]

  let decode_bad_context_state_error = decode_generic_error

  type bad_drawable_error = generic_error [@@deriving sexp]

  let decode_bad_drawable_error = decode_generic_error

  type bad_pixmap_error = generic_error [@@deriving sexp]

  let decode_bad_pixmap_error = decode_generic_error

  type bad_context_tag_error = generic_error [@@deriving sexp]

  let decode_bad_context_tag_error = decode_generic_error

  type bad_current_window_error = generic_error [@@deriving sexp]

  let decode_bad_current_window_error = decode_generic_error

  type bad_render_request_error = generic_error [@@deriving sexp]

  let decode_bad_render_request_error = decode_generic_error

  type bad_large_request_error = generic_error [@@deriving sexp]

  let decode_bad_large_request_error = decode_generic_error

  type unsupported_private_request_error = generic_error [@@deriving sexp]

  let decode_unsupported_private_request_error = decode_generic_error

  type bad_fb_config_error = generic_error [@@deriving sexp]

  let decode_bad_fb_config_error = decode_generic_error

  type bad_pbuffer_error = generic_error [@@deriving sexp]

  let decode_bad_pbuffer_error = decode_generic_error

  type bad_current_drawable_error = generic_error [@@deriving sexp]

  let decode_bad_current_drawable_error = decode_generic_error

  type bad_window_error = generic_error [@@deriving sexp]

  let decode_bad_window_error = decode_generic_error

  type glx_bad_profile_arb_error = generic_error [@@deriving sexp]

  let decode_glx_bad_profile_arb_error = decode_generic_error

  type pbuffer_clobber_event = {
    event_type : u16;
    draw_type : u16;
    drawable : drawable;
    b_mask : u32;
    aux_buffer : u16;
    x : u16;
    y : u16;
    width : u16;
    height : u16;
    count : u16;
  }
  [@@deriving sexp]

  let decode_pbuffer_clobber_event buf : pbuffer_clobber_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let event_type = Decode.u16 buf in
    let draw_type = Decode.u16 buf in
    let drawable = decode_drawable buf in
    let b_mask = Decode.u32 buf in
    let aux_buffer = Decode.u16 buf in
    let x = Decode.u16 buf in
    let y = Decode.u16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let count = Decode.u16 buf in
    Decode.pad buf 4;
    ignore length;
    {
      event_type;
      draw_type;
      drawable;
      b_mask;
      aux_buffer;
      x;
      y;
      width;
      height;
      count;
    }

  type buffer_swap_complete_event = {
    event_type : u16;
    drawable : drawable;
    ust_hi : u32;
    ust_lo : u32;
    msc_hi : u32;
    msc_lo : u32;
    sbc : u32;
  }
  [@@deriving sexp]

  let decode_buffer_swap_complete_event buf : buffer_swap_complete_event =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let event_type = Decode.u16 buf in
    Decode.pad buf 2;
    let drawable = decode_drawable buf in
    let ust_hi = Decode.u32 buf in
    let ust_lo = Decode.u32 buf in
    let msc_hi = Decode.u32 buf in
    let msc_lo = Decode.u32 buf in
    let sbc = Decode.u32 buf in
    ignore length;
    { event_type; drawable; ust_hi; ust_lo; msc_hi; msc_lo; sbc }

  type pbcet_enum = [ `Damaged | `Saved ] [@@deriving sexp]

  let pbcet_enum_of_int n : [ pbcet_enum | int custom ] =
    match n with 32791 -> `Damaged | 32792 -> `Saved | _ -> `Custom n

  type pbcdt_enum = [ `Window | `Pbuffer ] [@@deriving sexp]

  let pbcdt_enum_of_int n : [ pbcdt_enum | int custom ] =
    match n with 32793 -> `Window | 32794 -> `Pbuffer | _ -> `Custom n

  type make_current_reply = context_tag [@@deriving sexp]

  let decode_make_current_reply buf : make_current_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let context_tag = decode_context_tag buf in
    Decode.pad buf 20;
    ignore length;
    context_tag

  type is_direct_reply = bool [@@deriving sexp]

  let decode_is_direct_reply buf : is_direct_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let is_direct = Decode.bool buf in
    Decode.pad buf 23;
    ignore length;
    is_direct

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    { major_version; minor_version }

  type gc_mask =
    ( [ `Gl_current_bit
      | `Gl_point_bit
      | `Gl_line_bit
      | `Gl_polygon_bit
      | `Gl_polygon_stipple_bit
      | `Gl_pixel_mode_bit
      | `Gl_lighting_bit
      | `Gl_fog_bit
      | `Gl_depth_buffer_bit
      | `Gl_accum_buffer_bit
      | `Gl_stencil_buffer_bit
      | `Gl_viewport_bit
      | `Gl_transform_bit
      | `Gl_enable_bit
      | `Gl_color_buffer_bit
      | `Gl_hint_bit
      | `Gl_eval_bit
      | `Gl_list_bit
      | `Gl_texture_bit
      | `Gl_scissor_bit ]
      list,
      [ `Gl_all_attrib_bits ] )
    mask
  [@@deriving sexp]

  type get_visual_configs_reply = {
    num_visuals : u32;
    num_properties : u32;
    property_list : u32 list;
  }
  [@@deriving sexp]

  let decode_get_visual_configs_reply buf : get_visual_configs_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_visuals = Decode.u32 buf in
    let num_properties = Decode.u32 buf in
    Decode.pad buf 16;
    let property_list = (Decode.list ~item:Decode.u32) ~len:length buf in
    ignore length;
    { num_visuals; num_properties; property_list }

  type vendor_private_with_reply = {
    retval : u32;
    data1 : byte list;
    data2 : byte list;
  }
  [@@deriving sexp]

  let decode_vendor_private_with_reply_reply buf : vendor_private_with_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let retval = Decode.u32 buf in
    let data1 = (Decode.list ~item:Decode.byte) ~len:24 buf in
    let data2 = (Decode.list ~item:Decode.byte) ~len:(length * 4) buf in
    ignore length;
    { retval; data1; data2 }

  type query_extensions_string_reply = u32 [@@deriving sexp]

  let decode_query_extensions_string_reply buf : query_extensions_string_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let n = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    n

  type query_server_string_reply = string [@@deriving sexp]

  let decode_query_server_string_reply buf : query_server_string_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    Decode.pad buf 4;
    let str_len = Decode.u32 buf in
    Decode.pad buf 16;
    let string = Decode.string ~len:str_len buf in
    ignore length;
    string

