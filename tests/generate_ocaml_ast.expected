module Randr = struct
  type mode = xid [@@deriving sexp]

  let decode_mode = Decode.xid

  type crtc = xid [@@deriving sexp]

  let decode_crtc = Decode.xid

  type output = xid [@@deriving sexp]

  let decode_output = Decode.xid

  type provider = xid [@@deriving sexp]

  let decode_provider = Decode.xid

  type lease = xid [@@deriving sexp]

  let decode_lease = Decode.xid

  type bad_output_error = unit [@@deriving sexp]
  type bad_crtc_error = unit [@@deriving sexp]
  type bad_mode_error = unit [@@deriving sexp]
  type bad_provider_error = unit [@@deriving sexp]

  type rotation_mask =
    [ `Rotate_0
    | `Rotate_90
    | `Rotate_180
    | `Rotate_270
    | `Reflect_x
    | `Reflect_y ]
    list
  [@@deriving sexp]

  type screen_size = { width : u16; height : u16; mwidth : u16; mheight : u16 }
  [@@deriving sexp]

  let decode_screen_size buf : screen_size =
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let mwidth = Decode.u16 buf in
    let mheight = Decode.u16 buf in
    ()

  type refresh_rates = u16 list [@@deriving sexp]

  let decode_refresh_rates buf : refresh_rates =
    let n_rates = Decode.u16 buf in
    let rates = (Decode.list ~item:Decode.u16) ~len:n_rates buf in
    ()

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  type set_config_enum =
    [ `Success | `Invalid_config_time | `Invalid_time | `Failed ]
  [@@deriving sexp]

  type set_screen_config_reply = {
    status : set_config_enum;
    new_timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    root : Xproto.window;
    subpixel_order : Render.sub_pixel_enum;
  }
  [@@deriving sexp]

  type notify_mask =
    [ `Screen_change
    | `Crtc_change
    | `Output_change
    | `Output_property
    | `Provider_change
    | `Provider_property
    | `Resource_change
    | `Lease ]
    list
  [@@deriving sexp]

  type get_screen_info_reply = {
    rotations : rotation_mask;
    root : Xproto.window;
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    size_id : u16;
    rotation : rotation_mask;
    rate : u16;
    n_info : u16;
    sizes : screen_size list;
    rates : refresh_rates list;
  }
  [@@deriving sexp]

  type get_screen_size_range_reply = {
    min_width : u16;
    min_height : u16;
    max_width : u16;
    max_height : u16;
  }
  [@@deriving sexp]

  type mode_flag_mask =
    [ `Hsync_positive
    | `Hsync_negative
    | `Vsync_positive
    | `Vsync_negative
    | `Interlace
    | `Double_scan
    | `Csync
    | `Csync_positive
    | `Csync_negative
    | `Hskew_present
    | `Bcast
    | `Pixel_multiplex
    | `Double_clock
    | `Halve_clock ]
    list
  [@@deriving sexp]

  type mode_info = {
    id : u32;
    width : u16;
    height : u16;
    dot_clock : u32;
    hsync_start : u16;
    hsync_end : u16;
    htotal : u16;
    hskew : u16;
    vsync_start : u16;
    vsync_end : u16;
    vtotal : u16;
    name_len : u16;
    mode_flags : mode_flag_mask;
  }
  [@@deriving sexp]

  let decode_mode_info buf : mode_info =
    let id = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let dot_clock = Decode.u32 buf in
    let hsync_start = Decode.u16 buf in
    let hsync_end = Decode.u16 buf in
    let htotal = Decode.u16 buf in
    let hskew = Decode.u16 buf in
    let vsync_start = Decode.u16 buf in
    let vsync_end = Decode.u16 buf in
    let vtotal = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    let mode_flags =
      (Decode.mask Decode.u32 Int64.of_int mode_flag_mask_of_int64) buf
    in
    ()

  type get_screen_resources_reply = {
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    crtcs : crtc list;
    outputs : output list;
    modes : mode_info list;
    names : byte list;
  }
  [@@deriving sexp]

  type connection_enum = [ `Connected | `Disconnected | `Unknown ]
  [@@deriving sexp]

  type get_output_info_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
    crtc : crtc;
    mm_width : u32;
    mm_height : u32;
    connection : connection_enum;
    subpixel_order : Render.sub_pixel_enum;
    num_preferred : u16;
    crtcs : crtc list;
    modes : mode list;
    clones : output list;
    name : byte list;
  }
  [@@deriving sexp]

  type list_output_properties_reply = Xproto.atom list [@@deriving sexp]

  type query_output_property_reply = {
    pending : bool;
    range : bool;
    immutable : bool;
    valid_values : i32 list;
  }
  [@@deriving sexp]

  type get_output_property_reply = {
    format : u8;
    type_ : Xproto.atom_enum alt_enum;
    bytes_after : u32;
    num_items : u32;
    data : byte list;
  }
  [@@deriving sexp]

  type create_mode_reply = mode [@@deriving sexp]

  type get_crtc_info_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    mode : mode;
    rotation : rotation_mask;
    rotations : rotation_mask;
    outputs : output list;
    possible : output list;
  }
  [@@deriving sexp]

  type set_crtc_config_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
  }
  [@@deriving sexp]

  type get_crtc_gamma_size_reply = u16 [@@deriving sexp]

  type get_crtc_gamma_reply = {
    red : u16 list;
    green : u16 list;
    blue : u16 list;
  }
  [@@deriving sexp]

  type get_screen_resources_current_reply = {
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    crtcs : crtc list;
    outputs : output list;
    modes : mode_info list;
    names : byte list;
  }
  [@@deriving sexp]

  type transform_mask = [ `Unit | `Scale_up | `Scale_down | `Projective ] list
  [@@deriving sexp]

  type get_crtc_transform_reply = {
    pending_transform : Render.transform;
    has_transforms : bool;
    current_transform : Render.transform;
    pending_filter_name : string;
    pending_params : Render.fixed list;
    current_filter_name : string;
    current_params : Render.fixed list;
  }
  [@@deriving sexp]

  type get_panning_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
    left : u16;
    top : u16;
    width : u16;
    height : u16;
    track_left : u16;
    track_top : u16;
    track_width : u16;
    track_height : u16;
    border_left : i16;
    border_top : i16;
    border_right : i16;
    border_bottom : i16;
  }
  [@@deriving sexp]

  type set_panning_reply = {
    status : set_config_enum;
    timestamp : Xproto.timestamp;
  }
  [@@deriving sexp]

  type get_output_primary_reply = output [@@deriving sexp]

  type get_providers_reply = {
    timestamp : Xproto.timestamp;
    providers : provider list;
  }
  [@@deriving sexp]

  type provider_capability_mask =
    [ `Source_output | `Sink_output | `Source_offload | `Sink_offload ] list
  [@@deriving sexp]

  type get_provider_info_reply = {
    status : u8;
    timestamp : Xproto.timestamp;
    capabilities : provider_capability_mask;
    crtcs : crtc list;
    outputs : output list;
    associated_providers : provider list;
    associated_capability : u32 list;
    name : string;
  }
  [@@deriving sexp]

  type list_provider_properties_reply = Xproto.atom list [@@deriving sexp]

  type query_provider_property_reply = {
    pending : bool;
    range : bool;
    immutable : bool;
    valid_values : i32 list;
  }
  [@@deriving sexp]

  type get_provider_property_reply = {
    format : u8;
    type_ : Xproto.atom;
    bytes_after : u32;
    num_items : u32;
    data : string;
  }
  [@@deriving sexp]

  type screen_change_notify_event = {
    rotation : rotation_mask;
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    root : Xproto.window;
    request_window : Xproto.window;
    size_id : u16;
    subpixel_order : Render.sub_pixel_enum;
    width : u16;
    height : u16;
    mwidth : u16;
    mheight : u16;
  }
  [@@deriving sexp]

  type notify_enum =
    [ `Crtc_change
    | `Output_change
    | `Output_property
    | `Provider_change
    | `Provider_property
    | `Resource_change
    | `Lease ]
  [@@deriving sexp]

  type crtc_change = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
    crtc : crtc;
    mode : mode;
    rotation : rotation_mask;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
  }
  [@@deriving sexp]

  let decode_crtc_change buf : crtc_change =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let crtc = decode_crtc buf in
    let mode = decode_mode buf in
    let rotation =
      (Decode.mask Decode.u16 Int64.of_int rotation_mask_of_int64) buf
    in
    Decode.pad buf 2;
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    ()

  type output_change = {
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    window : Xproto.window;
    output : output;
    crtc : crtc;
    mode : mode;
    rotation : rotation_mask;
    connection : connection_enum;
    subpixel_order : Render.sub_pixel_enum;
  }
  [@@deriving sexp]

  let decode_output_change buf : output_change =
    let timestamp = Xproto.decode_timestamp buf in
    let config_timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let output = decode_output buf in
    let crtc = decode_crtc buf in
    let mode = decode_mode buf in
    let rotation =
      (Decode.mask Decode.u16 Int64.of_int rotation_mask_of_int64) buf
    in
    let connection =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:connection_enum_of_int)
        buf
    in
    let subpixel_order =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Render.sub_pixel_enum_of_int)
        buf
    in
    ()

  type output_property = {
    window : Xproto.window;
    output : output;
    atom : Xproto.atom;
    timestamp : Xproto.timestamp;
    status : Xproto.property_enum;
  }
  [@@deriving sexp]

  let decode_output_property buf : output_property =
    let window = Xproto.decode_window buf in
    let output = decode_output buf in
    let atom = Xproto.decode_atom buf in
    let timestamp = Xproto.decode_timestamp buf in
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.property_enum_of_int)
        buf
    in
    Decode.pad buf 11;
    ()

  type provider_change = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
    provider : provider;
  }
  [@@deriving sexp]

  let decode_provider_change buf : provider_change =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let provider = decode_provider buf in
    Decode.pad buf 16;
    ()

  type provider_property = {
    window : Xproto.window;
    provider : provider;
    atom : Xproto.atom;
    timestamp : Xproto.timestamp;
    state : u8;
  }
  [@@deriving sexp]

  let decode_provider_property buf : provider_property =
    let window = Xproto.decode_window buf in
    let provider = decode_provider buf in
    let atom = Xproto.decode_atom buf in
    let timestamp = Xproto.decode_timestamp buf in
    let state = Decode.u8 buf in
    Decode.pad buf 11;
    ()

  type resource_change = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
  }
  [@@deriving sexp]

  let decode_resource_change buf : resource_change =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    Decode.pad buf 20;
    ()

  type monitor_info = {
    name : Xproto.atom;
    primary : bool;
    automatic : bool;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    width_in_millimeters : u32;
    height_in_millimeters : u32;
    outputs : output list;
  }
  [@@deriving sexp]

  let decode_monitor_info buf : monitor_info =
    let name = Xproto.decode_atom buf in
    let primary = Decode.bool buf in
    let automatic = Decode.bool buf in
    let n_output = Decode.u16 buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let width_in_millimeters = Decode.u32 buf in
    let height_in_millimeters = Decode.u32 buf in
    let outputs = (Decode.list ~item:decode_output) ~len:n_output buf in
    ()

  type get_monitors_reply = {
    timestamp : Xproto.timestamp;
    n_outputs : u32;
    monitors : monitor_info list;
  }
  [@@deriving sexp]

  type create_lease_reply = { nfd : u8; master_fd : file_descr }
  [@@deriving sexp]

  type lease_notify = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
    lease : lease;
    created : u8;
  }
  [@@deriving sexp]

  let decode_lease_notify buf : lease_notify =
    let timestamp = Xproto.decode_timestamp buf in
    let window = Xproto.decode_window buf in
    let lease = decode_lease buf in
    let created = Decode.u8 buf in
    Decode.pad buf 15;
    ()

  type notify_variant =
    | Crtc_change of crtc_change
    | Output_change of output_change
    | Output_property of output_property
    | Provider_change of provider_change
    | Provider_property of provider_property
    | Resource_change of resource_change
    | Lease of lease_notify
  [@@deriving sexp]

  type notify_event = notify_variant [@@deriving sexp]
end

module Sync = struct
  type alarm = xid [@@deriving sexp]

  let decode_alarm = Decode.xid

  type alarmstate_enum = [ `Active | `Inactive | `Destroyed ] [@@deriving sexp]
  type counter = xid [@@deriving sexp]

  let decode_counter = Decode.xid

  type fence = xid [@@deriving sexp]

  let decode_fence = Decode.xid

  type testtype_enum =
    [ `Positive_transition
    | `Negative_transition
    | `Positive_comparison
    | `Negative_comparison ]
  [@@deriving sexp]

  type valuetype_enum = [ `Absolute | `Relative ] [@@deriving sexp]

  type ca_mask =
    [ `Counter | `Value_type | `Value | `Test_type | `Delta | `Events ] list
  [@@deriving sexp]

  type int64 = { hi : i32; lo : u32 } [@@deriving sexp]

  let decode_int64 buf : int64 =
    let hi = Decode.i32 buf in
    let lo = Decode.u32 buf in
    ()

  type systemcounter = { counter : counter; resolution : int64; name : string }
  [@@deriving sexp]

  let decode_systemcounter buf : systemcounter =
    let counter = decode_counter buf in
    let resolution = decode_int64 buf in
    let name_len = Decode.u16 buf in
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    ()

  type trigger = {
    counter : counter;
    wait_type : valuetype_enum;
    wait_value : int64;
    test_type : testtype_enum;
  }
  [@@deriving sexp]

  let decode_trigger buf : trigger =
    let counter = decode_counter buf in
    let wait_type =
      (Decode.enum ~decode:Decode.u32 ~int_of_t:identity
         ~enum_of_int:valuetype_enum_of_int)
        buf
    in
    let wait_value = decode_int64 buf in
    let test_type =
      (Decode.enum ~decode:Decode.u32 ~int_of_t:identity
         ~enum_of_int:testtype_enum_of_int)
        buf
    in
    ()

  type waitcondition = { trigger : trigger; event_threshold : int64 }
  [@@deriving sexp]

  let decode_waitcondition buf : waitcondition =
    let trigger = decode_trigger buf in
    let event_threshold = decode_int64 buf in
    ()

  type counter_error = {
    bad_counter : u32;
    minor_opcode : u16;
    major_opcode : u8;
  }
  [@@deriving sexp]

  type alarm_error = { bad_alarm : u32; minor_opcode : u16; major_opcode : u8 }
  [@@deriving sexp]

  type initialize_reply = { major_version : u8; minor_version : u8 }
  [@@deriving sexp]

  type list_system_counters_reply = systemcounter list [@@deriving sexp]
  type query_counter_reply = int64 [@@deriving sexp]

  type query_alarm_reply = {
    trigger : trigger;
    delta : int64;
    events : bool;
    state : alarmstate_enum;
  }
  [@@deriving sexp]

  type get_priority_reply = i32 [@@deriving sexp]
  type query_fence_reply = bool [@@deriving sexp]

  type counter_notify_event = {
    kind : u8;
    counter : counter;
    wait_value : int64;
    counter_value : int64;
    timestamp : Xproto.timestamp;
    count : u16;
    destroyed : bool;
  }
  [@@deriving sexp]

  type alarm_notify_event = {
    kind : u8;
    alarm : alarm;
    counter_value : int64;
    alarm_value : int64;
    timestamp : Xproto.timestamp;
    state : alarmstate_enum;
  }
  [@@deriving sexp]
end

module Present = struct
  type event_enum =
    [ `Configure_notify | `Complete_notify | `Idle_notify | `Redirect_notify ]
  [@@deriving sexp]

  type event_mask =
    [ `Configure_notify | `Complete_notify | `Idle_notify | `Redirect_notify ]
    list
  [@@deriving sexp]

  type option_mask = [ `Async | `Copy | `Ust | `Suboptimal ] list
  [@@deriving sexp]

  type capability_mask = [ `Async | `Fence | `Ust ] list [@@deriving sexp]
  type complete_kind_enum = [ `Pixmap | `Notify_msc ] [@@deriving sexp]

  type complete_mode_enum = [ `Copy | `Flip | `Skip | `Suboptimal_copy ]
  [@@deriving sexp]

  type notify = { window : Xproto.window; serial : u32 } [@@deriving sexp]

  let decode_notify buf : notify =
    let window = Xproto.decode_window buf in
    let serial = Decode.u32 buf in
    ()

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  type event = xid [@@deriving sexp]

  let decode_event = Decode.xid

  type query_capabilities_reply = u32 [@@deriving sexp]

  type generic_event = {
    extension : u8;
    length : u32;
    evtype : u16;
    event : event;
  }
  [@@deriving sexp]

  type configure_notify_event = {
    event : event;
    window : Xproto.window;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    off_x : i16;
    off_y : i16;
    pixmap_width : u16;
    pixmap_height : u16;
    pixmap_flags : u32;
  }
  [@@deriving sexp]

  type complete_notify_event = {
    kind : complete_kind_enum;
    mode : complete_mode_enum;
    event : event;
    window : Xproto.window;
    serial : u32;
    ust : u64;
    msc : u64;
  }
  [@@deriving sexp]

  type idle_notify_event = {
    event : event;
    window : Xproto.window;
    serial : u32;
    pixmap : Xproto.pixmap;
    idle_fence : Sync.fence;
  }
  [@@deriving sexp]

  type redirect_notify_event = {
    update_window : bool;
    event : event;
    event_window : Xproto.window;
    window : Xproto.window;
    pixmap : Xproto.pixmap;
    serial : u32;
    valid_region : Xfixes.region;
    update_region : Xfixes.region;
    valid_rect : Xproto.rectangle;
    update_rect : Xproto.rectangle;
    x_off : i16;
    y_off : i16;
    target_crtc : Randr.crtc;
    wait_fence : Sync.fence;
    idle_fence : Sync.fence;
    options : u32;
    target_msc : u64;
    divisor : u64;
    remainder : u64;
    notifies : notify list;
  }
  [@@deriving sexp]
end

module Record = struct
  type context = xid [@@deriving sexp]

  let decode_context = Decode.xid

  type range8 = { first : u8; last : u8 } [@@deriving sexp]

  let decode_range8 buf : range8 =
    let first = Decode.u8 buf in
    let last = Decode.u8 buf in
    ()

  type range16 = { first : u16; last : u16 } [@@deriving sexp]

  let decode_range16 buf : range16 =
    let first = Decode.u16 buf in
    let last = Decode.u16 buf in
    ()

  type ext_range = { major : range8; minor : range16 } [@@deriving sexp]

  let decode_ext_range buf : ext_range =
    let major = decode_range8 buf in
    let minor = decode_range16 buf in
    ()

  type range = {
    core_requests : range8;
    core_replies : range8;
    ext_requests : ext_range;
    ext_replies : ext_range;
    delivered_events : range8;
    device_events : range8;
    errors : range8;
    client_started : bool;
    client_died : bool;
  }
  [@@deriving sexp]

  let decode_range buf : range =
    let core_requests = decode_range8 buf in
    let core_replies = decode_range8 buf in
    let ext_requests = decode_ext_range buf in
    let ext_replies = decode_ext_range buf in
    let delivered_events = decode_range8 buf in
    let device_events = decode_range8 buf in
    let errors = decode_range8 buf in
    let client_started = Decode.bool buf in
    let client_died = Decode.bool buf in
    ()

  type element_header = u8 [@@deriving sexp]

  let decode_element_header = Decode.u8

  type h_type_mask =
    [ `From_server_time | `From_client_time | `From_client_sequence ] list
  [@@deriving sexp]

  type client_spec = u32 [@@deriving sexp]

  let decode_client_spec = Decode.u32

  type cs_enum = [ `Current_clients | `Future_clients | `All_clients ]
  [@@deriving sexp]

  type client_info = { client_resource : client_spec; ranges : range list }
  [@@deriving sexp]

  let decode_client_info buf : client_info =
    let client_resource = decode_client_spec buf in
    let num_ranges = Decode.u32 buf in
    let ranges = (Decode.list ~item:decode_range) ~len:num_ranges buf in
    ()

  type bad_context_error = u32 [@@deriving sexp]

  type query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  type get_context_reply = {
    enabled : bool;
    element_header : element_header;
    intercepted_clients : client_info list;
  }
  [@@deriving sexp]

  type enable_context_reply = {
    category : u8;
    element_header : element_header;
    client_swapped : bool;
    xid_base : u32;
    server_time : u32;
    rec_sequence_num : u32;
    data : byte list;
  }
  [@@deriving sexp]
end

module Res = struct
  type client = { resource_base : u32; resource_mask : u32 } [@@deriving sexp]

  let decode_client buf : client =
    let resource_base = Decode.u32 buf in
    let resource_mask = Decode.u32 buf in
    ()

  type type_ = { resource_type : Xproto.atom; count : u32 } [@@deriving sexp]

  let decode_type buf : type_ =
    let resource_type = Xproto.decode_atom buf in
    let count = Decode.u32 buf in
    ()

  type client_id_mask = [ `Client_xid | `Local_client_pid ] list
  [@@deriving sexp]

  type client_id_spec = { client : u32; mask : client_id_mask }
  [@@deriving sexp]

  let decode_client_id_spec buf : client_id_spec =
    let client = Decode.u32 buf in
    let mask =
      (Decode.mask Decode.u32 Int64.of_int client_id_mask_mask_of_int64) buf
    in
    ()

  type client_id_value = { spec : client_id_spec; value : u32 list }
  [@@deriving sexp]

  let decode_client_id_value buf : client_id_value =
    let spec = decode_client_id_spec buf in
    let length = Decode.u32 buf in
    let length = length * 4 in
    let value = (Decode.list ~item:Decode.u32) ~len:length buf in
    ()

  type resource_id_spec = { resource : u32; type_ : u32 } [@@deriving sexp]

  let decode_resource_id_spec buf : resource_id_spec =
    let resource = Decode.u32 buf in
    let type_ = Decode.u32 buf in
    ()

  type resource_size_spec = {
    spec : resource_id_spec;
    bytes : u32;
    ref_count : u32;
    use_count : u32;
  }
  [@@deriving sexp]

  let decode_resource_size_spec buf : resource_size_spec =
    let spec = decode_resource_id_spec buf in
    let bytes = Decode.u32 buf in
    let ref_count = Decode.u32 buf in
    let use_count = Decode.u32 buf in
    ()

  type resource_size_value = {
    size : resource_size_spec;
    cross_references : resource_size_spec list;
  }
  [@@deriving sexp]

  let decode_resource_size_value buf : resource_size_value =
    let size = decode_resource_size_spec buf in
    let num_cross_references = Decode.u32 buf in
    let cross_references =
      (Decode.list ~item:decode_resource_size_spec)
        ~len:num_cross_references buf
    in
    ()

  type query_version_reply = { server_major : u16; server_minor : u16 }
  [@@deriving sexp]

  type query_clients_reply = client list [@@deriving sexp]
  type query_client_resources_reply = type_ list [@@deriving sexp]

  type query_client_pixmap_bytes_reply = { bytes : u32; bytes_overflow : u32 }
  [@@deriving sexp]

  type query_client_ids_reply = client_id_value list [@@deriving sexp]
  type query_resource_bytes_reply = resource_size_value list [@@deriving sexp]
end

module Screensaver = struct
  type kind_enum = [ `Blanked | `Internal | `External ] [@@deriving sexp]
  type event_mask = [ `Notify_mask | `Cycle_mask ] list [@@deriving sexp]
  type state_enum = [ `Off | `On | `Cycle | `Disabled ] [@@deriving sexp]

  type query_version_reply = {
    server_major_version : u16;
    server_minor_version : u16;
  }
  [@@deriving sexp]

  type query_info_reply = {
    state : u8;
    saver_window : Xproto.window;
    ms_until_server : u32;
    ms_since_user_input : u32;
    event_mask : u32;
    kind : kind_enum;
  }
  [@@deriving sexp]

  type notify_event = {
    state : state_enum;
    time : Xproto.timestamp;
    root : Xproto.window;
    window : Xproto.window;
    kind : kind_enum;
    forced : bool;
  }
  [@@deriving sexp]
end

module Shm = struct
  type seg = xid [@@deriving sexp]

  let decode_seg = Decode.xid

  type completion_event = {
    drawable : Xproto.drawable;
