         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let min_x = Decode.i32 buf in
    let max_x = Decode.i32 buf in
    let min_y = Decode.i32 buf in
    let max_y = Decode.i32 buf in
    let flip_x = Decode.u32 buf in
    let flip_y = Decode.u32 buf in
    let rotation = Decode.u32 buf in
    let button_threshold = Decode.u32 buf in
    {
      control_id;
      len;
      min_x;
      max_x;
      min_y;
      max_y;
      flip_x;
      flip_y;
      rotation;
      button_threshold;
    }

  type device_abs_area_ctrl = {
    control_id : device_control_enum;
    len : u16;
    offset_x : u32;
    offset_y : u32;
    width : i32;
    height : i32;
    screen : i32;
    following : u32;
  }
  [@@deriving sexp]

  let decode_device_abs_area_ctrl buf : device_abs_area_ctrl =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let offset_x = Decode.u32 buf in
    let offset_y = Decode.u32 buf in
    let width = Decode.i32 buf in
    let height = Decode.i32 buf in
    let screen = Decode.i32 buf in
    let following = Decode.u32 buf in
    { control_id; len; offset_x; offset_y; width; height; screen; following }

  type device_core_ctrl = {
    control_id : device_control_enum;
    len : u16;
    status : u8;
  }
  [@@deriving sexp]

  let decode_device_core_ctrl buf : device_core_ctrl =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let status = Decode.u8 buf in
    Decode.pad buf 3;
    { control_id; len; status }

  type device_enable_ctrl = {
    control_id : device_control_enum;
    len : u16;
    enable : u8;
  }
  [@@deriving sexp]

  let decode_device_enable_ctrl buf : device_enable_ctrl =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let enable = Decode.u8 buf in
    Decode.pad buf 3;
    { control_id; len; enable }

  type device_ctl = { len : u16; data : device_control_variant }
  [@@deriving sexp]

  let decode_device_ctl buf : device_ctl =
    let data_tag = Decode.u16 buf in
    let len = Decode.u16 buf in
    let data = decode_device_control_variant ~tag:data_tag buf in
    { len; data }

  type change_device_control_reply = {
    xi_reply_type : u8;
    status : [ Xproto.grab_status_enum | u8 custom ];
  }
  [@@deriving sexp]

  let decode_change_device_control_reply buf : change_device_control_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let status =
      (Decode.alt_enum Decode.u8 identity Xproto.grab_status_enum_of_int) buf
    in
    Decode.pad buf 23;
    ignore length;
    { xi_reply_type; status }

  type list_device_properties_reply = {
    xi_reply_type : u8;
    atoms : Xproto.atom list;
  }
  [@@deriving sexp]

  let decode_list_device_properties_reply buf : list_device_properties_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let num_atoms = Decode.u16 buf in
    Decode.pad buf 22;
    let atoms = (Decode.list ~item:Xproto.decode_atom) ~len:num_atoms buf in
    ignore length;
    { xi_reply_type; atoms }

  type property_format_enum = [ `D8_bits | `D16_bits | `D32_bits ]
  [@@deriving sexp]

  let property_format_enum_of_int n : [ property_format_enum | int custom ] =
    match n with
    | 8 -> `D8_bits
    | 16 -> `D16_bits
    | 32 -> `D32_bits
    | _ -> `Custom n

  type property_format_variant =
    | D8_bits of u8 list
    | D16_bits of u16 list
    | D32_bits of u32 list
  [@@deriving sexp]

  let decode_property_format_variant buf ~tag ext_num_items :
      property_format_variant =
    match tag with
    | 8 ->
        let data8 = (Decode.list ~item:Decode.u8) ~len:ext_num_items buf in
        Decode.align buf 4;
        D8_bits data8
    | 16 ->
        let data16 = (Decode.list ~item:Decode.u16) ~len:ext_num_items buf in
        Decode.align buf 4;
        D16_bits data16
    | 32 ->
        let data32 = (Decode.list ~item:Decode.u32) ~len:ext_num_items buf in
        D32_bits data32

  type get_device_property_reply = {
    xi_reply_type : u8;
    type_ : Xproto.atom;
    bytes_after : u32;
    num_items : u32;
    device_id : u8;
    items : property_format_variant;
  }
  [@@deriving sexp]

  let decode_get_device_property_reply buf : get_device_property_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let type_ = Xproto.decode_atom buf in
    let bytes_after = Decode.u32 buf in
    let num_items = Decode.u32 buf in
    let items_tag = Decode.u8 buf in
    let device_id = Decode.u8 buf in
    Decode.pad buf 10;
    let items = decode_property_format_variant ~tag:items_tag buf num_items in
    ignore length;
    { xi_reply_type; type_; bytes_after; num_items; device_id; items }

  type device_enum = [ `All | `All_master ] [@@deriving sexp]

  let device_enum_of_int n : [ device_enum | int custom ] =
    match n with 0 -> `All | 1 -> `All_master | _ -> `Custom n

  type group_info = { base : u8; latched : u8; locked : u8; effective : u8 }
  [@@deriving sexp]

  let decode_group_info buf : group_info =
    let base = Decode.u8 buf in
    let latched = Decode.u8 buf in
    let locked = Decode.u8 buf in
    let effective = Decode.u8 buf in
    { base; latched; locked; effective }

  type modifier_info = {
    base : u32;
    latched : u32;
    locked : u32;
    effective : u32;
  }
  [@@deriving sexp]

  let decode_modifier_info buf : modifier_info =
    let base = Decode.u32 buf in
    let latched = Decode.u32 buf in
    let locked = Decode.u32 buf in
    let effective = Decode.u32 buf in
    { base; latched; locked; effective }

  type xi_query_pointer_reply = {
    root : Xproto.window;
    child : Xproto.window;
    root_x : fp1616;
    root_y : fp1616;
    win_x : fp1616;
    win_y : fp1616;
    same_screen : bool;
    mods : modifier_info;
    group : group_info;
    buttons : u32 list;
  }
  [@@deriving sexp]

  let decode_xi_query_pointer_reply buf : xi_query_pointer_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let root = Xproto.decode_window buf in
    let child = Xproto.decode_window buf in
    let root_x = decode_fp1616 buf in
    let root_y = decode_fp1616 buf in
    let win_x = decode_fp1616 buf in
    let win_y = decode_fp1616 buf in
    let same_screen = Decode.bool buf in
    Decode.pad buf 1;
    let buttons_len = Decode.u16 buf in
    let mods = decode_modifier_info buf in
    let group = decode_group_info buf in
    let buttons = (Decode.list ~item:Decode.u32) ~len:buttons_len buf in
    ignore length;
    {
      root;
      child;
      root_x;
      root_y;
      win_x;
      win_y;
      same_screen;
      mods;
      group;
      buttons;
    }

  type hierarchy_change_type_enum =
    [ `Add_master | `Remove_master | `Attach_slave | `Detach_slave ]
  [@@deriving sexp]

  let hierarchy_change_type_enum_of_int n :
      [ hierarchy_change_type_enum | int custom ] =
    match n with
    | 1 -> `Add_master
    | 2 -> `Remove_master
    | 3 -> `Attach_slave
    | 4 -> `Detach_slave
    | _ -> `Custom n

  type change_mode_enum = [ `Attach | `Float ] [@@deriving sexp]

  let change_mode_enum_of_int n : [ change_mode_enum | int custom ] =
    match n with 1 -> `Attach | 2 -> `Float | _ -> `Custom n

  type add_master = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    send_core : bool;
    enable : bool;
    name : string;
  }
  [@@deriving sexp]

  let decode_add_master buf : add_master =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    let send_core = Decode.bool buf in
    let enable = Decode.bool buf in
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    { type_; len; send_core; enable; name }

  type remove_master = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    deviceid : [ device_enum | device_id custom ];
    return_mode : change_mode_enum;
    return_pointer : [ device_enum | device_id custom ];
    return_keyboard : [ device_enum | device_id custom ];
  }
  [@@deriving sexp]

  let decode_remove_master buf : remove_master =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let return_mode =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:change_mode_enum_of_int)
        buf
    in
    Decode.pad buf 1;
    let return_pointer =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let return_keyboard =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    { type_; len; deviceid; return_mode; return_pointer; return_keyboard }

  type attach_slave = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    deviceid : [ device_enum | device_id custom ];
    master : [ device_enum | device_id custom ];
  }
  [@@deriving sexp]

  let decode_attach_slave buf : attach_slave =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let master =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    { type_; len; deviceid; master }

  type detach_slave = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    deviceid : [ device_enum | device_id custom ];
  }
  [@@deriving sexp]

  let decode_detach_slave buf : detach_slave =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    Decode.pad buf 2;
    { type_; len; deviceid }

  type hierarchy_change_type_variant =
    | Add_master of { send_core : bool; enable : bool; name : string }
    | Remove_master of {
        deviceid : [ device_enum | device_id custom ];
        return_mode : change_mode_enum;
        return_pointer : [ device_enum | device_id custom ];
        return_keyboard : [ device_enum | device_id custom ];
      }
    | Attach_slave of {
        deviceid : [ device_enum | device_id custom ];
        master : [ device_enum | device_id custom ];
      }
    | Detach_slave of [ device_enum | device_id custom ]
  [@@deriving sexp]

  let decode_hierarchy_change_type_variant buf ~tag :
      hierarchy_change_type_variant =
    match tag with
    | 1 ->
        let name_len = Decode.u16 buf in
        let send_core = Decode.bool buf in
        let enable = Decode.bool buf in
        let name = Decode.string ~len:name_len buf in
        Decode.align buf 4;
        Add_master { send_core; enable; name }
    | 2 ->
        let deviceid =
          (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
        in
        let return_mode =
          (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
             ~enum_of_int:change_mode_enum_of_int)
            buf
        in
        Decode.pad buf 1;
        let return_pointer =
          (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
        in
        let return_keyboard =
          (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
        in
        Remove_master { deviceid; return_mode; return_pointer; return_keyboard }
    | 3 ->
        let deviceid =
          (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
        in
        let master =
          (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
        in
        Attach_slave { deviceid; master }
    | 4 ->
        let deviceid =
          (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
        in
        Decode.pad buf 2;
        Detach_slave deviceid

  type hierarchy_change = { len : u16; data : hierarchy_change_type_variant }
  [@@deriving sexp]

  let decode_hierarchy_change buf : hierarchy_change =
    let data_tag = Decode.u16 buf in
    let len = Decode.u16 buf in
    let data = decode_hierarchy_change_type_variant ~tag:data_tag buf in
    { len; data }

  type xi_get_client_pointer_reply = {
    set : bool;
    deviceid : [ device_enum | device_id custom ];
  }
  [@@deriving sexp]

  let decode_xi_get_client_pointer_reply buf : xi_get_client_pointer_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let set = Decode.bool buf in
    Decode.pad buf 1;
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    Decode.pad buf 20;
    ignore length;
    { set; deviceid }

