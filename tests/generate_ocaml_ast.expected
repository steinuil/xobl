  type hierarchy_change_type_enum =
    [ `Add_master | `Remove_master | `Attach_slave | `Detach_slave ]
  [@@deriving sexp]

  type change_mode_enum = [ `Attach | `Float ] [@@deriving sexp]

  type add_master = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    send_core : bool;
    enable : bool;
    name : string;
  }
  [@@deriving sexp]

  let decode_add_master buf : add_master =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    let send_core = Decode.bool buf in
    let enable = Decode.bool buf in
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    ()

  type remove_master = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    deviceid : device_enum alt_enum;
    return_mode : change_mode_enum;
    return_pointer : device_enum alt_enum;
    return_keyboard : device_enum alt_enum;
  }
  [@@deriving sexp]

  let decode_remove_master buf : remove_master =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let return_mode =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:change_mode_enum_of_int)
        buf
    in
    Decode.pad buf 1;
    let return_pointer =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let return_keyboard =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    ()

  type attach_slave = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    deviceid : device_enum alt_enum;
    master : device_enum alt_enum;
  }
  [@@deriving sexp]

  let decode_attach_slave buf : attach_slave =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let master =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    ()

  type detach_slave = {
    type_ : hierarchy_change_type_enum;
    len : u16;
    deviceid : device_enum alt_enum;
  }
  [@@deriving sexp]

  let decode_detach_slave buf : detach_slave =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:hierarchy_change_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    Decode.pad buf 2;
    ()

  type hierarchy_change_type_variant =
    | Add_master of { send_core : bool; enable : bool; name : string }
    | Remove_master of {
        deviceid : device_enum alt_enum;
        return_mode : change_mode_enum;
        return_pointer : device_enum alt_enum;
        return_keyboard : device_enum alt_enum;
      }
    | Attach_slave of {
        deviceid : device_enum alt_enum;
        master : device_enum alt_enum;
      }
    | Detach_slave of device_enum alt_enum
  [@@deriving sexp]

