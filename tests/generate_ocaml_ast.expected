    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let time =
      (Decode.alt_enum Xproto.decode_timestamp identity Xproto.time_enum_of_int)
        buf
    in
    let property = Xproto.decode_atom buf in
    let what =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:property_flag_enum_of_int)
        buf
    in
    Decode.pad buf 11;
    ignore length;
    { deviceid; time; property; what }

