    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let context_len = Decode.u32 buf in
    Decode.pad buf 20;
    let context = Decode.string ~len:context_len buf in
    ignore length;
    context

  type list_properties_reply = list_item list [@@deriving sexp]

  let decode_list_properties_reply buf : list_properties_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let properties_len = Decode.u32 buf in
    Decode.pad buf 20;
    let properties =
      (Decode.list ~item:decode_list_item) ~len:properties_len buf
    in
    ignore length;
    properties

  type get_selection_create_context_reply = string [@@deriving sexp]

  let decode_get_selection_create_context_reply buf :
      get_selection_create_context_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let context_len = Decode.u32 buf in
