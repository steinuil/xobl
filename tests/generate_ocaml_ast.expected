    let length = Decode.u32 buf in
    let num_feedbacks = Decode.u16 buf in
    Decode.pad buf 22;
    let feedbacks =
      (Decode.list ~item:decode_feedback_state) ~len:num_feedbacks buf
    in
    ignore length;
    { xi_reply_type; feedbacks }

