  type xi_get_client_pointer_reply = {
    set : bool;
    deviceid : device_enum alt_enum;
  }
  [@@deriving sexp]

  type xi_event_mask =
    [ `Device_changed
    | `Key_press
    | `Key_release
    | `Button_press
    | `Button_release
    | `Motion
    | `Enter
    | `Leave
    | `Focus_in
    | `Focus_out
    | `Hierarchy
    | `Property
    | `Raw_key_press
    | `Raw_key_release
    | `Raw_button_press
    | `Raw_button_release
    | `Raw_motion
    | `Touch_begin
    | `Touch_update
    | `Touch_end
    | `Touch_ownership
    | `Raw_touch_begin
    | `Raw_touch_update
    | `Raw_touch_end
    | `Barrier_hit
    | `Barrier_leave ]
    list
  [@@deriving sexp]

  type event_mask = {
    deviceid : device_enum alt_enum;
    mask : xi_event_mask list;
  }
  [@@deriving sexp]

  let decode_event_mask buf : event_mask =
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let mask_len = Decode.u16 buf in
    let mask =
      (Decode.list
         ~item:(Decode.mask Decode.u32 Int64.of_int xi_event_mask_mask_of_int64))
        ~len:mask_len buf
    in
    ()

  type xi_query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  type device_class_type_enum = [ `Key | `Button | `Valuator | `Scroll | `Touch ]
  [@@deriving sexp]

  type device_type_enum =
    [ `Master_pointer
    | `Master_keyboard
    | `Slave_pointer
    | `Slave_keyboard
    | `Floating_slave ]
  [@@deriving sexp]

  type scroll_flags_mask = [ `No_emulation | `Preferred ] list [@@deriving sexp]
  type scroll_type_enum = [ `Vertical | `Horizontal ] [@@deriving sexp]
  type touch_mode_enum = [ `Direct | `Dependent ] [@@deriving sexp]

  type button_class = {
    type_ : device_class_type_enum;
    len : u16;
    sourceid : device_id;
    state : u32 list;
    labels : Xproto.atom list;
  }
  [@@deriving sexp]

  let decode_button_class buf : button_class =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_class_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let sourceid = decode_device_id buf in
    let num_buttons = Decode.u16 buf in
    let state =
      (Decode.list ~item:Decode.u32) ~len:((num_buttons + 31) / 32) buf
    in
    let labels = (Decode.list ~item:Xproto.decode_atom) ~len:num_buttons buf in
    ()

  type key_class = {
    type_ : device_class_type_enum;
    len : u16;
    sourceid : device_id;
    keys : u32 list;
  }
  [@@deriving sexp]

  let decode_key_class buf : key_class =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_class_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let sourceid = decode_device_id buf in
    let num_keys = Decode.u16 buf in
    let keys = (Decode.list ~item:Decode.u32) ~len:num_keys buf in
    ()

  type scroll_class = {
    type_ : device_class_type_enum;
    len : u16;
    sourceid : device_id;
    number : u16;
    scroll_type : scroll_type_enum;
    flags : scroll_flags_mask;
    increment : fp3232;
  }
  [@@deriving sexp]

  let decode_scroll_class buf : scroll_class =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_class_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let sourceid = decode_device_id buf in
    let number = Decode.u16 buf in
    let scroll_type =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:scroll_type_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let flags =
      (Decode.mask Decode.u32 Int64.of_int scroll_flags_mask_of_int64) buf
    in
    let increment = decode_fp3232 buf in
    ()

  type touch_class = {
    type_ : device_class_type_enum;
    len : u16;
    sourceid : device_id;
    mode : touch_mode_enum;
    num_touches : u8;
  }
  [@@deriving sexp]

  let decode_touch_class buf : touch_class =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_class_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let sourceid = decode_device_id buf in
    let mode =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:touch_mode_enum_of_int)
        buf
    in
    let num_touches = Decode.u8 buf in
    ()

  type valuator_class = {
    type_ : device_class_type_enum;
    len : u16;
    sourceid : device_id;
    number : u16;
    label : Xproto.atom;
    min : fp3232;
    max : fp3232;
    value : fp3232;
    resolution : u32;
    mode : valuator_mode_enum;
  }
  [@@deriving sexp]

  let decode_valuator_class buf : valuator_class =
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_class_type_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let sourceid = decode_device_id buf in
    let number = Decode.u16 buf in
    let label = Xproto.decode_atom buf in
    let min = decode_fp3232 buf in
    let max = decode_fp3232 buf in
    let value = decode_fp3232 buf in
    let resolution = Decode.u32 buf in
    let mode =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:valuator_mode_enum_of_int)
        buf
    in
    Decode.pad buf 3;
    ()

  type device_class_type_variant =
    | Key of u32 list
    | Button of { state : u32 list; labels : Xproto.atom list }
    | Valuator of {
        number : u16;
        label : Xproto.atom;
        min : fp3232;
        max : fp3232;
        value : fp3232;
        resolution : u32;
        mode : valuator_mode_enum;
      }
    | Scroll of {
        number : u16;
        scroll_type : scroll_type_enum;
        flags : scroll_flags_mask;
        increment : fp3232;
      }
    | Touch of { mode : touch_mode_enum; num_touches : u8 }
  [@@deriving sexp]

  type device_class = {
    len : u16;
    sourceid : device_id;
    data : device_class_type_variant;
  }
  [@@deriving sexp]

  let decode_device_class buf : device_class =
    let data_tag = Decode.u16 buf in
    let len = Decode.u16 buf in
    let sourceid = decode_device_id buf in
    ()

  type xi_device_info = {
    deviceid : device_enum alt_enum;
    type_ : device_type_enum;
    attachment : device_enum alt_enum;
    enabled : bool;
    name : string;
    classes : device_class list;
  }
  [@@deriving sexp]

  let decode_xi_device_info buf : xi_device_info =
    let deviceid =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let type_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_type_enum_of_int)
        buf
    in
    let attachment =
      (Decode.alt_enum decode_device_id identity device_enum_of_int) buf
    in
    let num_classes = Decode.u16 buf in
    let name_len = Decode.u16 buf in
    let enabled = Decode.bool buf in
    Decode.pad buf 1;
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    let classes =
      (Decode.list ~item:decode_device_class) ~len:num_classes buf
    in
    ()

  type xi_query_device_reply = xi_device_info list [@@deriving sexp]
  type xi_get_focus_reply = Xproto.window [@@deriving sexp]
  type grab_owner_enum = [ `No_owner | `Owner ] [@@deriving sexp]
  type xi_grab_device_reply = Xproto.grab_status_enum [@@deriving sexp]

  type event_mode_enum =
    [ `Async_device
