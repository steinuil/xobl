  let decode_list_properties_reply buf : list_properties_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let atoms_len = Decode.u16 buf in
    Decode.pad buf 22;
    let atoms = (Decode.list ~item:decode_atom) ~len:atoms_len buf in
    ignore length;
    atoms

