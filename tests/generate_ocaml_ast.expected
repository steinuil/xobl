  type device_input_mode_enum =
    [ `Async_this_device
    | `Sync_this_device
    | `Replay_this_device
    | `Async_other_devices
    | `Async_all
    | `Sync_all ]
  [@@deriving sexp]

  let device_input_mode_enum_of_int n : [ device_input_mode_enum | int custom ]
      =
    match n with
    | 0 -> `Async_this_device
    | 1 -> `Sync_this_device
    | 2 -> `Replay_this_device
    | 3 -> `Async_other_devices
    | 4 -> `Async_all
    | 5 -> `Sync_all
    | _ -> `Custom n

