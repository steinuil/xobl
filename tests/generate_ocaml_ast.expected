    let number = Decode.u16 buf in
    let scroll_type =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:scroll_type_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let flags =
      (Decode.mask Decode.u32 Int64.of_int scroll_flags_mask_of_int64) buf
    in
    let increment = decode_fp3232 buf in
    { type_; len; sourceid; number; scroll_type; flags; increment }

