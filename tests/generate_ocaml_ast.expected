    map_state : map_state_enum;
    override_redirect : bool;
    colormap : [ colormap_enum | colormap custom ];
    all_event_masks : event_mask;
    your_event_mask : event_mask;
    do_not_propagate_mask : event_mask;
  }
  [@@deriving sexp]

  let decode_get_window_attributes_reply buf : get_window_attributes_reply =
    Decode.pad buf 1;
    let backing_store =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:backing_store_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let visual = decode_visualid buf in
    let class_ =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:window_class_enum_of_int)
        buf
    in
    let bit_gravity =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:gravity_enum_of_int)
        buf
    in
    let win_gravity =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:gravity_enum_of_int)
        buf
    in
    let backing_planes = Decode.u32 buf in
    let backing_pixel = Decode.u32 buf in
    let save_under = Decode.bool buf in
    let map_is_installed = Decode.bool buf in
    let map_state =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:map_state_enum_of_int)
        buf
    in
    let override_redirect = Decode.bool buf in
    let colormap =
      (Decode.alt_enum decode_colormap identity colormap_enum_of_int) buf
    in
    let all_event_masks =
      (Decode.mask Decode.u32 Int64.of_int event_mask_mask_of_int64) buf
    in
    let your_event_mask =
      (Decode.mask Decode.u32 Int64.of_int event_mask_mask_of_int64) buf
    in
    let do_not_propagate_mask =
      (Decode.mask Decode.u16 Int64.of_int event_mask_mask_of_int64) buf
    in
    Decode.pad buf 2;
    ignore length;
    {
      backing_store;
      visual;
      class_;
      bit_gravity;
      win_gravity;
      backing_planes;
      backing_pixel;
      save_under;
      map_is_installed;
      map_state;
      override_redirect;
      colormap;
      all_event_masks;
      your_event_mask;
      do_not_propagate_mask;
    }

