  type get_device_key_mapping_reply = {
    xi_reply_type : u8;
    keysyms_per_keycode : u8;
    keysyms : Xproto.keysym list;
  }
  [@@deriving sexp]

  let decode_get_device_key_mapping_reply buf : get_device_key_mapping_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let keysyms_per_keycode = Decode.u8 buf in
    Decode.pad buf 23;
    let keysyms = (Decode.list ~item:Xproto.decode_keysym) ~len:length buf in
    ignore length;
    { xi_reply_type; keysyms_per_keycode; keysyms }

  type get_device_modifier_mapping_reply = {
    xi_reply_type : u8;
    keymaps : u8 list;
  }
  [@@deriving sexp]

  let decode_get_device_modifier_mapping_reply buf :
      get_device_modifier_mapping_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let keycodes_per_modifier = Decode.u8 buf in
    let keycodes_per_modifier = keycodes_per_modifier / 8 in
    Decode.pad buf 23;
    let keymaps =
      (Decode.list ~item:Decode.u8) ~len:keycodes_per_modifier buf
    in
    ignore length;
    { xi_reply_type; keymaps }

  type set_device_modifier_mapping_reply = {
    xi_reply_type : u8;
    status : Xproto.mapping_status_enum;
  }
  [@@deriving sexp]

  let decode_set_device_modifier_mapping_reply buf :
      set_device_modifier_mapping_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.mapping_status_enum_of_int)
        buf
    in
    Decode.pad buf 23;
    ignore length;
    { xi_reply_type; status }

  type get_device_button_mapping_reply = { xi_reply_type : u8; map : u8 list }
  [@@deriving sexp]

  let decode_get_device_button_mapping_reply buf :
      get_device_button_mapping_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let map_size = Decode.u8 buf in
    Decode.pad buf 23;
    let map = (Decode.list ~item:Decode.u8) ~len:map_size buf in
    Decode.align buf 4;
    ignore length;
    { xi_reply_type; map }

  type set_device_button_mapping_reply = {
    xi_reply_type : u8;
    status : Xproto.mapping_status_enum;
  }
  [@@deriving sexp]

  let decode_set_device_button_mapping_reply buf :
      set_device_button_mapping_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.mapping_status_enum_of_int)
        buf
    in
    Decode.pad buf 23;
    ignore length;
    { xi_reply_type; status }

  type key_state = {
    class_id : input_class_enum;
    len : u8;
    num_keys : u8;
    keys : u8 list;
  }
  [@@deriving sexp]

  let decode_key_state buf : key_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let num_keys = Decode.u8 buf in
    Decode.pad buf 1;
    let keys = (Decode.list ~item:Decode.u8) ~len:32 buf in
    { class_id; len; num_keys; keys }

  type button_state = {
    class_id : input_class_enum;
    len : u8;
    num_buttons : u8;
    buttons : u8 list;
  }
  [@@deriving sexp]

  let decode_button_state buf : button_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let num_buttons = Decode.u8 buf in
    Decode.pad buf 1;
    let buttons = (Decode.list ~item:Decode.u8) ~len:32 buf in
    { class_id; len; num_buttons; buttons }

  type valuator_state_mode_mask =
    [ `Device_mode_absolute | `Out_of_proximity ] list
  [@@deriving sexp]

  type valuator_state = {
    class_id : input_class_enum;
    len : u8;
    mode : valuator_state_mode_mask;
    valuators : i32 list;
  }
  [@@deriving sexp]

  let decode_valuator_state buf : valuator_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:input_class_enum_of_int)
        buf
    in
    let len = Decode.u8 buf in
    let num_valuators = Decode.u8 buf in
    let mode =
      (Decode.mask Decode.u8 Int64.of_int valuator_state_mode_mask_mask_of_int64)
        buf
    in
    let valuators = (Decode.list ~item:Decode.i32) ~len:num_valuators buf in
    { class_id; len; mode; valuators }

  type input_state = { len : u8; data : input_class_variant } [@@deriving sexp]

  let decode_input_state buf : input_state =
    let data_tag = Decode.u8 buf in
    let len = Decode.u8 buf in
    let data = decode_input_class_variant ~tag:data_tag buf in
    { len; data }

  type query_device_state_reply = {
    xi_reply_type : u8;
    classes : input_state list;
  }
  [@@deriving sexp]

  let decode_query_device_state_reply buf : query_device_state_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let num_classes = Decode.u8 buf in
    Decode.pad buf 23;
    let classes = (Decode.list ~item:decode_input_state) ~len:num_classes buf in
    ignore length;
    { xi_reply_type; classes }

  type set_device_valuators_reply = {
    xi_reply_type : u8;
    status : Xproto.grab_status_enum;
  }
  [@@deriving sexp]

  let decode_set_device_valuators_reply buf : set_device_valuators_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let status =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.grab_status_enum_of_int)
        buf
    in
    Decode.pad buf 23;
    ignore length;
    { xi_reply_type; status }

  type device_control_enum =
    [ `Resolution | `Abs_calib | `Core | `Enable | `Abs_area ]
  [@@deriving sexp]

  let device_control_enum_of_int n : [ device_control_enum | int custom ] =
    match n with
    | 1 -> `Resolution
    | 2 -> `Abs_calib
    | 3 -> `Core
    | 4 -> `Enable
    | 5 -> `Abs_area
    | _ -> `Custom n

  type device_resolution_state = {
    control_id : device_control_enum;
    len : u16;
    resolution_values : u32 list;
    resolution_min : u32 list;
    resolution_max : u32 list;
  }
  [@@deriving sexp]

  let decode_device_resolution_state buf : device_resolution_state =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let num_valuators = Decode.u32 buf in
    let resolution_values =
      (Decode.list ~item:Decode.u32) ~len:num_valuators buf
    in
    let resolution_min =
      (Decode.list ~item:Decode.u32) ~len:num_valuators buf
    in
    let resolution_max =
      (Decode.list ~item:Decode.u32) ~len:num_valuators buf
    in
    { control_id; len; resolution_values; resolution_min; resolution_max }

  type device_abs_calib_state = {
    control_id : device_control_enum;
    len : u16;
    min_x : i32;
    max_x : i32;
    min_y : i32;
    max_y : i32;
    flip_x : u32;
    flip_y : u32;
    rotation : u32;
    button_threshold : u32;
  }
  [@@deriving sexp]

  let decode_device_abs_calib_state buf : device_abs_calib_state =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let min_x = Decode.i32 buf in
    let max_x = Decode.i32 buf in
    let min_y = Decode.i32 buf in
    let max_y = Decode.i32 buf in
    let flip_x = Decode.u32 buf in
    let flip_y = Decode.u32 buf in
    let rotation = Decode.u32 buf in
    let button_threshold = Decode.u32 buf in
    {
      control_id;
      len;
      min_x;
      max_x;
      min_y;
      max_y;
      flip_x;
      flip_y;
      rotation;
      button_threshold;
    }

  type device_abs_area_state = {
    control_id : device_control_enum;
    len : u16;
    offset_x : u32;
    offset_y : u32;
    width : u32;
    height : u32;
    screen : u32;
    following : u32;
  }
  [@@deriving sexp]

  let decode_device_abs_area_state buf : device_abs_area_state =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let offset_x = Decode.u32 buf in
    let offset_y = Decode.u32 buf in
    let width = Decode.u32 buf in
    let height = Decode.u32 buf in
    let screen = Decode.u32 buf in
    let following = Decode.u32 buf in
    { control_id; len; offset_x; offset_y; width; height; screen; following }

  type device_core_state = {
    control_id : device_control_enum;
    len : u16;
    status : u8;
    iscore : u8;
  }
  [@@deriving sexp]

  let decode_device_core_state buf : device_core_state =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let status = Decode.u8 buf in
    let iscore = Decode.u8 buf in
    Decode.pad buf 2;
    { control_id; len; status; iscore }

  type device_enable_state = {
    control_id : device_control_enum;
    len : u16;
    enable : u8;
  }
  [@@deriving sexp]

  let decode_device_enable_state buf : device_enable_state =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let enable = Decode.u8 buf in
    Decode.pad buf 3;
    { control_id; len; enable }

  type device_control_variant =
    | Resolution of {
        resolution_values : u32 list;
        resolution_min : u32 list;
        resolution_max : u32 list;
      }
    | Abs_calib of {
        min_x : i32;
        max_x : i32;
        min_y : i32;
        max_y : i32;
        flip_x : u32;
        flip_y : u32;
        rotation : u32;
        button_threshold : u32;
      }
    | Core of { status : u8; iscore : u8 }
    | Enable of u8
    | Abs_area of {
        offset_x : u32;
        offset_y : u32;
        width : u32;
        height : u32;
        screen : u32;
        following : u32;
      }
  [@@deriving sexp]

  let decode_device_control_variant buf ~tag : device_control_variant =
    match tag with
    | 1 ->
        let num_valuators = Decode.u32 buf in
        let resolution_values =
          (Decode.list ~item:Decode.u32) ~len:num_valuators buf
        in
        let resolution_min =
          (Decode.list ~item:Decode.u32) ~len:num_valuators buf
        in
        let resolution_max =
          (Decode.list ~item:Decode.u32) ~len:num_valuators buf
        in
        Resolution { resolution_values; resolution_min; resolution_max }
    | 2 ->
        let min_x = Decode.i32 buf in
        let max_x = Decode.i32 buf in
        let min_y = Decode.i32 buf in
        let max_y = Decode.i32 buf in
        let flip_x = Decode.u32 buf in
        let flip_y = Decode.u32 buf in
        let rotation = Decode.u32 buf in
        let button_threshold = Decode.u32 buf in
        Abs_calib
          {
            min_x;
            max_x;
            min_y;
            max_y;
            flip_x;
            flip_y;
            rotation;
            button_threshold;
          }
    | 3 ->
        let status = Decode.u8 buf in
        let iscore = Decode.u8 buf in
        Decode.pad buf 2;
        Core { status; iscore }
    | 4 ->
        let enable = Decode.u8 buf in
        Decode.pad buf 3;
        Enable enable
    | 5 ->
        let offset_x = Decode.u32 buf in
        let offset_y = Decode.u32 buf in
        let width = Decode.u32 buf in
        let height = Decode.u32 buf in
        let screen = Decode.u32 buf in
        let following = Decode.u32 buf in
        Abs_area { offset_x; offset_y; width; height; screen; following }

  type device_state = { len : u16; data : device_control_variant }
  [@@deriving sexp]

  let decode_device_state buf : device_state =
    let data_tag = Decode.u16 buf in
    let len = Decode.u16 buf in
    let data = decode_device_control_variant ~tag:data_tag buf in
    { len; data }

  type get_device_control_reply = {
    xi_reply_type : u8;
    status : [ Xproto.grab_status_enum | u8 custom ];
    control : device_state;
  }
  [@@deriving sexp]

  let decode_get_device_control_reply buf : get_device_control_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let status =
      (Decode.alt_enum Decode.u8 identity Xproto.grab_status_enum_of_int) buf
    in
    Decode.pad buf 23;
    let control = decode_device_state buf in
    ignore length;
    { xi_reply_type; status; control }

  type device_resolution_ctl = {
    control_id : device_control_enum;
    len : u16;
    first_valuator : u8;
    resolution_values : u32 list;
  }
  [@@deriving sexp]

  let decode_device_resolution_ctl buf : device_resolution_ctl =
    let control_id =
      (Decode.enum ~decode:Decode.u16 ~int_of_t:identity
         ~enum_of_int:device_control_enum_of_int)
        buf
    in
    let len = Decode.u16 buf in
    let first_valuator = Decode.u8 buf in
    let num_valuators = Decode.u8 buf in
    Decode.pad buf 2;
    let resolution_values =
      (Decode.list ~item:Decode.u32) ~len:num_valuators buf
    in
    { control_id; len; first_valuator; resolution_values }

  type device_abs_calib_ctl = {
    control_id : device_control_enum;
