    | 62 -> `Hsl_luminosity
    | _ -> `Custom n

  type poly_edge_enum = [ `Sharp | `Smooth ] [@@deriving sexp]

  let poly_edge_enum_of_int n : [ poly_edge_enum | int custom ] =
    match n with 0 -> `Sharp | 1 -> `Smooth | _ -> `Custom n

  type poly_mode_enum = [ `Precise | `Imprecise ] [@@deriving sexp]

  let poly_mode_enum_of_int n : [ poly_mode_enum | int custom ] =
    match n with 0 -> `Precise | 1 -> `Imprecise | _ -> `Custom n

  type cp_mask =
    [ `Repeat
    | `Alpha_map
    | `Alpha_x_origin
    | `Alpha_y_origin
    | `Clip_x_origin
    | `Clip_y_origin
    | `Clip_mask
    | `Graphics_exposure
    | `Subwindow_mode
    | `Poly_edge
    | `Poly_mode
    | `Dither
    | `Component_alpha ]
    list
  [@@deriving sexp]

  type sub_pixel_enum =
    [ `Unknown
    | `Horizontal_rgb
    | `Horizontal_bgr
    | `Vertical_rgb
    | `Vertical_bgr
    | `None ]
  [@@deriving sexp]

  let sub_pixel_enum_of_int n : [ sub_pixel_enum | int custom ] =
    match n with
    | 0 -> `Unknown
    | 1 -> `Horizontal_rgb
    | 2 -> `Horizontal_bgr
    | 3 -> `Vertical_rgb
    | 4 -> `Vertical_bgr
    | 5 -> `None
    | _ -> `Custom n

  type repeat_enum = [ `None | `Normal | `Pad | `Reflect ] [@@deriving sexp]

  let repeat_enum_of_int n : [ repeat_enum | int custom ] =
    match n with
    | 0 -> `None
    | 1 -> `Normal
    | 2 -> `Pad
    | 3 -> `Reflect
    | _ -> `Custom n

  type glyph = u32 [@@deriving sexp]

  let decode_glyph = Decode.u32

  type glyphset = xid [@@deriving sexp]

  let decode_glyphset = Decode.xid

  type picture = xid [@@deriving sexp]

  let decode_picture = Decode.xid

  type pictformat = xid [@@deriving sexp]

  let decode_pictformat = Decode.xid

  type fixed = i32 [@@deriving sexp]

  let decode_fixed = Decode.i32

  type pict_format_error = unit [@@deriving sexp]

  let decode_pict_format_error _ : pict_format_error = Decode.pad 32

  type picture_error = unit [@@deriving sexp]

  let decode_picture_error _ : picture_error = Decode.pad 32

  type pict_op_error = unit [@@deriving sexp]

  let decode_pict_op_error _ : pict_op_error = Decode.pad 32

  type glyph_set_error = unit [@@deriving sexp]

  let decode_glyph_set_error _ : glyph_set_error = Decode.pad 32

  type glyph_error = unit [@@deriving sexp]

  let decode_glyph_error _ : glyph_error = Decode.pad 32

  type directformat = {
    red_shift : u16;
    red_mask : u16;
    green_shift : u16;
    green_mask : u16;
    blue_shift : u16;
    blue_mask : u16;
    alpha_shift : u16;
    alpha_mask : u16;
  }
  [@@deriving sexp]

  let decode_directformat buf : directformat =
    let red_shift = Decode.u16 buf in
    let red_mask = Decode.u16 buf in
    let green_shift = Decode.u16 buf in
    let green_mask = Decode.u16 buf in
    let blue_shift = Decode.u16 buf in
    let blue_mask = Decode.u16 buf in
    let alpha_shift = Decode.u16 buf in
    let alpha_mask = Decode.u16 buf in
    {
      red_shift;
      red_mask;
      green_shift;
      green_mask;
      blue_shift;
      blue_mask;
      alpha_shift;
      alpha_mask;
    }

  type pictforminfo = {
    id : pictformat;
    type_ : pict_type_enum;
    depth : u8;
    direct : directformat;
    colormap : Xproto.colormap;
  }
  [@@deriving sexp]

  let decode_pictforminfo buf : pictforminfo =
    let id = decode_pictformat buf in
    let type_ =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:pict_type_enum_of_int)
        buf
    in
    let depth = Decode.u8 buf in
    Decode.pad buf 2;
    let direct = decode_directformat buf in
    let colormap = Xproto.decode_colormap buf in
    { id; type_; depth; direct; colormap }

  type pictvisual = { visual : Xproto.visualid; format : pictformat }
  [@@deriving sexp]

  let decode_pictvisual buf : pictvisual =
    let visual = Xproto.decode_visualid buf in
    let format = decode_pictformat buf in
    { visual; format }

  type pictdepth = { depth : u8; visuals : pictvisual list } [@@deriving sexp]

  let decode_pictdepth buf : pictdepth =
    let depth = Decode.u8 buf in
    Decode.pad buf 1;
    let num_visuals = Decode.u16 buf in
    Decode.pad buf 4;
    let visuals = (Decode.list ~item:decode_pictvisual) ~len:num_visuals buf in
    { depth; visuals }

  type pictscreen = { fallback : pictformat; depths : pictdepth list }
  [@@deriving sexp]

  let decode_pictscreen buf : pictscreen =
    let num_depths = Decode.u32 buf in
    let fallback = decode_pictformat buf in
    let depths = (Decode.list ~item:decode_pictdepth) ~len:num_depths buf in
    { fallback; depths }

  type indexvalue = {
    pixel : u32;
    red : u16;
    green : u16;
    blue : u16;
    alpha : u16;
  }
  [@@deriving sexp]

  let decode_indexvalue buf : indexvalue =
    let pixel = Decode.u32 buf in
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    let alpha = Decode.u16 buf in
    { pixel; red; green; blue; alpha }

  type color = { red : u16; green : u16; blue : u16; alpha : u16 }
  [@@deriving sexp]

  let decode_color buf : color =
    let red = Decode.u16 buf in
    let green = Decode.u16 buf in
    let blue = Decode.u16 buf in
    let alpha = Decode.u16 buf in
    { red; green; blue; alpha }

  type pointfix = { x : fixed; y : fixed } [@@deriving sexp]

  let decode_pointfix buf : pointfix =
    let x = decode_fixed buf in
    let y = decode_fixed buf in
    { x; y }

  type linefix = { p1 : pointfix; p2 : pointfix } [@@deriving sexp]

  let decode_linefix buf : linefix =
    let p1 = decode_pointfix buf in
    let p2 = decode_pointfix buf in
    { p1; p2 }

  type triangle = { p1 : pointfix; p2 : pointfix; p3 : pointfix }
  [@@deriving sexp]

  let decode_triangle buf : triangle =
    let p1 = decode_pointfix buf in
    let p2 = decode_pointfix buf in
    let p3 = decode_pointfix buf in
    { p1; p2; p3 }

  type trapezoid = {
    top : fixed;
    bottom : fixed;
    left : linefix;
    right : linefix;
  }
  [@@deriving sexp]

  let decode_trapezoid buf : trapezoid =
    let top = decode_fixed buf in
    let bottom = decode_fixed buf in
    let left = decode_linefix buf in
    let right = decode_linefix buf in
    { top; bottom; left; right }

  type glyphinfo = {
    width : u16;
    height : u16;
    x : i16;
    y : i16;
    x_off : i16;
    y_off : i16;
  }
  [@@deriving sexp]

  let decode_glyphinfo buf : glyphinfo =
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let x_off = Decode.i16 buf in
    let y_off = Decode.i16 buf in
    { width; height; x; y; x_off; y_off }

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    { major_version; minor_version }

  type query_pict_formats_reply = {
    num_depths : u32;
    num_visuals : u32;
    formats : pictforminfo list;
    screens : pictscreen list;
    subpixels : sub_pixel_enum list;
  }
  [@@deriving sexp]

  let decode_query_pict_formats_reply buf : query_pict_formats_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_formats = Decode.u32 buf in
    let num_screens = Decode.u32 buf in
    let num_depths = Decode.u32 buf in
    let num_visuals = Decode.u32 buf in
    let num_subpixel = Decode.u32 buf in
    Decode.pad buf 4;
    let formats =
      (Decode.list ~item:decode_pictforminfo) ~len:num_formats buf
    in
    let screens = (Decode.list ~item:decode_pictscreen) ~len:num_screens buf in
    let subpixels =
      (Decode.list
         ~item:
           (Decode.enum ~decode:Decode.u32 ~int_of_t:identity
              ~enum_of_int:sub_pixel_enum_of_int))
        ~len:num_subpixel buf
    in
    ignore length;
    { num_depths; num_visuals; formats; screens; subpixels }

  type query_pict_index_values_reply = indexvalue list [@@deriving sexp]

  let decode_query_pict_index_values_reply buf : query_pict_index_values_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_values = Decode.u32 buf in
    Decode.pad buf 20;
    let values = (Decode.list ~item:decode_indexvalue) ~len:num_values buf in
    ignore length;
    values

  type transform = {
    matrix11 : fixed;
    matrix12 : fixed;
    matrix13 : fixed;
    matrix21 : fixed;
    matrix22 : fixed;
    matrix23 : fixed;
    matrix31 : fixed;
    matrix32 : fixed;
    matrix33 : fixed;
  }
  [@@deriving sexp]

  let decode_transform buf : transform =
    let matrix11 = decode_fixed buf in
    let matrix12 = decode_fixed buf in
    let matrix13 = decode_fixed buf in
    let matrix21 = decode_fixed buf in
    let matrix22 = decode_fixed buf in
    let matrix23 = decode_fixed buf in
    let matrix31 = decode_fixed buf in
    let matrix32 = decode_fixed buf in
    let matrix33 = decode_fixed buf in
    {
      matrix11;
      matrix12;
      matrix13;
      matrix21;
      matrix22;
      matrix23;
      matrix31;
      matrix32;
      matrix33;
    }

  type query_filters_reply = { aliases : u16 list; filters : Xproto.str list }
  [@@deriving sexp]

  let decode_query_filters_reply buf : query_filters_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let num_aliases = Decode.u32 buf in
    let num_filters = Decode.u32 buf in
    Decode.pad buf 16;
    let aliases = (Decode.list ~item:Decode.u16) ~len:num_aliases buf in
    let filters = (Decode.list ~item:Xproto.decode_str) ~len:num_filters buf in
    ignore length;
    { aliases; filters }

  type animcursorelt = { cursor : Xproto.cursor; delay : u32 } [@@deriving sexp]

  let decode_animcursorelt buf : animcursorelt =
    let cursor = Xproto.decode_cursor buf in
    let delay = Decode.u32 buf in
    { cursor; delay }

  type spanfix = { l : fixed; r : fixed; y : fixed } [@@deriving sexp]

  let decode_spanfix buf : spanfix =
    let l = decode_fixed buf in
    let r = decode_fixed buf in
    let y = decode_fixed buf in
    { l; r; y }

  type trap = { top : spanfix; bot : spanfix } [@@deriving sexp]

  let decode_trap buf : trap =
    let top = decode_spanfix buf in
    let bot = decode_spanfix buf in
    { top; bot }
end

module Shape = struct
  type op = u8 [@@deriving sexp]

  let decode_op = Decode.u8

  type kind = u8 [@@deriving sexp]

  let decode_kind = Decode.u8

  type so_enum = [ `Set | `Union | `Intersect | `Subtract | `Invert ]
  [@@deriving sexp]

  let so_enum_of_int n : [ so_enum | int custom ] =
    match n with
    | 0 -> `Set
    | 1 -> `Union
    | 2 -> `Intersect
    | 3 -> `Subtract
    | 4 -> `Invert
    | _ -> `Custom n

  type sk_enum = [ `Bounding | `Clip | `Input ] [@@deriving sexp]

  let sk_enum_of_int n : [ sk_enum | int custom ] =
    match n with 0 -> `Bounding | 1 -> `Clip | 2 -> `Input | _ -> `Custom n

  type notify_event = {
    shape_kind : sk_enum;
    affected_window : Xproto.window;
    extents_x : i16;
    extents_y : i16;
    extents_width : u16;
    extents_height : u16;
    server_time : Xproto.timestamp;
    shaped : bool;
  }
  [@@deriving sexp]

  let decode_notify_event buf : notify_event =
    Decode.pad buf 1;
    let shape_kind =
      (Decode.enum ~decode:decode_kind ~int_of_t:identity
         ~enum_of_int:sk_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let affected_window = Xproto.decode_window buf in
    let extents_x = Decode.i16 buf in
    let extents_y = Decode.i16 buf in
    let extents_width = Decode.u16 buf in
    let extents_height = Decode.u16 buf in
    let server_time = Xproto.decode_timestamp buf in
    let shaped = Decode.bool buf in
    Decode.pad buf 11;
    ignore length;
    {
      shape_kind;
      affected_window;
      extents_x;
      extents_y;
      extents_width;
      extents_height;
      server_time;
      shaped;
    }

  type query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u16 buf in
    let minor_version = Decode.u16 buf in
    ignore length;
    { major_version; minor_version }

  type query_extents_reply = {
    bounding_shaped : bool;
    clip_shaped : bool;
    bounding_shape_extents_x : i16;
    bounding_shape_extents_y : i16;
    bounding_shape_extents_width : u16;
    bounding_shape_extents_height : u16;
    clip_shape_extents_x : i16;
    clip_shape_extents_y : i16;
    clip_shape_extents_width : u16;
    clip_shape_extents_height : u16;
  }
  [@@deriving sexp]

  let decode_query_extents_reply buf : query_extents_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let bounding_shaped = Decode.bool buf in
    let clip_shaped = Decode.bool buf in
    Decode.pad buf 2;
    let bounding_shape_extents_x = Decode.i16 buf in
    let bounding_shape_extents_y = Decode.i16 buf in
    let bounding_shape_extents_width = Decode.u16 buf in
    let bounding_shape_extents_height = Decode.u16 buf in
    let clip_shape_extents_x = Decode.i16 buf in
    let clip_shape_extents_y = Decode.i16 buf in
    let clip_shape_extents_width = Decode.u16 buf in
    let clip_shape_extents_height = Decode.u16 buf in
    ignore length;
    {
      bounding_shaped;
      clip_shaped;
      bounding_shape_extents_x;
      bounding_shape_extents_y;
      bounding_shape_extents_width;
      bounding_shape_extents_height;
      clip_shape_extents_x;
      clip_shape_extents_y;
      clip_shape_extents_width;
      clip_shape_extents_height;
    }

  type input_selected_reply = bool [@@deriving sexp]

  let decode_input_selected_reply buf : input_selected_reply =
    Decode.pad buf 1;
    let enabled = Decode.bool buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    ignore length;
    enabled

  type get_rectangles_reply = {
    ordering : Xproto.clip_ordering_enum;
    rectangles : Xproto.rectangle list;
  }
  [@@deriving sexp]

  let decode_get_rectangles_reply buf : get_rectangles_reply =
    Decode.pad buf 1;
    let ordering =
      (Decode.enum ~decode:Decode.byte ~int_of_t:Char.code
         ~enum_of_int:Xproto.clip_ordering_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let rectangles_len = Decode.u32 buf in
    Decode.pad buf 20;
    let rectangles =
      (Decode.list ~item:Xproto.decode_rectangle) ~len:rectangles_len buf
    in
    ignore length;
    { ordering; rectangles }
end

module Xfixes = struct
  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    { major_version; minor_version }

  type save_set_mode_enum = [ `Insert | `Delete ] [@@deriving sexp]

  let save_set_mode_enum_of_int n : [ save_set_mode_enum | int custom ] =
    match n with 0 -> `Insert | 1 -> `Delete | _ -> `Custom n

  type save_set_target_enum = [ `Nearest | `Root ] [@@deriving sexp]

  let save_set_target_enum_of_int n : [ save_set_target_enum | int custom ] =
    match n with 0 -> `Nearest | 1 -> `Root | _ -> `Custom n

  type save_set_mapping_enum = [ `Map | `Unmap ] [@@deriving sexp]

  let save_set_mapping_enum_of_int n : [ save_set_mapping_enum | int custom ] =
    match n with 0 -> `Map | 1 -> `Unmap | _ -> `Custom n

  type selection_event_enum =
    [ `Set_selection_owner
    | `Selection_window_destroy
    | `Selection_client_close ]
  [@@deriving sexp]

  let selection_event_enum_of_int n : [ selection_event_enum | int custom ] =
    match n with
    | 0 -> `Set_selection_owner
    | 1 -> `Selection_window_destroy
    | 2 -> `Selection_client_close
    | _ -> `Custom n

  type selection_event_mask =
    [ `Set_selection_owner
    | `Selection_window_destroy
    | `Selection_client_close ]
    list
  [@@deriving sexp]

  type selection_notify_event = {
    subtype : selection_event_enum;
    window : Xproto.window;
    owner : Xproto.window;
    selection : Xproto.atom;
    timestamp : Xproto.timestamp;
    selection_timestamp : Xproto.timestamp;
  }
  [@@deriving sexp]

  let decode_selection_notify_event buf : selection_notify_event =
    Decode.pad buf 1;
    let subtype =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:selection_event_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let window = Xproto.decode_window buf in
    let owner = Xproto.decode_window buf in
    let selection = Xproto.decode_atom buf in
    let timestamp = Xproto.decode_timestamp buf in
    let selection_timestamp = Xproto.decode_timestamp buf in
    Decode.pad buf 8;
    ignore length;
    { subtype; window; owner; selection; timestamp; selection_timestamp }

  type cursor_notify_enum = [ `Display_cursor ] [@@deriving sexp]

  let cursor_notify_enum_of_int n : [ cursor_notify_enum | int custom ] =
    match n with 0 -> `Display_cursor | _ -> `Custom n

  type cursor_notify_mask = [ `Display_cursor ] list [@@deriving sexp]

  type cursor_notify_event = {
    subtype : cursor_notify_enum;
    window : Xproto.window;
    cursor_serial : u32;
    timestamp : Xproto.timestamp;
    name : [ Xproto.atom_enum | Xproto.atom custom ];
  }
  [@@deriving sexp]

  let decode_cursor_notify_event buf : cursor_notify_event =
    Decode.pad buf 1;
    let subtype =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:cursor_notify_enum_of_int)
        buf
    in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let window = Xproto.decode_window buf in
    let cursor_serial = Decode.u32 buf in
    let timestamp = Xproto.decode_timestamp buf in
    let name =
      (Decode.alt_enum Xproto.decode_atom identity Xproto.atom_enum_of_int) buf
    in
    Decode.pad buf 12;
    ignore length;
    { subtype; window; cursor_serial; timestamp; name }

  type get_cursor_image_reply = {
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    xhot : u16;
    yhot : u16;
    cursor_serial : u32;
    cursor_image : u32 list;
  }
  [@@deriving sexp]

  let decode_get_cursor_image_reply buf : get_cursor_image_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let xhot = Decode.u16 buf in
    let yhot = Decode.u16 buf in
    let cursor_serial = Decode.u32 buf in
    Decode.pad buf 8;
    let cursor_image =
      (Decode.list ~item:Decode.u32) ~len:(width * height) buf
    in
    ignore length;
    { x; y; width; height; xhot; yhot; cursor_serial; cursor_image }

  type region = xid [@@deriving sexp]

  let decode_region = Decode.xid

  type bad_region_error = unit [@@deriving sexp]

  let decode_bad_region_error _ : bad_region_error = Decode.pad 32

  type region_enum = [ `None ] [@@deriving sexp]

  let region_enum_of_int n : [ region_enum | int custom ] =
    match n with 0 -> `None | _ -> `Custom n

  type fetch_region_reply = {
    extents : Xproto.rectangle;
    rectangles : Xproto.rectangle list;
  }
  [@@deriving sexp]

  let decode_fetch_region_reply buf : fetch_region_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let extents = Xproto.decode_rectangle buf in
    Decode.pad buf 16;
    let rectangles =
      (Decode.list ~item:Xproto.decode_rectangle) ~len:(length / 2) buf
    in
    ignore length;
    { extents; rectangles }

  type get_cursor_name_reply = {
    atom : [ Xproto.atom_enum | Xproto.atom custom ];
    name : string;
  }
  [@@deriving sexp]

  let decode_get_cursor_name_reply buf : get_cursor_name_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let atom =
      (Decode.alt_enum Xproto.decode_atom identity Xproto.atom_enum_of_int) buf
    in
    let nbytes = Decode.u16 buf in
    Decode.pad buf 18;
    let name = Decode.string ~len:nbytes buf in
    ignore length;
    { atom; name }

  type get_cursor_image_and_name_reply = {
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    xhot : u16;
    yhot : u16;
    cursor_serial : u32;
    cursor_atom : [ Xproto.atom_enum | Xproto.atom custom ];
    cursor_image : u32 list;
    name : string;
  }
  [@@deriving sexp]

  let decode_get_cursor_image_and_name_reply buf :
      get_cursor_image_and_name_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let x = Decode.i16 buf in
    let y = Decode.i16 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let xhot = Decode.u16 buf in
    let yhot = Decode.u16 buf in
    let cursor_serial = Decode.u32 buf in
    let cursor_atom =
      (Decode.alt_enum Xproto.decode_atom identity Xproto.atom_enum_of_int) buf
    in
    let nbytes = Decode.u16 buf in
    Decode.pad buf 2;
    let cursor_image =
      (Decode.list ~item:Decode.u32) ~len:(width * height) buf
    in
    let name = Decode.string ~len:nbytes buf in
    ignore length;
    {
      x;
      y;
      width;
      height;
      xhot;
      yhot;
      cursor_serial;
      cursor_atom;
      cursor_image;
      name;
    }

  type barrier = xid [@@deriving sexp]

  let decode_barrier = Decode.xid

  type barrier_directions_mask =
    [ `Positive_x | `Positive_y | `Negative_x | `Negative_y ] list
  [@@deriving sexp]
end

module Composite = struct
  type redirect_enum = [ `Automatic | `Manual ] [@@deriving sexp]

  let redirect_enum_of_int n : [ redirect_enum | int custom ] =
    match n with 0 -> `Automatic | 1 -> `Manual | _ -> `Custom n

  type query_version_reply = { major_version : u32; minor_version : u32 }
  [@@deriving sexp]

  let decode_query_version_reply buf : query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u32 buf in
    let minor_version = Decode.u32 buf in
    Decode.pad buf 16;
    ignore length;
    { major_version; minor_version }

  type get_overlay_window_reply = Xproto.window [@@deriving sexp]

  let decode_get_overlay_window_reply buf : get_overlay_window_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let overlay_win = Xproto.decode_window buf in
