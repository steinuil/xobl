    client_driver_name : string;
  }
  [@@deriving sexp]

  type create_context_reply = u32 [@@deriving sexp]
  type create_drawable_reply = u32 [@@deriving sexp]

  type get_drawable_info_reply = {
    drawable_table_index : u32;
    drawable_table_stamp : u32;
    drawable_origin_x : i16;
    drawable_origin_y : i16;
    drawable_size_w : i16;
    drawable_size_h : i16;
