  [@@deriving sexp]

  let decode_print_get_page_dimensions_reply buf :
      print_get_page_dimensions_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let width = Decode.u16 buf in
    let height = Decode.u16 buf in
    let offset_x = Decode.u16 buf in
    let offset_y = Decode.u16 buf in
    let reproducible_width = Decode.u16 buf in
    let reproducible_height = Decode.u16 buf in
    ignore length;
    {
      width;
      height;
      offset_x;
      offset_y;
      reproducible_width;
      reproducible_height;
    }

  type print_query_screens_reply = Xproto.window list [@@deriving sexp]

  let decode_print_query_screens_reply buf : print_query_screens_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let list_count = Decode.u32 buf in
    Decode.pad buf 20;
    let roots = (Decode.list ~item:Xproto.decode_window) ~len:list_count buf in
    ignore length;
    roots

