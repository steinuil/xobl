    let num_classes = Decode.u8 buf in
    Decode.pad buf 23;
    let class_info =
      (Decode.list ~item:decode_input_class_info) ~len:num_classes buf
    in
    Decode.align buf 4;
    ignore length;
    { xi_reply_type; class_info }

