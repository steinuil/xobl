    status : bool;
    previous_resolutions : u16;
  }
  [@@deriving sexp]

  let decode_print_set_image_resolution_reply buf :
      print_set_image_resolution_reply =
    Decode.pad buf 1;
    let status = Decode.bool buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let previous_resolutions = Decode.u16 buf in
    ignore length;
    { status; previous_resolutions }

