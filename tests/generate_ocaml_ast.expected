    xi_reply_type : u8;
    focus : [ Xproto.input_focus_enum | Xproto.window custom ];
    time : Xproto.timestamp;
    revert_to : Xproto.input_focus_enum;
  }
  [@@deriving sexp]

  let decode_get_device_focus_reply buf : get_device_focus_reply =
    Decode.pad buf 1;
    let xi_reply_type = Decode.u8 buf in
    Decode.pad buf 2;
    let length = Decode.u32 buf in
    let focus =
      (Decode.alt_enum Xproto.decode_window identity
         Xproto.input_focus_enum_of_int)
        buf
    in
    let time = Xproto.decode_timestamp buf in
    let revert_to =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:Xproto.input_focus_enum_of_int)
        buf
    in
    Decode.pad buf 15;
    ignore length;
    { xi_reply_type; focus; time; revert_to }

  type feedback_class_enum =
    [ `Keyboard | `Pointer | `String | `Integer | `Led | `Bell ]
  [@@deriving sexp]

  let feedback_class_enum_of_int n : [ feedback_class_enum | int custom ] =
    match n with
    | 0 -> `Keyboard
    | 1 -> `Pointer
    | 2 -> `String
    | 3 -> `Integer
    | 4 -> `Led
    | 5 -> `Bell
    | _ -> `Custom n

  type kbd_feedback_state = {
    class_id : feedback_class_enum;
    feedback_id : u8;
    len : u16;
    pitch : u16;
    duration : u16;
    led_mask : u32;
    led_values : u32;
    global_auto_repeat : bool;
    click : u8;
    percent : u8;
    auto_repeats : u8 list;
  }
  [@@deriving sexp]

  let decode_kbd_feedback_state buf : kbd_feedback_state =
    let class_id =
      (Decode.enum ~decode:Decode.u8 ~int_of_t:identity
         ~enum_of_int:feedback_class_enum_of_int)
        buf
    in
    let feedback_id = Decode.u8 buf in
    let len = Decode.u16 buf in
    let pitch = Decode.u16 buf in
    let duration = Decode.u16 buf in
    let led_mask = Decode.u32 buf in
    let led_values = Decode.u32 buf in
    let global_auto_repeat = Decode.bool buf in
    let click = Decode.u8 buf in
    let percent = Decode.u8 buf in
    Decode.pad buf 1;
    let auto_repeats = (Decode.list ~item:Decode.u8) ~len:32 buf in
    {
      class_id;
      feedback_id;
      len;
      pitch;
      duration;
      led_mask;
      led_values;
      global_auto_repeat;
      click;
      percent;
      auto_repeats;
    }

  type ptr_feedback_state = {
    class_id : feedback_class_enum;
