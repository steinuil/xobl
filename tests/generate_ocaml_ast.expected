module Xprint = struct
  type string8 = char [@@deriving sexp]

  let decode_string8 = Decode.char

  type printer = { name : string; description : string } [@@deriving sexp]

  let decode_printer buf : printer =
    let name_len = Decode.u32 buf in
    let name = Decode.string ~len:name_len buf in
    Decode.align buf 4;
    let desc_len = Decode.u32 buf in
    let description = Decode.string ~len:desc_len buf in
    Decode.align buf 4;
    { name; description }

  type pcontext = xid [@@deriving sexp]

  let decode_pcontext = Decode.xid

  type get_doc_enum = [ `Finished | `Second_consumer ] [@@deriving sexp]

  let get_doc_enum_of_int n : [ get_doc_enum | int custom ] =
    match n with 0 -> `Finished | 1 -> `Second_consumer | _ -> `Custom n

  type ev_mask = [ `Print_mask | `Attribute_mask ] list [@@deriving sexp]

  type detail_enum =
    [ `Start_job_notify
    | `End_job_notify
    | `Start_doc_notify
    | `End_doc_notify
    | `Start_page_notify
    | `End_page_notify ]
  [@@deriving sexp]

  let detail_enum_of_int n : [ detail_enum | int custom ] =
    match n with
    | 1 -> `Start_job_notify
    | 2 -> `End_job_notify
    | 3 -> `Start_doc_notify
    | 4 -> `End_doc_notify
    | 5 -> `Start_page_notify
    | 6 -> `End_page_notify
    | _ -> `Custom n

  type attr_enum =
    [ `Job_attr
    | `Doc_attr
    | `Page_attr
    | `Printer_attr
    | `Server_attr
    | `Medium_attr
    | `Spooler_attr ]
  [@@deriving sexp]

  let attr_enum_of_int n : [ attr_enum | int custom ] =
    match n with
    | 1 -> `Job_attr
    | 2 -> `Doc_attr
    | 3 -> `Page_attr
    | 4 -> `Printer_attr
    | 5 -> `Server_attr
    | 6 -> `Medium_attr
    | 7 -> `Spooler_attr
    | _ -> `Custom n

  type print_query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

  let decode_print_query_version_reply buf : print_query_version_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let major_version = Decode.u16 buf in
    let minor_version = Decode.u16 buf in
    ignore length;
    { major_version; minor_version }

  type print_get_printer_list_reply = printer list [@@deriving sexp]

  let decode_print_get_printer_list_reply buf : print_get_printer_list_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let list_count = Decode.u32 buf in
    Decode.pad buf 20;
    let printers = (Decode.list ~item:decode_printer) ~len:list_count buf in
    ignore length;
    printers

  type print_get_context_reply = u32 [@@deriving sexp]

  let decode_print_get_context_reply buf : print_get_context_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let context = Decode.u32 buf in
    ignore length;
    context

  type print_get_screen_of_context_reply = Xproto.window [@@deriving sexp]

  let decode_print_get_screen_of_context_reply buf :
      print_get_screen_of_context_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let root = Xproto.decode_window buf in
    ignore length;
    root

  type print_get_document_data_reply = {
    status_code : u32;
    finished_flag : u32;
    data : byte list;
  }
  [@@deriving sexp]

  let decode_print_get_document_data_reply buf : print_get_document_data_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let status_code = Decode.u32 buf in
    let finished_flag = Decode.u32 buf in
    let data_len = Decode.u32 buf in
    Decode.pad buf 12;
    let data = (Decode.list ~item:Decode.byte) ~len:data_len buf in
    ignore length;
    { status_code; finished_flag; data }

  type print_input_selected_reply = { event_mask : u32; all_events_mask : u32 }
  [@@deriving sexp]

  let decode_print_input_selected_reply buf : print_input_selected_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let event_mask = Decode.u32 buf in
    let all_events_mask = Decode.u32 buf in
    ignore length;
    { event_mask; all_events_mask }

  type print_get_attributes_reply = string [@@deriving sexp]

  let decode_print_get_attributes_reply buf : print_get_attributes_reply =
    Decode.pad buf 4;
    let length = Decode.u32 buf in
    let string_len = Decode.u32 buf in
    Decode.pad buf 20;
    let attributes = Decode.string ~len:string_len buf in
    ignore length;
    attributes

