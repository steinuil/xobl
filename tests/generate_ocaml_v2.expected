        extents_y : i16;
        extents_width : u16;
        extents_height : u16;
        server_time : Xproto.timestamp;
        shaped : bool;
      }
      [@@deriving sexp]

      let name = "Notify"
      let number = 0
    end

    type t = [ `Notify of Notify.t ] [@@deriving sexp]
  end

  module Error = struct
    type t = [] [@@deriving sexp]
  end

  module Query_version = struct
    let name = "QueryVersion"
    let opcode = 0

