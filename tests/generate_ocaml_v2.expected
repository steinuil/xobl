    let make ~pixmap ~drawable ~size ~width ~height ~stride ~depth ~bpp
        ~pixmap_fd : request =
      { pixmap; drawable; size; width; height; stride; depth; bpp; pixmap_fd }
  end

  module Buffer_from_pixmap = struct
    let name = "BufferFromPixmap"
    let opcode = 3

    type request = Xproto.pixmap [@@deriving sexp]

