module Xv = struct
  module Meta = struct
    type t = [ `Xv ]

    let version = (2, 2)
    let query_name = "XVideo"
  end

  type port = xid [@@deriving sexp]
  type encoding = xid [@@deriving sexp]

  module Type_mask = struct
    include Mask

    let (input_mask : t) = of_int64 (Int64.shift_right 1L 0)
    let (output_mask : t) = of_int64 (Int64.shift_right 1L 1)
    let (video_mask : t) = of_int64 (Int64.shift_right 1L 2)
    let (still_mask : t) = of_int64 (Int64.shift_right 1L 3)
    let (image_mask : t) = of_int64 (Int64.shift_right 1L 4)
  end

  module Image_format_info_type_enum = struct
    type t = [ `Rgb | `Yuv ] [@@deriving sexp]
  end

  module Image_format_info_format_enum = struct
    type t = [ `Packed | `Planar ] [@@deriving sexp]
  end

  module Attribute_flag_mask = struct
    include Mask

    let (gettable : t) = of_int64 (Int64.shift_right 1L 0)
    let (settable : t) = of_int64 (Int64.shift_right 1L 1)
  end

  module Video_notify_reason_enum = struct
    type t = [ `Started | `Stopped | `Busy | `Preempted | `Hard_error ]
    [@@deriving sexp]
  end

  module Scanline_order_enum = struct
    type t = [ `Top_to_bottom | `Bottom_to_top ] [@@deriving sexp]
  end

  module Grab_port_status_enum = struct
    type t =
      [ `Success
      | `Bad_extension
      | `Already_grabbed
      | `Invalid_time
      | `Bad_reply
      | `Bad_alloc ]
    [@@deriving sexp]
  end

  type rational = { numerator : i32; denominator : i32 } [@@deriving sexp]
  type format = { visual : Xproto.visualid; depth : u8 } [@@deriving sexp]

  type adaptor_info = {
    base_id : port;
    num_ports : u16;
    type_ : Type_mask.t;
    name : string;
    formats : format list;
  }
  [@@deriving sexp]

  type encoding_info = {
    encoding : encoding;
    width : u16;
    height : u16;
    rate : rational;
    name : string;
  }
  [@@deriving sexp]

  type image = {
    id : u32;
    width : u16;
    height : u16;
    pitches : u32 list;
    offsets : u32 list;
    data : u8 list;
  }
  [@@deriving sexp]

  type attribute_info = {
    flags : Attribute_flag_mask.t;
    min : i32;
    max : i32;
    name : string;
  }
  [@@deriving sexp]

  type image_format_info = {
    id : u32;
    type_ : Image_format_info_type_enum.t;
    byte_order : Xv.Image_order_enum.t;
    guid : u8 list;
    bpp : u8;
    num_planes : u8;
    depth : u8;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
    format : Image_format_info_format_enum.t;
    y_sample_bits : u32;
    u_sample_bits : u32;
    v_sample_bits : u32;
    vhorz_y_period : u32;
    vhorz_u_period : u32;
    vhorz_v_period : u32;
    vvert_y_period : u32;
    vvert_u_period : u32;
    vvert_v_period : u32;
    vcomp_order : u8 list;
    vscanline_order : Scanline_order_enum.t;
  }
  [@@deriving sexp]
end

module Xvmc = struct
  module Meta = struct
    type t = [ `XvMC ]

    let version = (1, 1)
    let query_name = "XVideo-MotionCompensation"
  end

  type context = xid [@@deriving sexp]
