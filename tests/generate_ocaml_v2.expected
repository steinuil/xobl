  module Create_window = struct
    let name = "CreateWindow"
    let opcode = 1

    type request = {
      depth : u8;
      wid : window;
      parent : window;
      x : i16;
      y : i16;
      width : u16;
      height : u16;
      border_width : u16;
      class_ : Window_class_enum.t;
      visual : visualid;
      background_pixmap : [ Back_pixmap_enum.t | pixmap alt ] option;
      background_pixel : u32 option;
      border_pixmap : [ Pixmap_enum.t | pixmap alt ] option;
      border_pixel : u32 option;
      bit_gravity : Gravity_enum.t option;
      win_gravity : Gravity_enum.t option;
      backing_store : Backing_store_enum.t option;
      backing_planes : u32 option;
      backing_pixel : u32 option;
      override_redirect : bool32 option;
      save_under : bool32 option;
      event_mask : Event_mask.t option;
      do_not_propogate_mask : Event_mask.t option;
      colormap : [ Colormap_enum.t | colormap alt ] option;
      cursor : [ Cursor_enum.t | cursor alt ] option;
    }
    [@@deriving sexp]

    let make ~depth ~wid ~parent ~x ~y ~width ~height ~border_width ~class_
        ~visual ?background_pixmap ?background_pixel ?border_pixmap
        ?border_pixel ?bit_gravity ?win_gravity ?backing_store ?backing_planes
        ?backing_pixel ?override_redirect ?save_under ?event_mask
        ?do_not_propogate_mask ?colormap ?cursor () : request =
      {
        depth;
        wid;
        parent;
        x;
        y;
        width;
        height;
        border_width;
        class_;
        visual;
        background_pixmap;
        background_pixel;
        border_pixmap;
        border_pixel;
        bit_gravity;
        win_gravity;
        backing_store;
        backing_planes;
        backing_pixel;
        override_redirect;
        save_under;
        event_mask;
        do_not_propogate_mask;
        colormap;
        cursor;
      }
  end

