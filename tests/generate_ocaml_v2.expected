  module Query_best_size = struct
    let name = "QueryBestSize"
    let opcode = 12

    type request = {
      port : port;
      vid_w : u16;
      vid_h : u16;
      drw_w : u16;
      drw_h : u16;
      motion : bool;
    }
    [@@deriving sexp]

    let make ~port ~vid_w ~vid_h ~drw_w ~drw_h ~motion : request =
      { port; vid_w; vid_h; drw_w; drw_h; motion }

    type reply = { actual_width : u16; actual_height : u16 } [@@deriving sexp]
  end

  module Set_port_attribute = struct
    let name = "SetPortAttribute"
    let opcode = 13

    type request = { port : port; attribute : Xproto.atom; value : i32 }
    [@@deriving sexp]

