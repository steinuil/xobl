    u_sample_bits : u32;
    v_sample_bits : u32;
    vhorz_y_period : u32;
    vhorz_u_period : u32;
    vhorz_v_period : u32;
    vvert_y_period : u32;
    vvert_u_period : u32;
    vvert_v_period : u32;
    vcomp_order : u8 list;
    vscanline_order : Scanline_order_enum.t;
  }
  [@@deriving sexp]

  type query_extension_reply = { major : u16; minor : u16 } [@@deriving sexp]
  type query_adaptors_reply = adaptor_info list [@@deriving sexp]
  type query_encodings_reply = encoding_info list [@@deriving sexp]
  type grab_port_reply = Grab_port_status_enum.t [@@deriving sexp]

  type query_best_size_reply = { actual_width : u16; actual_height : u16 }
  [@@deriving sexp]

  type get_port_attribute_reply = i32 [@@deriving sexp]

  type query_port_attributes_reply = {
    text_size : u32;
    attributes : attribute_info list;
  }
  [@@deriving sexp]

  type list_image_formats_reply = image_format_info list [@@deriving sexp]

  type query_image_attributes_reply = {
    data_size : u32;
    width : u16;
    height : u16;
    pitches : u32 list;
    offsets : u32 list;
  }
  [@@deriving sexp]

  module Event = struct
    module Video_notify = struct
      type t = {
        reason : Video_notify_reason_enum.t;
        time : Xproto.timestamp;
        drawable : Xproto.drawable;
        port : port;
      }
      [@@deriving sexp]

      let name = "VideoNotify"
      let number = 0
    end

    module Port_notify = struct
      type t = {
        time : Xproto.timestamp;
        port : port;
        attribute : Xproto.atom;
        value : i32;
      }
      [@@deriving sexp]

      let name = "PortNotify"
      let number = 1
    end

    type t = [ `Video_notify of Video_notify.t | `Port_notify of Port_notify.t ]
    [@@deriving sexp]
  end

  module Error = struct
    module Bad_port = struct
      type t = unit [@@deriving sexp]

      let name = "BadPort"
      let number = 0
    end

    module Bad_encoding = struct
      type t = unit [@@deriving sexp]

      let name = "BadEncoding"
      let number = 1
    end

    module Bad_control = struct
      type t = unit [@@deriving sexp]

      let name = "BadControl"
      let number = 2
    end

    type t =
      [ `Bad_port of Bad_port.t
      | `Bad_encoding of Bad_encoding.t
      | `Bad_control of Bad_control.t ]
    [@@deriving sexp]
  end
end

module Xvmc = struct
  module Meta = struct
    type t = [ `XvMC ]

    let version = (1, 1)
    let query_name = "XVideo-MotionCompensation"
  end

  type context = xid [@@deriving sexp]
  type surface = xid [@@deriving sexp]
  type subpicture = xid [@@deriving sexp]

  type surface_info = {
    id : surface;
    chroma_format : u16;
    pad0 : u16;
    max_width : u16;
    max_height : u16;
    subpicture_max_width : u16;
    subpicture_max_height : u16;
    mc_type : u32;
    flags : u32;
  }
  [@@deriving sexp]

  type query_version_reply = { major : u32; minor : u32 } [@@deriving sexp]
  type list_surface_types_reply = surface_info list [@@deriving sexp]

  type create_context_reply = {
    width_actual : u16;
    height_actual : u16;
    flags_return : u32;
    priv_data : u32 list;
  }
  [@@deriving sexp]

  type create_surface_reply = u32 list [@@deriving sexp]

  type create_subpicture_reply = {
    width_actual : u16;
    height_actual : u16;
    num_palette_entries : u16;
    entry_bytes : u16;
    component_order : u8 list;
    priv_data : u32 list;
  }
  [@@deriving sexp]

  type list_subpicture_types_reply = Xv.image_format_info list [@@deriving sexp]

  module Event = struct
    type t = [] [@@deriving sexp]
  end

  module Error = struct
    type t = [] [@@deriving sexp]
  end
end
