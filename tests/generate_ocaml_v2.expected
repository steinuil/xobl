    let name = "ListImageFormats"
    let opcode = 16

    type request = port [@@deriving sexp]

    let make port : request = port

    type reply = image_format_info list [@@deriving sexp]
  end

  module Query_image_attributes = struct
    let name = "QueryImageAttributes"
    let opcode = 17

    type request = { port : port; id : u32; width : u16; height : u16 }
    [@@deriving sexp]

    let make ~port ~id ~width ~height : request = { port; id; width; height }

    type reply = {
      data_size : u32;
      width : u16;
      height : u16;
      pitches : u32 list;
      offsets : u32 list;
    }
    [@@deriving sexp]
  end

  module Put_image = struct
    let name = "PutImage"
    let opcode = 18

    type request = {
      port : port;
      drawable : Xproto.drawable;
