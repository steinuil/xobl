  module Stop_video = struct
    let name = "StopVideo"
    let opcode = 9

    type request = { port : port; drawable : Xproto.drawable } [@@deriving sexp]

    let make ~port ~drawable : request = { port; drawable }
  end

  module Select_video_notify = struct
    let name = "SelectVideoNotify"
    let opcode = 10

    type request = { drawable : Xproto.drawable; onoff : bool }
    [@@deriving sexp]

    let make ~drawable ~onoff : request = { drawable; onoff }
  end

  module Select_port_notify = struct
    let name = "SelectPortNotify"
    let opcode = 11

