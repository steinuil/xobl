  }
  [@@deriving sexp]

  module Connection_enum = struct
    type t = [ `Connected | `Disconnected | `Unknown ] [@@deriving sexp]
  end

  module Transform_mask = struct
    include Mask

    let (unit : t) = of_int64 (Int64.shift_right 1L 0)
    let (scale_up : t) = of_int64 (Int64.shift_right 1L 1)
    let (scale_down : t) = of_int64 (Int64.shift_right 1L 2)
    let (projective : t) = of_int64 (Int64.shift_right 1L 3)
  end

  module Provider_capability_mask = struct
    include Mask

    let (source_output : t) = of_int64 (Int64.shift_right 1L 0)
    let (sink_output : t) = of_int64 (Int64.shift_right 1L 1)
    let (source_offload : t) = of_int64 (Int64.shift_right 1L 2)
    let (sink_offload : t) = of_int64 (Int64.shift_right 1L 3)
  end

  module Notify_enum = struct
    type t =
      [ `Crtc_change
      | `Output_change
      | `Output_property
      | `Provider_change
      | `Provider_property
      | `Resource_change
      | `Lease ]
    [@@deriving sexp]
  end

  type crtc_change = {
    timestamp : Xproto.timestamp;
    window : Xproto.window;
    crtc : crtc;
    mode : mode;
    rotation : Rotation_mask.t;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
  }
  [@@deriving sexp]

  type output_change = {
    timestamp : Xproto.timestamp;
    config_timestamp : Xproto.timestamp;
    window : Xproto.window;
    output : output;
    crtc : crtc;
    mode : mode;
    rotation : Rotation_mask.t;
