  module Gx_enum = struct
    type t =
      [ `Clear
      | `And_
      | `And_reverse
      | `Copy
      | `And_inverted
      | `Noop
      | `Xor
      | `Or_
      | `Nor
      | `Equiv
      | `Invert
      | `Or_reverse
      | `Copy_inverted
      | `Or_inverted
      | `Nand
      | `Set ]
