module Bigreq = struct
  module Meta = struct
    type t = [ `BigRequests ]

    let version = (0, 0)
    let query_name = "BIG-REQUESTS"
  end
end

module Xproto = struct
  type char2b = { byte1 : u8; byte2 : u8 } [@@deriving sexp]
  type window = xid [@@deriving sexp]
  type pixmap = xid [@@deriving sexp]
  type cursor = xid [@@deriving sexp]
  type font = xid [@@deriving sexp]
  type gcontext = xid [@@deriving sexp]
  type colormap = xid [@@deriving sexp]
  type atom = xid [@@deriving sexp]
  type drawable = xid [@@deriving sexp]
  type fontable = xid [@@deriving sexp]
  type bool32 = u32 [@@deriving sexp]
  type visualid = u32 [@@deriving sexp]
  type timestamp = u32 [@@deriving sexp]
  type keysym = u32 [@@deriving sexp]
  type keycode = u8 [@@deriving sexp]
  type keycode32 = u32 [@@deriving sexp]
  type button = u8 [@@deriving sexp]
  type point = { x : i16; y : i16 } [@@deriving sexp]

  type rectangle = { x : i16; y : i16; width : u16; height : u16 }
  [@@deriving sexp]

  type arc = {
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    angle1 : i16;
    angle2 : i16;
  }
  [@@deriving sexp]

  type format = { depth : u8; bits_per_pixel : u8; scanline_pad : u8 }
  [@@deriving sexp]

  module Visual_class_enum = struct
    type t =
      [ `Static_gray
      | `Gray_scale
      | `Static_color
      | `Pseudo_color
      | `True_color
      | `Direct_color ]
    [@@deriving sexp]
  end

  type visualtype = {
    visual_id : visualid;
    class_ : Visual_class_enum.t;
    bits_per_rgb_value : u8;
    colormap_entries : u16;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
  }
  [@@deriving sexp]

  type depth = { depth : u8; visuals : visualtype list } [@@deriving sexp]

  module Backing_store_enum = struct
    type t = [ `Not_useful | `When_mapped | `Always ] [@@deriving sexp]
  end

  type screen = {
    root : window;
    default_colormap : colormap;
    white_pixel : u32;
    black_pixel : u32;
    current_input_masks : Event_mask.t;
    width_in_pixels : u16;
    height_in_pixels : u16;
    width_in_millimeters : u16;
    height_in_millimeters : u16;
    min_installed_maps : u16;
    max_installed_maps : u16;
    root_visual : visualid;
    backing_stores : Backing_store_enum.t;
    save_unders : bool;
    root_depth : u8;
    allowed_depths : depth list;
  }
  [@@deriving sexp]

  type setup_request = {
    byte_order : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    authorization_protocol_name : string;
    authorization_protocol_data : string;
  }
  [@@deriving sexp]

  type setup_failed = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    reason : string;
  }
  [@@deriving sexp]

  type setup_authenticate = { status : u8; reason : string } [@@deriving sexp]

  module Image_order_enum = struct
    type t = [ `Lsb_first | `Msb_first ] [@@deriving sexp]
  end

  type setup = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    release_number : u32;
    resource_id_base : u32;
    resource_id_mask : u32;
    motion_buffer_size : u32;
    maximum_request_length : u16;
    image_byte_order : Image_order_enum.t;
    bitmap_format_bit_order : Image_order_enum.t;
    bitmap_format_scanline_unit : u8;
    bitmap_format_scanline_pad : u8;
    min_keycode : keycode;
    max_keycode : keycode;
    vendor : string;
    pixmap_formats : format list;
    roots : screen list;
  }
  [@@deriving sexp]

  module Mod_mask = struct
    include Mask

    let (shift : t) = of_int64 (Int64.shift_right 1L 0)
    let (lock : t) = of_int64 (Int64.shift_right 1L 1)
    let (control : t) = of_int64 (Int64.shift_right 1L 2)
    let (_1 : t) = of_int64 (Int64.shift_right 1L 3)
    let (_2 : t) = of_int64 (Int64.shift_right 1L 4)
    let (_3 : t) = of_int64 (Int64.shift_right 1L 5)
    let (_4 : t) = of_int64 (Int64.shift_right 1L 6)
    let (_5 : t) = of_int64 (Int64.shift_right 1L 7)
    let (any : t) = of_int64 (Int64.shift_right 1L 15)
  end

  module Key_but_mask = struct
    include Mask

    let (shift : t) = of_int64 (Int64.shift_right 1L 0)
    let (lock : t) = of_int64 (Int64.shift_right 1L 1)
    let (control : t) = of_int64 (Int64.shift_right 1L 2)
    let (mod1 : t) = of_int64 (Int64.shift_right 1L 3)
    let (mod2 : t) = of_int64 (Int64.shift_right 1L 4)
    let (mod3 : t) = of_int64 (Int64.shift_right 1L 5)
    let (mod4 : t) = of_int64 (Int64.shift_right 1L 6)
    let (mod5 : t) = of_int64 (Int64.shift_right 1L 7)
    let (button1 : t) = of_int64 (Int64.shift_right 1L 8)
    let (button2 : t) = of_int64 (Int64.shift_right 1L 9)
    let (button3 : t) = of_int64 (Int64.shift_right 1L 10)
    let (button4 : t) = of_int64 (Int64.shift_right 1L 11)
    let (button5 : t) = of_int64 (Int64.shift_right 1L 12)
  end

  module Window_enum = struct
    type t = [ `None ] [@@deriving sexp]
  end

  module Button_mask = struct
    include Mask

    let (_1 : t) = of_int64 (Int64.shift_right 1L 8)
    let (_2 : t) = of_int64 (Int64.shift_right 1L 9)
    let (_3 : t) = of_int64 (Int64.shift_right 1L 10)
    let (_4 : t) = of_int64 (Int64.shift_right 1L 11)
    let (_5 : t) = of_int64 (Int64.shift_right 1L 12)
    let (any : t) = of_int64 (Int64.shift_right 1L 15)
  end

  module Motion_enum = struct
    type t = [ `Normal | `Hint ] [@@deriving sexp]
  end

  module Notify_detail_enum = struct
