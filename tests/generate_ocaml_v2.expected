module Render = struct
  module Meta = struct
    type t = [ `Render ]

    let version = (0, 11)
    let query_name = "RENDER"
  end

  [@@@ocaml.warning "-12"]

  open Types [@@ocaml.warning "-33"]
  open Sexplib.Conv [@@ocaml.warning "-33"]

  module Pict_type_enum = struct
    type t = [ `Indexed | `Direct ] [@@deriving sexp]
  end

  module Picture_enum = struct
    type t = [ `None ] [@@deriving sexp]
  end

  module Pict_op_enum = struct
    type t =
      [ `Clear
      | `Src
      | `Dst
      | `Over
      | `Over_reverse
      | `In_
      | `In_reverse
      | `Out
      | `Out_reverse
      | `Atop
      | `Atop_reverse
      | `Xor
      | `Add
      | `Saturate
      | `Disjoint_clear
      | `Disjoint_src
      | `Disjoint_dst
      | `Disjoint_over
      | `Disjoint_over_reverse
      | `Disjoint_in
      | `Disjoint_in_reverse
      | `Disjoint_out
      | `Disjoint_out_reverse
      | `Disjoint_atop
      | `Disjoint_atop_reverse
      | `Disjoint_xor
      | `Conjoint_clear
      | `Conjoint_src
      | `Conjoint_dst
      | `Conjoint_over
      | `Conjoint_over_reverse
      | `Conjoint_in
      | `Conjoint_in_reverse
      | `Conjoint_out
      | `Conjoint_out_reverse
      | `Conjoint_atop
      | `Conjoint_atop_reverse
      | `Conjoint_xor
      | `Multiply
      | `Screen
      | `Overlay
      | `Darken
      | `Lighten
      | `Color_dodge
      | `Color_burn
      | `Hard_light
      | `Soft_light
      | `Difference
      | `Exclusion
      | `Hsl_hue
      | `Hsl_saturation
      | `Hsl_color
      | `Hsl_luminosity ]
    [@@deriving sexp]
  end

  module Poly_edge_enum = struct
    type t = [ `Sharp | `Smooth ] [@@deriving sexp]
  end

  module Poly_mode_enum = struct
    type t = [ `Precise | `Imprecise ] [@@deriving sexp]
  end

  module Cp_mask = struct
    include Mask

    let (repeat : t) = of_int64 (Int64.shift_right 1L 0)
    let (alpha_map : t) = of_int64 (Int64.shift_right 1L 1)
    let (alpha_x_origin : t) = of_int64 (Int64.shift_right 1L 2)
    let (alpha_y_origin : t) = of_int64 (Int64.shift_right 1L 3)
    let (clip_x_origin : t) = of_int64 (Int64.shift_right 1L 4)
    let (clip_y_origin : t) = of_int64 (Int64.shift_right 1L 5)
    let (clip_mask : t) = of_int64 (Int64.shift_right 1L 6)
    let (graphics_exposure : t) = of_int64 (Int64.shift_right 1L 7)
    let (subwindow_mode : t) = of_int64 (Int64.shift_right 1L 8)
    let (poly_edge : t) = of_int64 (Int64.shift_right 1L 9)
    let (poly_mode : t) = of_int64 (Int64.shift_right 1L 10)
    let (dither : t) = of_int64 (Int64.shift_right 1L 11)
    let (component_alpha : t) = of_int64 (Int64.shift_right 1L 12)
  end

  module Sub_pixel_enum = struct
    type t =
      [ `Unknown
      | `Horizontal_rgb
      | `Horizontal_bgr
      | `Vertical_rgb
      | `Vertical_bgr
      | `None ]
    [@@deriving sexp]
  end

  module Repeat_enum = struct
    type t = [ `None | `Normal | `Pad | `Reflect ] [@@deriving sexp]
  end

  type glyph = u32 [@@deriving sexp]
  type glyphset = xid [@@deriving sexp]
  type picture = xid [@@deriving sexp]
  type pictformat = xid [@@deriving sexp]
  type fixed = i32 [@@deriving sexp]

  type directformat = {
    red_shift : u16;
    red_mask : u16;
    green_shift : u16;
    green_mask : u16;
    blue_shift : u16;
    blue_mask : u16;
    alpha_shift : u16;
    alpha_mask : u16;
  }
  [@@deriving sexp]

  type pictforminfo = {
    id : pictformat;
    type_ : Pict_type_enum.t;
    depth : u8;
    direct : directformat;
    colormap : Xproto.colormap;
  }
  [@@deriving sexp]

  type pictvisual = { visual : Xproto.visualid; format : pictformat }
  [@@deriving sexp]

  type pictdepth = { depth : u8; visuals : pictvisual list } [@@deriving sexp]

  type pictscreen = { fallback : pictformat; depths : pictdepth list }
  [@@deriving sexp]

  type indexvalue = {
    pixel : u32;
    red : u16;
    green : u16;
    blue : u16;
    alpha : u16;
  }
  [@@deriving sexp]

  type color = { red : u16; green : u16; blue : u16; alpha : u16 }
  [@@deriving sexp]

  type pointfix = { x : fixed; y : fixed } [@@deriving sexp]
  type linefix = { p1 : pointfix; p2 : pointfix } [@@deriving sexp]

  type triangle = { p1 : pointfix; p2 : pointfix; p3 : pointfix }
  [@@deriving sexp]

  type trapezoid = {
    top : fixed;
    bottom : fixed;
    left : linefix;
    right : linefix;
  }
  [@@deriving sexp]

  type glyphinfo = {
    width : u16;
    height : u16;
    x : i16;
    y : i16;
    x_off : i16;
    y_off : i16;
  }
  [@@deriving sexp]

  type transform = {
    matrix11 : fixed;
    matrix12 : fixed;
    matrix13 : fixed;
    matrix21 : fixed;
    matrix22 : fixed;
    matrix23 : fixed;
    matrix31 : fixed;
    matrix32 : fixed;
    matrix33 : fixed;
  }
  [@@deriving sexp]

  type animcursorelt = { cursor : Xproto.cursor; delay : u32 } [@@deriving sexp]
  type spanfix = { l : fixed; r : fixed; y : fixed } [@@deriving sexp]
  type trap = { top : spanfix; bot : spanfix } [@@deriving sexp]

  module Event = struct
    type t = [] [@@deriving sexp]
  end

  module Error = struct
    module Pict_format = struct
      type t = unit [@@deriving sexp]

      let name = "PictFormat"
