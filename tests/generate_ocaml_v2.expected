    [@@deriving sexp]
  end

  type rational = { numerator : i32; denominator : i32 } [@@deriving sexp]
  type format = { visual : Xproto.visualid; depth : u8 } [@@deriving sexp]

  type adaptor_info = {
    base_id : port;
    num_ports : u16;
    type_ : Type_mask.t;
    name : string;
    formats : format list;
  }
  [@@deriving sexp]

  type encoding_info = {
    encoding : encoding;
    width : u16;
    height : u16;
    rate : rational;
    name : string;
  }
  [@@deriving sexp]

  type image = {
    id : u32;
    width : u16;
    height : u16;
    pitches : u32 list;
    offsets : u32 list;
    data : u8 list;
  }
  [@@deriving sexp]

  type attribute_info = {
    flags : Attribute_flag_mask.t;
    min : i32;
    max : i32;
    name : string;
  }
  [@@deriving sexp]

  type image_format_info = {
    id : u32;
    type_ : Image_format_info_type_enum.t;
    byte_order : Xproto.Image_order_enum.t;
    guid : u8 list;
    bpp : u8;
    num_planes : u8;
    depth : u8;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
    format : Image_format_info_format_enum.t;
    y_sample_bits : u32;
    u_sample_bits : u32;
    v_sample_bits : u32;
    vhorz_y_period : u32;
    vhorz_u_period : u32;
    vhorz_v_period : u32;
    vvert_y_period : u32;
    vvert_u_period : u32;
    vvert_v_period : u32;
    vcomp_order : u8 list;
    vscanline_order : Scanline_order_enum.t;
  }
  [@@deriving sexp]

  module Event = struct
    module Video_notify = struct
      type t = {
        reason : Video_notify_reason_enum.t;
        time : Xproto.timestamp;
        drawable : Xproto.drawable;
        port : port;
      }
      [@@deriving sexp]

      let name = "VideoNotify"
      let number = 0
    end

    module Port_notify = struct
      type t = {
        time : Xproto.timestamp;
        port : port;
        attribute : Xproto.atom;
        value : i32;
      }
      [@@deriving sexp]

      let name = "PortNotify"
      let number = 1
    end

    type t = [ `Video_notify of Video_notify.t | `Port_notify of Port_notify.t ]
    [@@deriving sexp]
  end

  module Error = struct
    module Bad_port = struct
      type t = unit [@@deriving sexp]

      let name = "BadPort"
      let number = 0
    end

    module Bad_encoding = struct
      type t = unit [@@deriving sexp]

      let name = "BadEncoding"
      let number = 1
    end

    module Bad_control = struct
      type t = unit [@@deriving sexp]

      let name = "BadControl"
      let number = 2
    end

    type t =
      [ `Bad_port of Bad_port.t
      | `Bad_encoding of Bad_encoding.t
      | `Bad_control of Bad_control.t ]
    [@@deriving sexp]
  end

  module Query_extension = struct
    let name = "QueryExtension"
    let opcode = 0

    type request = unit [@@deriving sexp]

    let make () : request = ()

    type reply = { major : u16; minor : u16 } [@@deriving sexp]
  end

  module Query_adaptors = struct
    let name = "QueryAdaptors"
