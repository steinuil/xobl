module Randr = struct
  module Meta = struct
    type t = [ `RandR ]

    let version = (1, 6)
    let query_name = "RANDR"
  end

  [@@@ocaml.warning "-12"]

  open Types [@@ocaml.warning "-33"]
  open Sexplib.Conv [@@ocaml.warning "-33"]

  type mode = xid [@@deriving sexp]
  type crtc = xid [@@deriving sexp]
  type output = xid [@@deriving sexp]
  type provider = xid [@@deriving sexp]
  type lease = xid [@@deriving sexp]

  module Rotation_mask = struct
    include Mask

    let (rotate_0 : t) = of_int64 (Int64.shift_right 1L 0)
    let (rotate_90 : t) = of_int64 (Int64.shift_right 1L 1)
    let (rotate_180 : t) = of_int64 (Int64.shift_right 1L 2)
    let (rotate_270 : t) = of_int64 (Int64.shift_right 1L 3)
    let (reflect_x : t) = of_int64 (Int64.shift_right 1L 4)
    let (reflect_y : t) = of_int64 (Int64.shift_right 1L 5)
  end

  type screen_size = { width : u16; height : u16; mwidth : u16; mheight : u16 }
  [@@deriving sexp]

  type refresh_rates = u16 list [@@deriving sexp]

  module Set_config_enum = struct
    type t = [ `Success | `Invalid_config_time | `Invalid_time | `Failed ]
    [@@deriving sexp]
  end

  module Notify_mask = struct
    include Mask

    let (screen_change : t) = of_int64 (Int64.shift_right 1L 0)
    let (crtc_change : t) = of_int64 (Int64.shift_right 1L 1)
    let (output_change : t) = of_int64 (Int64.shift_right 1L 2)
    let (output_property : t) = of_int64 (Int64.shift_right 1L 3)
    let (provider_change : t) = of_int64 (Int64.shift_right 1L 4)
    let (provider_property : t) = of_int64 (Int64.shift_right 1L 5)
    let (resource_change : t) = of_int64 (Int64.shift_right 1L 6)
    let (lease : t) = of_int64 (Int64.shift_right 1L 7)
  end

  module Mode_flag_mask = struct
    include Mask

    let (hsync_positive : t) = of_int64 (Int64.shift_right 1L 0)
    let (hsync_negative : t) = of_int64 (Int64.shift_right 1L 1)
    let (vsync_positive : t) = of_int64 (Int64.shift_right 1L 2)
    let (vsync_negative : t) = of_int64 (Int64.shift_right 1L 3)
    let (interlace : t) = of_int64 (Int64.shift_right 1L 4)
    let (double_scan : t) = of_int64 (Int64.shift_right 1L 5)
    let (csync : t) = of_int64 (Int64.shift_right 1L 6)
    let (csync_positive : t) = of_int64 (Int64.shift_right 1L 7)
    let (csync_negative : t) = of_int64 (Int64.shift_right 1L 8)
    let (hskew_present : t) = of_int64 (Int64.shift_right 1L 9)
    let (bcast : t) = of_int64 (Int64.shift_right 1L 10)
    let (pixel_multiplex : t) = of_int64 (Int64.shift_right 1L 11)
    let (double_clock : t) = of_int64 (Int64.shift_right 1L 12)
    let (halve_clock : t) = of_int64 (Int64.shift_right 1L 13)
  end

