module Bigreq = struct
  module Meta = struct
    type t = [ `BigRequests ]

    let version = (0, 0)
    let query_name = "BIG-REQUESTS"
  end

  type enable_reply = u32 [@@deriving sexp]

  module Event = struct
    type t = [] [@@deriving sexp]
  end

  module Error = struct
    type t = [] [@@deriving sexp]
  end
end

module Xproto = struct
  type char2b = { byte1 : u8; byte2 : u8 } [@@deriving sexp]
  type window = xid [@@deriving sexp]
  type pixmap = xid [@@deriving sexp]
  type cursor = xid [@@deriving sexp]
  type font = xid [@@deriving sexp]
  type gcontext = xid [@@deriving sexp]
  type colormap = xid [@@deriving sexp]
  type atom = xid [@@deriving sexp]
  type drawable = xid [@@deriving sexp]
  type fontable = xid [@@deriving sexp]
  type bool32 = u32 [@@deriving sexp]
  type visualid = u32 [@@deriving sexp]
  type timestamp = u32 [@@deriving sexp]
  type keysym = u32 [@@deriving sexp]
  type keycode = u8 [@@deriving sexp]
  type keycode32 = u32 [@@deriving sexp]
  type button = u8 [@@deriving sexp]
  type point = { x : i16; y : i16 } [@@deriving sexp]

  type rectangle = { x : i16; y : i16; width : u16; height : u16 }
  [@@deriving sexp]

  type arc = {
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    angle1 : i16;
    angle2 : i16;
  }
  [@@deriving sexp]

  type format = { depth : u8; bits_per_pixel : u8; scanline_pad : u8 }
  [@@deriving sexp]

  module Visual_class_enum = struct
    type t =
      [ `Static_gray
      | `Gray_scale
      | `Static_color
      | `Pseudo_color
      | `True_color
      | `Direct_color ]
    [@@deriving sexp]
  end

  type visualtype = {
    visual_id : visualid;
    class_ : Visual_class_enum.t;
    bits_per_rgb_value : u8;
    colormap_entries : u16;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
  }
  [@@deriving sexp]

  type depth = { depth : u8; visuals : visualtype list } [@@deriving sexp]

  module Event_mask = struct
    include Mask

    let (key_press : t) = of_int64 (Int64.shift_right 1L 0)
    let (key_release : t) = of_int64 (Int64.shift_right 1L 1)
    let (button_press : t) = of_int64 (Int64.shift_right 1L 2)
    let (button_release : t) = of_int64 (Int64.shift_right 1L 3)
    let (enter_window : t) = of_int64 (Int64.shift_right 1L 4)
    let (leave_window : t) = of_int64 (Int64.shift_right 1L 5)
    let (pointer_motion : t) = of_int64 (Int64.shift_right 1L 6)
    let (pointer_motion_hint : t) = of_int64 (Int64.shift_right 1L 7)
    let (button1_motion : t) = of_int64 (Int64.shift_right 1L 8)
    let (button2_motion : t) = of_int64 (Int64.shift_right 1L 9)
    let (button3_motion : t) = of_int64 (Int64.shift_right 1L 10)
    let (button4_motion : t) = of_int64 (Int64.shift_right 1L 11)
    let (button5_motion : t) = of_int64 (Int64.shift_right 1L 12)
    let (button_motion : t) = of_int64 (Int64.shift_right 1L 13)
    let (keymap_state : t) = of_int64 (Int64.shift_right 1L 14)
    let (exposure : t) = of_int64 (Int64.shift_right 1L 15)
    let (visibility_change : t) = of_int64 (Int64.shift_right 1L 16)
    let (structure_notify : t) = of_int64 (Int64.shift_right 1L 17)
    let (resize_redirect : t) = of_int64 (Int64.shift_right 1L 18)
    let (substructure_notify : t) = of_int64 (Int64.shift_right 1L 19)
    let (substructure_redirect : t) = of_int64 (Int64.shift_right 1L 20)
    let (focus_change : t) = of_int64 (Int64.shift_right 1L 21)
    let (property_change : t) = of_int64 (Int64.shift_right 1L 22)
    let (color_map_change : t) = of_int64 (Int64.shift_right 1L 23)
    let (owner_grab_button : t) = of_int64 (Int64.shift_right 1L 24)
    let none : t = 0L
  end

  module Backing_store_enum = struct
    type t = [ `Not_useful | `When_mapped | `Always ] [@@deriving sexp]
  end

  type screen = {
    root : window;
    default_colormap : colormap;
    white_pixel : u32;
    black_pixel : u32;
    current_input_masks : Event_mask.t;
    width_in_pixels : u16;
    height_in_pixels : u16;
    width_in_millimeters : u16;
    height_in_millimeters : u16;
    min_installed_maps : u16;
    max_installed_maps : u16;
    root_visual : visualid;
    backing_stores : Backing_store_enum.t;
    save_unders : bool;
    root_depth : u8;
    allowed_depths : depth list;
  }
  [@@deriving sexp]

  type setup_request = {
    byte_order : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    authorization_protocol_name : string;
    authorization_protocol_data : string;
  }
  [@@deriving sexp]

  type setup_failed = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    reason : string;
  }
  [@@deriving sexp]

  type setup_authenticate = { status : u8; reason : string } [@@deriving sexp]

  module Image_order_enum = struct
    type t = [ `Lsb_first | `Msb_first ] [@@deriving sexp]
  end

  type setup = {
    status : u8;
    protocol_major_version : u16;
    protocol_minor_version : u16;
    length : u16;
    release_number : u32;
    resource_id_base : u32;
    resource_id_mask : u32;
    motion_buffer_size : u32;
    maximum_request_length : u16;
    image_byte_order : Image_order_enum.t;
    bitmap_format_bit_order : Image_order_enum.t;
    bitmap_format_scanline_unit : u8;
    bitmap_format_scanline_pad : u8;
    min_keycode : keycode;
    max_keycode : keycode;
    vendor : string;
    pixmap_formats : format list;
    roots : screen list;
  }
  [@@deriving sexp]

  module Mod_mask = struct
    include Mask

    let (shift : t) = of_int64 (Int64.shift_right 1L 0)
    let (lock : t) = of_int64 (Int64.shift_right 1L 1)
    let (control : t) = of_int64 (Int64.shift_right 1L 2)
    let (_1 : t) = of_int64 (Int64.shift_right 1L 3)
    let (_2 : t) = of_int64 (Int64.shift_right 1L 4)
    let (_3 : t) = of_int64 (Int64.shift_right 1L 5)
    let (_4 : t) = of_int64 (Int64.shift_right 1L 6)
    let (_5 : t) = of_int64 (Int64.shift_right 1L 7)
    let (any : t) = of_int64 (Int64.shift_right 1L 15)
  end

  module Key_but_mask = struct
    include Mask

    let (shift : t) = of_int64 (Int64.shift_right 1L 0)
    let (lock : t) = of_int64 (Int64.shift_right 1L 1)
    let (control : t) = of_int64 (Int64.shift_right 1L 2)
    let (mod1 : t) = of_int64 (Int64.shift_right 1L 3)
    let (mod2 : t) = of_int64 (Int64.shift_right 1L 4)
    let (mod3 : t) = of_int64 (Int64.shift_right 1L 5)
    let (mod4 : t) = of_int64 (Int64.shift_right 1L 6)
    let (mod5 : t) = of_int64 (Int64.shift_right 1L 7)
    let (button1 : t) = of_int64 (Int64.shift_right 1L 8)
    let (button2 : t) = of_int64 (Int64.shift_right 1L 9)
    let (button3 : t) = of_int64 (Int64.shift_right 1L 10)
    let (button4 : t) = of_int64 (Int64.shift_right 1L 11)
    let (button5 : t) = of_int64 (Int64.shift_right 1L 12)
  end

  module Window_enum = struct
    type t = [ `None ] [@@deriving sexp]
  end

  module Button_mask = struct
    include Mask

    let (_1 : t) = of_int64 (Int64.shift_right 1L 8)
    let (_2 : t) = of_int64 (Int64.shift_right 1L 9)
    let (_3 : t) = of_int64 (Int64.shift_right 1L 10)
    let (_4 : t) = of_int64 (Int64.shift_right 1L 11)
    let (_5 : t) = of_int64 (Int64.shift_right 1L 12)
    let (any : t) = of_int64 (Int64.shift_right 1L 15)
  end

  module Motion_enum = struct
    type t = [ `Normal | `Hint ] [@@deriving sexp]
  end

  module Notify_detail_enum = struct
    type t =
      [ `Ancestor
      | `Virtual_
      | `Inferior
      | `Nonlinear
      | `Nonlinear_virtual
      | `Pointer
      | `Pointer_root
      | `None ]
    [@@deriving sexp]
  end

  module Notify_mode_enum = struct
    type t = [ `Normal | `Grab | `Ungrab | `While_grabbed ] [@@deriving sexp]
  end

  module Visibility_enum = struct
    type t = [ `Unobscured | `Partially_obscured | `Fully_obscured ]
    [@@deriving sexp]
  end

  module Stack_mode_enum = struct
    type t = [ `Above | `Below | `Top_if | `Bottom_if | `Opposite ]
    [@@deriving sexp]
  end

  module Config_window_mask = struct
    include Mask

    let (x : t) = of_int64 (Int64.shift_right 1L 0)
    let (y : t) = of_int64 (Int64.shift_right 1L 1)
    let (width : t) = of_int64 (Int64.shift_right 1L 2)
    let (height : t) = of_int64 (Int64.shift_right 1L 3)
    let (border_width : t) = of_int64 (Int64.shift_right 1L 4)
    let (sibling : t) = of_int64 (Int64.shift_right 1L 5)
    let (stack_mode : t) = of_int64 (Int64.shift_right 1L 6)
  end

  module Place_enum = struct
    type t = [ `On_top | `On_bottom ] [@@deriving sexp]
  end

  module Property_enum = struct
    type t = [ `New_value | `Delete ] [@@deriving sexp]
  end

  module Time_enum = struct
    type t = [ `Current_time ] [@@deriving sexp]
  end

  module Atom_enum = struct
    type t =
      [ `None
      | `Any
      | `Primary
      | `Secondary
      | `Arc
      | `Atom
      | `Bitmap
      | `Cardinal
      | `Colormap
      | `Cursor
      | `Cut_buffer0
      | `Cut_buffer1
      | `Cut_buffer2
      | `Cut_buffer3
      | `Cut_buffer4
      | `Cut_buffer5
      | `Cut_buffer6
      | `Cut_buffer7
      | `Drawable
      | `Font
      | `Integer
      | `Pixmap
      | `Point
      | `Rectangle
      | `Resource_manager
      | `Rgb_color_map
      | `Rgb_best_map
      | `Rgb_blue_map
      | `Rgb_default_map
      | `Rgb_gray_map
      | `Rgb_green_map
      | `Rgb_red_map
      | `String
      | `Visualid
      | `Window
      | `Wm_command
      | `Wm_hints
      | `Wm_client_machine
      | `Wm_icon_name
      | `Wm_icon_size
      | `Wm_name
      | `Wm_normal_hints
      | `Wm_size_hints
      | `Wm_zoom_hints
      | `Min_space
      | `Norm_space
      | `Max_space
      | `End_space
      | `Superscript_x
      | `Superscript_y
      | `Subscript_x
      | `Subscript_y
      | `Underline_position
      | `Underline_thickness
      | `Strikeout_ascent
      | `Strikeout_descent
      | `Italic_angle
      | `X_height
      | `Quad_width
      | `Weight
      | `Point_size
      | `Resolution
      | `Copyright
      | `Notice
      | `Font_name
      | `Family_name
      | `Full_name
      | `Cap_height
      | `Wm_class
      | `Wm_transient_for ]
    [@@deriving sexp]
  end

  module Colormap_state_enum = struct
    type t = [ `Uninstalled | `Installed ] [@@deriving sexp]
  end

  module Colormap_enum = struct
    type t = [ `None ] [@@deriving sexp]
  end

  module Client_message_data_format_enum = struct
    type t = [ `Data8 | `Data16 | `Data32 ] [@@deriving sexp]
  end

  module Mapping_enum = struct
    type t = [ `Modifier | `Keyboard | `Pointer ] [@@deriving sexp]
  end

  module Window_class_enum = struct
    type t = [ `Copy_from_parent | `Input_output | `Input_only ]
    [@@deriving sexp]
  end

  module Cw_mask = struct
    include Mask

    let (back_pixmap : t) = of_int64 (Int64.shift_right 1L 0)
    let (back_pixel : t) = of_int64 (Int64.shift_right 1L 1)
    let (border_pixmap : t) = of_int64 (Int64.shift_right 1L 2)
    let (border_pixel : t) = of_int64 (Int64.shift_right 1L 3)
    let (bit_gravity : t) = of_int64 (Int64.shift_right 1L 4)
    let (win_gravity : t) = of_int64 (Int64.shift_right 1L 5)
    let (backing_store : t) = of_int64 (Int64.shift_right 1L 6)
    let (backing_planes : t) = of_int64 (Int64.shift_right 1L 7)
    let (backing_pixel : t) = of_int64 (Int64.shift_right 1L 8)
    let (override_redirect : t) = of_int64 (Int64.shift_right 1L 9)
    let (save_under : t) = of_int64 (Int64.shift_right 1L 10)
    let (event_mask : t) = of_int64 (Int64.shift_right 1L 11)
    let (dont_propagate : t) = of_int64 (Int64.shift_right 1L 12)
    let (colormap : t) = of_int64 (Int64.shift_right 1L 13)
    let (cursor : t) = of_int64 (Int64.shift_right 1L 14)
  end

  module Back_pixmap_enum = struct
    type t = [ `None | `Parent_relative ] [@@deriving sexp]
  end

  module Gravity_enum = struct
    type t =
      [ `Bit_forget
      | `Win_unmap
      | `North_west
      | `North
      | `North_east
      | `West
      | `Center
      | `East
      | `South_west
      | `South
      | `South_east
      | `Static ]
    [@@deriving sexp]
  end

  module Pixmap_enum = struct
    type t = [ `None ] [@@deriving sexp]
  end

  module Cursor_enum = struct
    type t = [ `None ] [@@deriving sexp]
  end

  module Map_state_enum = struct
    type t = [ `Unmapped | `Unviewable | `Viewable ] [@@deriving sexp]
  end

  type get_window_attributes_reply = {
    backing_store : Backing_store_enum.t;
    visual : visualid;
    class_ : Window_class_enum.t;
    bit_gravity : Gravity_enum.t;
    win_gravity : Gravity_enum.t;
    backing_planes : u32;
    backing_pixel : u32;
    save_under : bool;
    map_is_installed : bool;
    map_state : Map_state_enum.t;
    override_redirect : bool;
    colormap : [ Colormap_enum.t | colormap alt ];
    all_event_masks : Event_mask.t;
    your_event_mask : Event_mask.t;
    do_not_propagate_mask : Event_mask.t;
  }
  [@@deriving sexp]

  module Set_mode_enum = struct
    type t = [ `Insert | `Delete ] [@@deriving sexp]
  end

  module Circulate_enum = struct
    type t = [ `Raise_lowest | `Lower_highest ] [@@deriving sexp]
  end

  type get_geometry_reply = {
    depth : u8;
    root : window;
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    border_width : u16;
  }
  [@@deriving sexp]

  type query_tree_reply = {
    root : window;
    parent : [ Window_enum.t | window alt ];
    children : window list;
  }
  [@@deriving sexp]

  type intern_atom_reply = [ Atom_enum.t | atom alt ] [@@deriving sexp]
  type get_atom_name_reply = string [@@deriving sexp]

  module Prop_mode_enum = struct
    type t = [ `Replace | `Prepend | `Append ] [@@deriving sexp]
  end

  module Get_property_type_enum = struct
    type t = [ `Any ] [@@deriving sexp]
  end

  type get_property_reply = {
    format : u8;
    type_ : atom;
    bytes_after : u32;
    value_len : u32;
    value : string;
  }
  [@@deriving sexp]

  type list_properties_reply = atom list [@@deriving sexp]

  type get_selection_owner_reply = [ Window_enum.t | window alt ]
  [@@deriving sexp]

  module Send_event_dest_enum = struct
    type t = [ `Pointer_window | `Item_focus ] [@@deriving sexp]
  end

  module Grab_mode_enum = struct
    type t = [ `Sync | `Async ] [@@deriving sexp]
  end

  module Grab_status_enum = struct
    type t =
      [ `Success | `Already_grabbed | `Invalid_time | `Not_viewable | `Frozen ]
    [@@deriving sexp]
  end

  type grab_pointer_reply = Grab_status_enum.t [@@deriving sexp]

  module Button_index_enum = struct
    type t = [ `Any | `D1 | `D2 | `D3 | `D4 | `D5 ] [@@deriving sexp]
  end

  type grab_keyboard_reply = Grab_status_enum.t [@@deriving sexp]

  module Grab_enum = struct
    type t = [ `Any ] [@@deriving sexp]
  end

  module Allow_enum = struct
    type t =
      [ `Async_pointer
      | `Sync_pointer
      | `Replay_pointer
      | `Async_keyboard
      | `Sync_keyboard
      | `Replay_keyboard
      | `Async_both
      | `Sync_both ]
    [@@deriving sexp]
  end

  type query_pointer_reply = {
    same_screen : bool;
    root : window;
    child : [ Window_enum.t | window alt ];
    root_x : i16;
    root_y : i16;
    win_x : i16;
    win_y : i16;
    mask : Key_but_mask.t;
  }
  [@@deriving sexp]

  type timecoord = { time : timestamp; x : i16; y : i16 } [@@deriving sexp]
  type get_motion_events_reply = timecoord list [@@deriving sexp]

  type translate_coordinates_reply = {
    same_screen : bool;
    child : [ Window_enum.t | window alt ];
    dst_x : i16;
    dst_y : i16;
  }
  [@@deriving sexp]

  module Input_focus_enum = struct
    type t = [ `None | `Pointer_root | `Parent | `Follow_keyboard ]
    [@@deriving sexp]
  end

  type get_input_focus_reply = {
    revert_to : Input_focus_enum.t;
    focus : [ Input_focus_enum.t | window alt ];
  }
  [@@deriving sexp]

  type query_keymap_reply = u8 list [@@deriving sexp]

  module Font_draw_enum = struct
    type t = [ `Left_to_right | `Right_to_left ] [@@deriving sexp]
  end

  type fontprop = { name : atom; value : u32 } [@@deriving sexp]

  type charinfo = {
    left_side_bearing : i16;
