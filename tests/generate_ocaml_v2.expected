    end

    type t =
      [ `Pict_format of Pict_format.t
      | `Picture of Picture.t
      | `Pict_op of Pict_op.t
      | `Glyph_set of Glyph_set.t
      | `Glyph of Glyph.t ]
    [@@deriving sexp]
  end

