module Bigreq = struct
  module Meta = struct
    type t = [ `BigRequests ]

    let version = (0, 0)
    let query_name = "BIG-REQUESTS"
  end

  [@@@ocaml.warning "-12"]

  open Types [@@ocaml.warning "-33"]
  open Sexplib.Conv [@@ocaml.warning "-33"]

  module Event = struct
    type t = [] [@@deriving sexp]
  end

  module Error = struct
    type t = [] [@@deriving sexp]
  end

  module Enable = struct
    let name = "Enable"
    let opcode = 0

    type request = unit [@@deriving sexp]

    let make () : request = ()

    type reply = u32 [@@deriving sexp]
  end
end

module Xproto = struct
  [@@@ocaml.warning "-12"]

  open Types [@@ocaml.warning "-33"]
  open Sexplib.Conv [@@ocaml.warning "-33"]

  type char2b = { byte1 : u8; byte2 : u8 } [@@deriving sexp]
  type window = xid [@@deriving sexp]
  type pixmap = xid [@@deriving sexp]
  type cursor = xid [@@deriving sexp]
  type font = xid [@@deriving sexp]
  type gcontext = xid [@@deriving sexp]
  type colormap = xid [@@deriving sexp]
  type atom = xid [@@deriving sexp]
  type drawable = xid [@@deriving sexp]
  type fontable = xid [@@deriving sexp]
  type bool32 = u32 [@@deriving sexp]
  type visualid = u32 [@@deriving sexp]
  type timestamp = u32 [@@deriving sexp]
  type keysym = u32 [@@deriving sexp]
  type keycode = u8 [@@deriving sexp]
  type keycode32 = u32 [@@deriving sexp]
  type button = u8 [@@deriving sexp]
  type point = { x : i16; y : i16 } [@@deriving sexp]

  type rectangle = { x : i16; y : i16; width : u16; height : u16 }
  [@@deriving sexp]

  type arc = {
    x : i16;
    y : i16;
    width : u16;
    height : u16;
    angle1 : i16;
    angle2 : i16;
  }
  [@@deriving sexp]

  type format = { depth : u8; bits_per_pixel : u8; scanline_pad : u8 }
  [@@deriving sexp]

  module Visual_class_enum = struct
    type t =
      [ `Static_gray
      | `Gray_scale
      | `Static_color
      | `Pseudo_color
      | `True_color
      | `Direct_color ]
    [@@deriving sexp]
  end

  type visualtype = {
    visual_id : visualid;
    class_ : Visual_class_enum.t;
    bits_per_rgb_value : u8;
    colormap_entries : u16;
    red_mask : u32;
    green_mask : u32;
    blue_mask : u32;
  }
  [@@deriving sexp]

  type depth = { depth : u8; visuals : visualtype list } [@@deriving sexp]

  module Event_mask = struct
    include Mask

    let (key_press : t) = of_int64 (Int64.shift_right 1L 0)
    let (key_release : t) = of_int64 (Int64.shift_right 1L 1)
    let (button_press : t) = of_int64 (Int64.shift_right 1L 2)
    let (button_release : t) = of_int64 (Int64.shift_right 1L 3)
    let (enter_window : t) = of_int64 (Int64.shift_right 1L 4)
    let (leave_window : t) = of_int64 (Int64.shift_right 1L 5)
    let (pointer_motion : t) = of_int64 (Int64.shift_right 1L 6)
    let (pointer_motion_hint : t) = of_int64 (Int64.shift_right 1L 7)
    let (button1_motion : t) = of_int64 (Int64.shift_right 1L 8)
    let (button2_motion : t) = of_int64 (Int64.shift_right 1L 9)
    let (button3_motion : t) = of_int64 (Int64.shift_right 1L 10)
    let (button4_motion : t) = of_int64 (Int64.shift_right 1L 11)
    let (button5_motion : t) = of_int64 (Int64.shift_right 1L 12)
    let (button_motion : t) = of_int64 (Int64.shift_right 1L 13)
    let (keymap_state : t) = of_int64 (Int64.shift_right 1L 14)
    let (exposure : t) = of_int64 (Int64.shift_right 1L 15)
    let (visibility_change : t) = of_int64 (Int64.shift_right 1L 16)
    let (structure_notify : t) = of_int64 (Int64.shift_right 1L 17)
    let (resize_redirect : t) = of_int64 (Int64.shift_right 1L 18)
    let (substructure_notify : t) = of_int64 (Int64.shift_right 1L 19)
    let (substructure_redirect : t) = of_int64 (Int64.shift_right 1L 20)
    let (focus_change : t) = of_int64 (Int64.shift_right 1L 21)
    let (property_change : t) = of_int64 (Int64.shift_right 1L 22)
    let (color_map_change : t) = of_int64 (Int64.shift_right 1L 23)
    let (owner_grab_button : t) = of_int64 (Int64.shift_right 1L 24)
    let none : t = of_int64 0L
  end

  module Backing_store_enum = struct
    type t = [ `Not_useful | `When_mapped | `Always ] [@@deriving sexp]
  end

  type screen = {
    root : window;
    default_colormap : colormap;
    white_pixel : u32;
    black_pixel : u32;
    current_input_masks : Event_mask.t;
    width_in_pixels : u16;
