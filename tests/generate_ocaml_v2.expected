        id;
        src_x;
        src_y;
        src_w;
        src_h;
        drw_x;
        drw_y;
        drw_w;
        drw_h;
        width;
        height;
        data;
      }
  end

  module Shm_put_image = struct
    let name = "ShmPutImage"
    let opcode = 19

    type request = {
      port : port;
      drawable : Xproto.drawable;
      gc : Xproto.gcontext;
      shmseg : Shm.seg;
      id : u32;
      offset : u32;
      src_x : i16;
      src_y : i16;
      src_w : u16;
      src_h : u16;
      drw_x : i16;
      drw_y : i16;
      drw_w : u16;
      drw_h : u16;
      width : u16;
      height : u16;
      send_event : u8;
    }
    [@@deriving sexp]

    let make ~port ~drawable ~gc ~shmseg ~id ~offset ~src_x ~src_y ~src_w ~src_h
        ~drw_x ~drw_y ~drw_w ~drw_h ~width ~height ~send_event : request =
      {
        port;
        drawable;
        gc;
        shmseg;
        id;
        offset;
        src_x;
        src_y;
        src_w;
        src_h;
        drw_x;
        drw_y;
        drw_w;
        drw_h;
        width;
        height;
        send_event;
      }
  end
end

module Xvmc = struct
  module Meta = struct
    type t = [ `XvMC ]

    let version = (1, 1)
    let query_name = "XVideo-MotionCompensation"
  end

  [@@@ocaml.warning "-12"]

  open Types [@@ocaml.warning "-33"]
  open Sexplib.Conv [@@ocaml.warning "-33"]

  type context = xid [@@deriving sexp]
  type surface = xid [@@deriving sexp]
  type subpicture = xid [@@deriving sexp]

  type surface_info = {
    id : surface;
    chroma_format : u16;
    pad0 : u16;
    max_width : u16;
    max_height : u16;
    subpicture_max_width : u16;
    subpicture_max_height : u16;
    mc_type : u32;
    flags : u32;
  }
  [@@deriving sexp]

  module Event = struct
    type t = [] [@@deriving sexp]
  end

  module Error = struct
    type t = [] [@@deriving sexp]
  end

  module Query_version = struct
    let name = "QueryVersion"
    let opcode = 0

    type request = unit [@@deriving sexp]

    let make () : request = ()

    type reply = { major : u32; minor : u32 } [@@deriving sexp]
  end

  module List_surface_types = struct
    let name = "ListSurfaceTypes"
    let opcode = 1

    type request = Xv.port [@@deriving sexp]

    let make port_id : request = port_id

    type reply = surface_info list [@@deriving sexp]
  end

  module Create_context = struct
    let name = "CreateContext"
    let opcode = 2

    type request = {
      context_id : context;
      port_id : Xv.port;
      surface_id : surface;
      width : u16;
      height : u16;
      flags : u32;
    }
    [@@deriving sexp]

    let make ~context_id ~port_id ~surface_id ~width ~height ~flags : request =
      { context_id; port_id; surface_id; width; height; flags }

    type reply = {
      width_actual : u16;
      height_actual : u16;
      flags_return : u32;
      priv_data : u32 list;
    }
    [@@deriving sexp]
  end

  module Destroy_context = struct
    let name = "DestroyContext"
    let opcode = 3

    type request = context [@@deriving sexp]

    let make context_id : request = context_id
  end

  module Create_surface = struct
    let name = "CreateSurface"
    let opcode = 4

    type request = { surface_id : surface; context_id : context }
    [@@deriving sexp]

    let make ~surface_id ~context_id : request = { surface_id; context_id }

    type reply = u32 list [@@deriving sexp]
  end

  module Destroy_surface = struct
    let name = "DestroySurface"
    let opcode = 5

    type request = surface [@@deriving sexp]

    let make surface_id : request = surface_id
  end

  module Create_subpicture = struct
    let name = "CreateSubpicture"
    let opcode = 6

    type request = {
      subpicture_id : subpicture;
      context : context;
      xvimage_id : u32;
      width : u16;
      height : u16;
    }
    [@@deriving sexp]

    let make ~subpicture_id ~context ~xvimage_id ~width ~height : request =
      { subpicture_id; context; xvimage_id; width; height }

    type reply = {
      width_actual : u16;
      height_actual : u16;
      num_palette_entries : u16;
      entry_bytes : u16;
      component_order : u8 list;
      priv_data : u32 list;
    }
    [@@deriving sexp]
  end

  module Destroy_subpicture = struct
    let name = "DestroySubpicture"
    let opcode = 7

    type request = subpicture [@@deriving sexp]

    let make subpicture_id : request = subpicture_id
  end

  module List_subpicture_types = struct
    let name = "ListSubpictureTypes"
    let opcode = 8

    type request = { port_id : Xv.port; surface_id : surface } [@@deriving sexp]

    let make ~port_id ~surface_id : request = { port_id; surface_id }

    type reply = Xv.image_format_info list [@@deriving sexp]
  end
end
