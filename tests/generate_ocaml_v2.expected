    let (master_removed : t) = of_int64 (Int64.shift_right 1L 1)
    let (slave_added : t) = of_int64 (Int64.shift_right 1L 2)
    let (slave_removed : t) = of_int64 (Int64.shift_right 1L 3)
    let (slave_attached : t) = of_int64 (Int64.shift_right 1L 4)
    let (slave_detached : t) = of_int64 (Int64.shift_right 1L 5)
    let (device_enabled : t) = of_int64 (Int64.shift_right 1L 6)
    let (device_disabled : t) = of_int64 (Int64.shift_right 1L 7)
  end

  type hierarchy_info = {
    deviceid : [ Device_enum.t | device_id alt ];
    attachment : [ Device_enum.t | device_id alt ];
    type_ : Device_type_enum.t;
    enabled : bool;
    flags : Hierarchy_mask.t;
  }
  [@@deriving sexp]

  module Property_flag_enum = struct
    type t = [ `Deleted | `Created | `Modified ] [@@deriving sexp]
  end

  module Touch_event_flags_mask = struct
    include Mask

    let (touch_pending_end : t) = of_int64 (Int64.shift_right 1L 16)
    let (touch_emulating_pointer : t) = of_int64 (Int64.shift_right 1L 17)
  end

  module Touch_ownership_flags_enum = struct
    type t = [ `None ] [@@deriving sexp]
  end

  module Barrier_flags_mask = struct
    include Mask

    let (pointer_released : t) = of_int64 (Int64.shift_right 1L 0)
    let (device_is_grabbed : t) = of_int64 (Int64.shift_right 1L 1)
  end
end

