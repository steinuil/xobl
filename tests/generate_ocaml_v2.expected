module Xprint = struct
  module Meta = struct
    type t = [ `XPrint ]

    let version = (1, 0)
    let query_name = "XpExtension"
  end

  type string8 = char [@@deriving sexp]
  type printer = { name : string; description : string } [@@deriving sexp]
  type pcontext = xid [@@deriving sexp]

  module Get_doc_enum = struct
    type t = [ `Finished | `Second_consumer ] [@@deriving sexp]
  end

  module Ev_mask = struct
    include Mask

    let (print_mask : t) = of_int64 (Int64.shift_right 1L 0)
    let (attribute_mask : t) = of_int64 (Int64.shift_right 1L 1)
    let none : t = 0L
  end

  module Detail_enum = struct
    type t =
      [ `Start_job_notify
      | `End_job_notify
      | `Start_doc_notify
      | `End_doc_notify
      | `Start_page_notify
      | `End_page_notify ]
    [@@deriving sexp]
  end

  module Attr_enum = struct
    type t =
      [ `Job_attr
      | `Doc_attr
      | `Page_attr
      | `Printer_attr
      | `Server_attr
      | `Medium_attr
      | `Spooler_attr ]
    [@@deriving sexp]
  end

  type print_query_version_reply = { major_version : u16; minor_version : u16 }
  [@@deriving sexp]

